# The V3 LIVE image of the API (job L). Multi-stage: dependencies, build (prisma generate, nest build, renderer), production-only dependencies, then a small runtime that runs as a non-root user.
# No secret and no real value is built in: everything comes from the environment at run time (docker-compose.v3live.yml, env_file .env.live, which is never committed).
#   docker build -f Dockerfile.v3live -t get4domain-api:v3live .
# Needs BuildKit (the default) so Dockerfile.v3live.dockerignore is used.

FROM node:20-alpine AS deps
WORKDIR /app
RUN apk add --no-cache openssl
COPY package.json package-lock.json ./
RUN npm ci

FROM node:20-alpine AS builder
WORKDIR /app
RUN apk add --no-cache openssl
COPY --from=deps /app/node_modules ./node_modules
COPY . .
# prisma generate + nest build + the theme renderer (see package.json "build")
RUN npm run build

FROM node:20-alpine AS prod-deps
WORKDIR /app
RUN apk add --no-cache openssl
COPY package.json package-lock.json ./
COPY prisma ./prisma
# production dependencies only; the generated client is copied from the builder afterwards (the postinstall of a production install must not need the dev tools)
RUN npm ci --omit=dev --ignore-scripts
COPY --from=builder /app/node_modules/.prisma ./node_modules/.prisma

FROM node:20-alpine AS runner
WORKDIR /app
RUN apk add --no-cache openssl tini
ENV NODE_ENV=production
# The live process: main.ts refuses to boot unless the environment is complete, not a placeholder, and not a staging or test database (src/common/startup-check.ts).
ENV V3_LIVE=true
ENV PORT=3008
RUN addgroup --system --gid 1001 nodejs && adduser --system --uid 1001 --ingroup nodejs nestjs
COPY --from=prod-deps --chown=nestjs:nodejs /app/node_modules ./node_modules
COPY --from=builder --chown=nestjs:nodejs /app/dist ./dist
COPY --from=builder --chown=nestjs:nodejs /app/package.json ./package.json
COPY --from=builder --chown=nestjs:nodejs /app/prisma ./prisma
# the one-time and operator scripts (bootstrap of the first SUPER_ADMIN, the seed runner); they read the same environment
COPY --from=builder --chown=nestjs:nodejs /app/scripts ./scripts
# Persistent upload directories (named volumes are mounted on both in docker-compose.v3live.yml); created and owned first so a NEW volume inherits the non-root owner.
RUN mkdir -p /app/uploads /app/private-uploads && chown -R nestjs:nodejs /app/uploads /app/private-uploads
USER nestjs
EXPOSE 3008
# Liveness only (no database call), so a short database blip does not mark the container unhealthy. Node's built-in fetch: no curl or wget in the image.
HEALTHCHECK --interval=30s --timeout=5s --start-period=60s --retries=3 \
  CMD ["node", "-e", "fetch('http://127.0.0.1:'+(process.env.PORT||3008)+'/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"]
# tini forwards the stop signal so the API shuts down cleanly
ENTRYPOINT ["/sbin/tini", "--"]
CMD ["node", "dist/src/main"]
