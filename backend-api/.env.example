# ============================================================
# GET4DOMAIN BACKEND — Environment Variables
# Copy this file to .env.local and fill in your values
# NEVER commit .env.local to GitHub
# ============================================================

# ── Server ──
PORT=3008
FRONTEND_URL=https://get4domain.com

# ── Database (Supabase — use the POOLER connection, not direct) ──
DATABASE_URL=
DIRECT_URL=

# ── Auth ──
JWT_SECRET=

# ── Platform Settings encryption (AES-256-GCM master key) ──
# Used to encrypt integration API keys stored in the g4d_platform_settings table.
# Provide a 64-char hex string (32 bytes) — generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Any other string is accepted and hashed to 32 bytes, but hex is preferred.
PLATFORM_SETTINGS_KEY=

# ── Email (Resend) ──
RESEND_API_KEY=

# ── Payments (Razorpay) ──
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Separate secret configured in the Razorpay dashboard webhook settings
RAZORPAY_WEBHOOK_SECRET=

# ── Claude API (for AI content/page generation) ──
CLAUDE_API_KEY=

# ── OpenAI (DALL-E image generation for AI content, optional) ──
OPENAI_API_KEY=

# ── Push Notifications (Web Push / VAPID — generate with `npx web-push generate-vapid-keys`) ──
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@get4domain.com

# ── SMS + WhatsApp (MSG91, DLT compliant) ──
MSG91_AUTH_KEY=
MSG91_SENDER_ID=G4DOMN
MSG91_WHATSAPP_NUMBER=
ADMIN_WHATSAPP_NUMBER=+917550047567

# ── Company Details (used on invoices) ──
COMPANY_NAME=KSM Quantum Technologies
COMPANY_GST=
COMPANY_PAN=
COMPANY_ADDRESS=
COMPANY_PHONE=+917550047567
COMPANY_EMAIL=admin@get4domain.com

# ── Admin ──
ADMIN_EMAIL=admin@get4domain.com
# Only used once by `npm run prisma:seed` to bootstrap the first SUPER_ADMIN account — not read at runtime
ADMIN_PASSWORD=

# ── Security (patch 2026-10-02) ──
# Shared secret Fast2SMS must send in the `webhook_secret_key` header of every inbound WhatsApp webhook.
# The inbound webhook is DISABLED (rejects everything) until this — or Admin → Integrations → Fast2SMS →
# "WhatsApp inbound webhook secret" — is set. Use a long random value; configure the same value in Fast2SMS.
FAST2SMS_WEBHOOK_SECRET=
# Number of reverse proxies in front of the API (nginx = 1). Makes req.ip — the rate-limit key — the real
# client address instead of the proxy's. Set to 2 if Cloudflare also forwards to nginx and nginx trusts it.
TRUST_PROXY_HOPS=1
# Rate limiting (per client IP, per route). Optional tuning — defaults: 300 writes/min, 1500 reads/min.
THROTTLE_GLOBAL_LIMIT=300
THROTTLE_READ_LIMIT=1500
# Comma-separated IPs never rate limited (e.g. the web server that renders pages by calling this API).
THROTTLE_TRUSTED_IPS=
# Emergency switch: set to true to disable rate limiting without a code change. Leave unset normally.
# THROTTLE_DISABLED=true
