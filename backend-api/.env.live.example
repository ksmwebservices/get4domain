# The V3 LIVE environment of the API (job L). NAMES ONLY: copy this file to .env.live ON THE SERVER, fill every value there, and never commit it (.env.live is in .gitignore).
# Start with:  docker compose -f docker-compose.v3live.yml --env-file .env.live up -d
# The live API refuses to start (src/common/startup-check.ts) when a REQUIRED name is empty, is still a placeholder (CHANGE_ME, your-..., <...>), a secret is under 32 characters, or a database is a staging or test one.
# A line that starts with "# NAME=" is optional: remove the "# " only when you need it. Money switches and sending switches are OFF unless you turn them on (docs/v3/V3_LIVE_ENVIRONMENT.md lists them all).

# ── the live domain (REQUIRED): the one variable that says where everything lives
# the live domain only, no scheme and no path; every public address below must be on it
V3_DOMAIN=
# set by the image and the compose file; do not change
NODE_ENV=production
V3_LIVE=true
# the port inside the container (the compose file publishes it on the loopback address only)
PORT=3008
# the version shown by GET /health/ready (set by your deploy step)
# APP_VERSION=
# the commit shown by GET /health/ready (set by your deploy step)
# GIT_COMMIT=

# ── database (REQUIRED)
# the pooled connection string of the LIVE database (never a staging or test one: the API refuses those)
DATABASE_URL=
# the direct connection string of the same live database (used by migrations and backups)
DIRECT_URL=

# ── sign-in and secrets (REQUIRED: each at least 32 random characters, all different)
# signs access tokens
JWT_SECRET=
# seals provider keys kept in the admin settings
PLATFORM_SETTINGS_KEY=
# the shared secret that lets the API ask the public site to refresh a page (the same value is set on the public site)
REVALIDATE_SECRET=
# how long an access token lives (minutes, optional)
# ACCESS_TOKEN_TTL=
# how long a password reset link lives, in minutes (optional)
# PASSWORD_RESET_TTL_MINUTES=
# resets one address may ask for in an hour (optional)
# PASSWORD_RESET_MAX_PER_HOUR=
# seconds a login handoff code lives, 15 to 300 (optional)
# LOGIN_HANDOFF_TTL_SECONDS=
# days a refresh token lives (optional)
# REFRESH_TOKEN_TTL_DAYS=
# wrong passwords allowed before a sign-in is held (optional)
# LOGIN_MAX_FAILURES=
# the window, in minutes, in which wrong passwords are counted (optional)
# LOGIN_FAILURE_WINDOW_MINUTES=
# the least time a failed sign-in takes, in milliseconds, so a wrong address and a wrong password look alike (optional)
# AUTH_MIN_FAILURE_MS=
# the key for the one-time code, phone and address hashes (optional; JWT_SECRET is used when it is empty)
# OTP_HASH_PEPPER=
# salt for the campaign page visitor hashes (optional)
# LEADSPACE_HASH_SALT=

# ── where the sites and pages live (REQUIRED)
# the base domain of the vendors' subdomain sites: V3_DOMAIN or a subdomain of it, as a bare host name
SITE_BASE_DOMAIN=
# the public site's address, used in redirects and e-mail links (https, on V3_DOMAIN)
FRONTEND_URL=
# the vendor app's address, used in redirects and links (https, on V3_DOMAIN)
PUBLIC_APP_URL=
# this API's own public address, used in links it hands out (https, on V3_DOMAIN)
PUBLIC_API_URL=
# the address the public site is reached on from inside the server, for page refreshes (optional)
# FRONTEND_INTERNAL_URL=
# the address of this server that custom domains must point to (the IPv4 address)
SERVER_IP=
# the public address the campaign pages use (optional)
# NEXT_PUBLIC_API_URL=
# the base domain of the campaign pages (optional)
# LEADSPACE_BASE_DOMAIN=
# the folder of the built theme renderer (optional; the image has it in the right place)
# RENDERER_DIR=

# ── behind nginx (REQUIRED)
# the addresses of the proxies that may say who the visitor is: the public site's server and nginx (addresses, subnets, loopback)
TRUSTED_PROXIES=
# the older hop count, used only when TRUSTED_PROXIES is not set (optional)
# TRUST_PROXY_HOPS=
# addresses that are never rate limited (optional)
# THROTTLE_TRUSTED_IPS=
# rate limit per minute for every route (optional)
# THROTTLE_GLOBAL_LIMIT=
# rate limit per minute for reads (optional)
# THROTTLE_READ_LIMIT=
# never set in live: switches the rate limits off (the API refuses to start with it on)
# THROTTLE_DISABLED=
# never set in live: echoes one-time codes in the answer (the API refuses to start with it on)
# OTP_DEV_ECHO=
# "strict" lets only the platform and the listed origins call the API from a browser; the default reflects any origin
# CORS_MODE=
# the extra origins allowed when CORS_MODE is strict, comma separated
# CORS_EXTRA_ORIGINS=

# ── storage: Cloudflare R2 (the bucket names, endpoints and public address are admin settings; only the keys are here)
# the access key id of the PUBLIC bucket
# STORAGE_PUBLIC_ACCESS_KEY_ID=
# the secret of the PUBLIC bucket
# STORAGE_PUBLIC_SECRET_ACCESS_KEY=
# the access key id of the PRIVATE bucket
# STORAGE_PRIVATE_ACCESS_KEY_ID=
# the secret of the PRIVATE bucket
# STORAGE_PRIVATE_SECRET_ACCESS_KEY=
# where media is kept: leave empty for the default
# MEDIA_STORAGE_MODE=
# the folder for local uploads in the container (optional; the compose file mounts a volume at the default)
# UPLOADS_DIR=
# the older storage of generated pictures (optional)
# SUPABASE_URL=
# the older storage key (optional)
# SUPABASE_SERVICE_ROLE_KEY=
# the older storage bucket (optional)
# SUPABASE_STORAGE_BUCKET=

# ── mail: ALL OFF until the owner enables them
# the key of the mail provider
# RESEND_API_KEY=
# the sender address of platform mail
# RESEND_FROM_EMAIL=
# sends system and vendor mail for real only when this is exactly true; leave unset to keep every message held
# EMAIL_LIVE_SEND=
# forwards enquiries to the vendor's own mailbox for real only when exactly true
# EMAIL_FORWARD_LIVE=
# never set in live: captures mail instead of sending (the API refuses to start with it on)
# EMAIL_MODE=
# the staff address that receives platform notices
# ADMIN_EMAIL=

# ── SMS and messages: ALL OFF until the owner enables them
# sends SMS for real only when exactly true (the SMS setting must be live as well)
# SMS_LIVE_ENABLED=
# sends the SMS lane for real only when exactly true
# SMS_LIVE_SEND=
# the SMS and WhatsApp reseller key
# FAST2SMS_API_KEY=
# the registered DLT entity id
# FAST2SMS_ENTITY_ID=
# the registered DLT sender id
# FAST2SMS_SENDER_ID=
# the approved DLT template id for SMS
# FAST2SMS_SMS_MESSAGE_ID=
# the approved template id for WhatsApp
# FAST2SMS_WA_MESSAGE_ID=
# the secret that proves an inbound SMS webhook is from the reseller
# FAST2SMS_WEBHOOK_SECRET=
# the older SMS key
# MSG91_AUTH_KEY=
# the older SMS sender
# MSG91_SENDER_ID=
# the older WhatsApp number
# MSG91_WHATSAPP_NUMBER=
# the staff WhatsApp number for support alerts
# ADMIN_WHATSAPP_NUMBER=
# order messages go out for real only when exactly true (no live adapter exists in this build, so true makes them fail)
# MESSAGING_LIVE_ENABLED=
# "cloud" uses the WhatsApp Cloud API; anything else is the sandbox that sends nothing
# WHATSAPP_PROVIDER=
# the WhatsApp provider settings (only with WHATSAPP_PROVIDER=cloud)
# WHATSAPP_BSP_PROVIDER=
# the WhatsApp business account id
# WHATSAPP_BSP_ACCOUNT_ID=
# the WhatsApp provider key
# WHATSAPP_BSP_API_KEY=
# the WhatsApp Cloud API token
# WHATSAPP_CLOUD_TOKEN=
# the WhatsApp phone number id
# WHATSAPP_PHONE_NUMBER_ID=
# the WhatsApp app secret that signs inbound webhooks
# WHATSAPP_APP_SECRET=
# the token WhatsApp checks when it verifies the webhook
# WHATSAPP_VERIFY_TOKEN=

# ── payments: the live keys; the switches stay OFF until the owner enables them
# the Razorpay LIVE key id for plan payments and wallet top-ups
# RAZORPAY_KEY_ID=
# the Razorpay LIVE key secret
# RAZORPAY_KEY_SECRET=
# the secret that signs Razorpay webhooks
# RAZORPAY_WEBHOOK_SECRET=
# test-mode Razorpay keys: never in live
# RAZORPAY_TEST_KEY_ID=
# test-mode secret: never in live
# RAZORPAY_TEST_KEY_SECRET=
# test-mode webhook secret: never in live
# RAZORPAY_TEST_WEBHOOK_SECRET=
# lets vendors take payments through their own gateway account for real only when exactly true
# VENDOR_GATEWAY_LIVE_ENABLED=
# accepts the vendors' gateway webhooks only when exactly true
# VENDOR_GATEWAY_WEBHOOK_ENABLED=

# ── domains: registrar searches and purchases stay OFF until the owner enables them
# the registrar's API address (optional)
# RESELLERCLUB_API_BASE=
# the registrar API key
# RESELLERCLUB_API_KEY=
# the registrar login id
# RESELLERCLUB_AUTH_USERID=
# the registrar customer id
# RESELLERCLUB_CUSTOMER_ID=
# the registrar contact id
# RESELLERCLUB_CONTACT_ID=
# the registrar reseller id
# RESELLERCLUB_RESELLER_ID=
# the first name server given to a new domain
# RESELLERCLUB_NS1=
# the second name server given to a new domain
# RESELLERCLUB_NS2=
# the registrant city
# RESELLERCLUB_REG_CITY=
# the registrant state
# RESELLERCLUB_REG_STATE=
# the registrant country code
# RESELLERCLUB_REG_COUNTRY=
# the registrant postal code
# RESELLERCLUB_REG_ZIPCODE=
# real availability searches at the registrar only when exactly true
# REGISTRAR_LIVE_SEARCH=
# real purchases at the registrar (this spends money) only when exactly true
# REGISTRAR_LIVE_PURCHASE=

# ── AI, push and the company details on documents (all optional)
# the OpenAI key
# OPENAI_API_KEY=
# the Anthropic key
# ANTHROPIC_API_KEY=
# the older name of the Anthropic key
# CLAUDE_API_KEY=
# picture and video provider keys, kept off until used
# STABILITY_API_KEY=
# the video provider key
# RUNWAY_API_KEY=
# the video provider key
# HEYGEN_API_KEY=
# the video provider key
# KLING_API_KEY=
# web push public key
# VAPID_PUBLIC_KEY=
# web push private key
# VAPID_PRIVATE_KEY=
# web push contact (a mailto: or https address)
# VAPID_SUBJECT=
# the Meta publishing app id
# META_APP_ID=
# the Meta publishing app secret
# META_APP_SECRET=
# the Meta publishing token
# META_ACCESS_TOKEN=
# the Google Ads developer token
# GOOGLE_ADS_DEVELOPER_TOKEN=
# the Google Ads client id
# GOOGLE_ADS_CLIENT_ID=
# the Google Ads client secret
# GOOGLE_ADS_CLIENT_SECRET=
# switches the campaign scheduler on or off
# LEADSPACE_SCHEDULER=
# the company name printed on documents (the firm profile in the admin is the source for new documents)
# COMPANY_NAME=
# the company GST number
# COMPANY_GST=
# the company PAN
# COMPANY_PAN=
# the company address
# COMPANY_ADDRESS=
# the company phone
# COMPANY_PHONE=
# the company e-mail
# COMPANY_EMAIL=
# the company logo address
# COMPANY_LOGO_URL=
# PRICE_* names (price fallbacks for the admin settings) are NOT set here: prices are set in the admin app and a PENDING price is never a number.

# ── backups, used by scripts/live/backup-live-db.js on the server (not read by the API)
# the folder the encrypted backups are written to (outside the repository, not world readable)
# BACKUP_DIR=
# the path of a file that holds the backup passphrase (at least 20 characters, mode 600, kept off the server's own disk copy of the backups)
# BACKUP_PASSPHRASE_FILE=
# how many backups to keep (default 14)
# BACKUP_KEEP=
