{
  "name": "get4domain-backend-api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "registry:build": "node ../registry/build.mjs",
    "registry:check": "node ../registry/check.mjs",
    "verify:commercial": "node scripts/commercial-verify/run-all.js",
    "verify:migrations": "node scripts/verify-migrations.js",
    "verify:raw-sql": "node scripts/verify-raw-sql.js",
    "verify:db-lock": "node scripts/verify-db-lock.js",
    "db:staging:baseline-sql": "node scripts/staging/run.js baseline-sql",
    "db:staging:extensions": "node scripts/staging/run.js extensions",
    "db:staging:apply-baseline": "node scripts/staging/run.js apply-baseline",
    "db:staging:resolve-all": "node scripts/staging/run.js resolve-all",
    "db:staging:rls": "node scripts/staging/run.js rls",
    "db:staging:migrate-status": "node scripts/staging/run.js status",
    "db:staging:rls-off": "node scripts/staging/run.js rls-off",
    "db:staging:all": "node scripts/staging/run.js all",
    "build": "prisma generate && nest build",
    "start": "node dist/src/main",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/src/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "prisma:seed": "ts-node prisma/seed.ts",
    "seed:registry": "ts-node prisma/seed-registry.ts"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.28",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.28",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.28",
    "@nestjs/schedule": "^12.0.1",
    "@nestjs/swagger": "^11.4.6",
    "@nestjs/throttler": "^6.7.1",
    "@prisma/client": "6.19.3",
    "bcryptjs": "^2.4.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "dom-serializer": "^2.0.0",
    "domhandler": "^5.0.3",
    "domutils": "^3.2.2",
    "fflate": "^0.8.3",
    "htmlparser2": "^8.0.2",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "postcss": "^8.5.16",
    "qrcode": "^1.5.4",
    "razorpay": "^2.9.5",
    "reflect-metadata": "^0.2.2",
    "resend": "^4.0.1",
    "rxjs": "^7.8.1",
    "sharp": "^0.33.5",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "@types/passport-jwt": "^4.0.1",
    "@types/qrcode": "^1.5.6",
    "@types/web-push": "^3.6.4",
    "prisma": "6.19.3",
    "source-map-support": "^0.5.21",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.0"
  }
}
