}

model V3OrderItem {
  id         String @id @default(cuid())
  orderId    String
  productRef String
  name       String
  qty        Int
  unitPaise  Int
  taxJson    Json   @default("{}")

  order V3Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("g4d_order_items")
}

/// The webhook inbox of a vendor's own gateway. Append-only.
model V3VendorPaymentEvent {
  id              String   @id @default(cuid())
  vendorId        String
  methodId        String
  providerEventId String
  signatureValid  Boolean
  payloadJson     Json     @default("{}") // redacted
  result          String
  at              DateTime @default(now())

  @@unique([vendorId, providerEventId])
  @@index([vendorId, at])
  @@map("g4d_vendor_payment_events")
}

model V3VendorInvoice {
  id            String                @id @default(cuid())
  vendorId      String
  orderId       String?
  requestId     String?
  seq           Int
  invoiceNumber String
  issuedAt      DateTime              @default(now())
  snapshotJson  Json                  @default("{}")
  status        V3VendorInvoiceStatus @default(ISSUED)
  voidedAt      DateTime?
  voidReason    String?

  vendor Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@unique([vendorId, seq])
  @@unique([vendorId, invoiceNumber])
  @@index([vendorId, orderId])
  @@map("g4d_vendor_invoices")
}

/// Gap-free per-vendor counters: the next number is taken with one atomic statement, so two parallel requests can never get the same number or leave a gap.
model V3VendorCounter {
  id       String        @id @default(cuid())
  vendorId String
  kind     V3CounterKind
  value    Int           @default(0)

  vendor Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@unique([vendorId, kind])
