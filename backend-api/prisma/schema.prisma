model V3Order {
  id            String             @id @default(cuid())
  vendorId      String
  requestId     String             @unique
  orderNo       Int
  status        V3OrderStatus      @default(PLACED)
  paymentMode   V3OrderPaymentMode
  methodId      String?
  amountPaise   Int
  currency      String             @default("INR")
  reviewFlag    Boolean            @default(false) // a vendor gateway event whose amount did not match: never marked PAID
  shippingJson  Json               @default("{}")
  trackingJson  Json               @default("{}")
  refundedPaise Int                @default(0) // a recorded fact only; no provider call
  paidAt        DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  vendor  Vendor        @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  request V3Request     @relation(fields: [requestId], references: [id], onDelete: Cascade)
