  sampleType String    @default("Blood") // Blood | Urine | Imaging | Swab | Other
  price      Float     @default(0)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([vendorId])
  @@index([orderId])
  @@map("g4d_test_order_items")
}

// ── Phase 3 — Photography: shoot scheduling + delivery tracking ──
model PhotoShoot {
  id              String             @id @default(cuid())
  vendorId        String
  vendor          Vendor             @relation(fields: [vendorId], references: [id])
  title           String
  clientName      String
  contactId       String?
  eventType       String             @default("Wedding") // Wedding | Pre-Wedding | Portrait | Product | Event | Other
  eventDate       DateTime?
  venue           String?
  coverageHours   Int?
  status          String             @default("enquiry") // enquiry | confirmed | shot | delivered | cancelled
  packageValue    Float              @default(0)
  advancePaid     Float              @default(0)
  deliveryDueDate DateTime?
  deliveredAt     DateTime?
  galleryUrl      String?
  notes           String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
