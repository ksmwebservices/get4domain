  @@index([vendorId])
  @@index([vendorId, status])
  @@map("g4d_photo_shoots")
}

model ShootDeliverable {
  id        String     @id @default(cuid())
  vendorId  String
  vendor    Vendor     @relation(fields: [vendorId], references: [id])
  shootId   String
  shoot     PhotoShoot @relation(fields: [shootId], references: [id], onDelete: Cascade)
  name      String
  status    String     @default("pending") // pending | in_progress | delivered
  dueDate   DateTime?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([vendorId])
  @@index([shootId])
  @@map("g4d_shoot_deliverables")
}

// ── Phase 3 — Agriculture: produce order + inventory tracking ──
model ProduceOrder {
  id           String    @id @default(cuid())
  vendorId     String
  vendor       Vendor    @relation(fields: [vendorId], references: [id])
  buyerName    String
  contactId    String?
  produceName  String
  quantity     Float     @default(0)
  unit         String    @default("kg") // kg | quintal | tonne | dozen | crate
  grade        String    @default("A") // A | B | C
  ratePerUnit  Float     @default(0)
  totalAmount  Float     @default(0)
  status       String    @default("pending") // pending | confirmed | dispatched | delivered | cancelled
  harvestDate  DateTime?
  dispatchDate DateTime?
  deliveryDate DateTime?
  notes        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([vendorId])
  @@index([vendorId, status])
  @@map("g4d_produce_orders")
}

model ProduceStock {
  id                String    @id @default(cuid())
  vendorId          String
  vendor            Vendor    @relation(fields: [vendorId], references: [id])
  produceName       String
  grade             String    @default("A")
  unit              String    @default("kg")
  quantityAvailable Float     @default(0)
  ratePerUnit       Float     @default(0)
  harvestDate       DateTime?
  status            String    @default("available") // available | reserved | sold
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([vendorId])
  @@map("g4d_produce_stock")
}

// ── Phase 3 — Coaching Centre: batch/session scheduling + student tracking ──
model CoachingBatch {
  id          String               @id @default(cuid())
  vendorId    String
  vendor      Vendor               @relation(fields: [vendorId], references: [id])
  name        String
  subject     String?
  faculty     String?
  timing      String? // "Mon/Wed/Fri 6-8pm"
  mode        String               @default("Classroom") // Classroom | Online | Hybrid
  startDate   DateTime?
  capacity    Int                  @default(30)
  fee         Float                @default(0)
  status      String               @default("upcoming") // upcoming | active | completed
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  enrollments CoachingEnrollment[]
  sessions    CoachingSession[]

  @@index([vendorId])
  @@map("g4d_coaching_batches")
}

model CoachingEnrollment {
  id              String         @id @default(cuid())
  vendorId        String
  vendor          Vendor         @relation(fields: [vendorId], references: [id])
  studentName     String
  contactId       String?
  studentPhone    String?
  guardianContact String?
  batchId         String?
  batch           CoachingBatch? @relation(fields: [batchId], references: [id], onDelete: SetNull)
  enrollDate      DateTime       @default(now())
  feeAmount       Float          @default(0)
  feePaid         Float          @default(0)
  status          String         @default("enrolled") // enrolled | ongoing | completed | dropped
  notes           String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([vendorId])
  @@index([vendorId, status])
  @@map("g4d_coaching_enrollments")
}

model CoachingSession {
  id        String        @id @default(cuid())
  vendorId  String
  vendor    Vendor        @relation(fields: [vendorId], references: [id])
  batchId   String
  batch     CoachingBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  topic     String
  date      DateTime?
  startTime String?
  status    String        @default("scheduled") // scheduled | held | cancelled
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([vendorId])
  @@index([batchId])
  @@map("g4d_coaching_sessions")
}

// ── Phase 3 — Technology & IT: project + sprint/task tracking ──
model TechProject {
  id            String        @id @default(cuid())
  vendorId      String
  vendor        Vendor        @relation(fields: [vendorId], references: [id])
  name          String
  clientName    String
  contactId     String?
  projectType   String        @default("Web") // Web | Mobile | SaaS | AI/ML | Support | Other
  techStack     String?
  billingType   String        @default("Fixed") // Fixed | Hourly | Retainer
  status        String        @default("proposal") // proposal | in_progress | testing | delivered | cancelled
  contractValue Float         @default(0)
  deadline      DateTime?
  notes         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  tasks         ProjectTask[]

  @@index([vendorId])
  @@index([vendorId, status])
  @@map("g4d_tech_projects")
}

model ProjectTask {
  id            String       @id @default(cuid())
  vendorId      String
  vendor        Vendor       @relation(fields: [vendorId], references: [id])
  projectId     String?
  project       TechProject? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  title         String
  sprint        String? // "Sprint 3"
  status        String       @default("todo") // todo | in_progress | done
  priority      String       @default("medium") // low | medium | high
  assignee      String?
  estimateHours Float?
  dueDate       DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([vendorId])
  @@index([vendorId, status])
  @@map("g4d_project_tasks")
}

// ── Final 3 — Clinic: appointment scheduling + doctor assignment + visit tracking ──
model Doctor {
  id              String              @id @default(cuid())
  vendorId        String
  vendor          Vendor              @relation(fields: [vendorId], references: [id])
  name            String
  specialty       String?
  phone           String?
  email           String?
  consultationFee Float               @default(0)
  availability    String? // "Mon-Fri 10am-2pm"
  active          Boolean             @default(true)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  appointments    ClinicAppointment[]

  @@index([vendorId])
  @@map("g4d_doctors")
}

model ClinicAppointment {
  id                String    @id @default(cuid())
  vendorId          String
  vendor            Vendor    @relation(fields: [vendorId], references: [id])
  patientName       String
  contactId         String?
  patientPhone      String?
  doctorId          String?
  doctor            Doctor?   @relation(fields: [doctorId], references: [id], onDelete: SetNull)
  startAt           DateTime
  durationMin       Int       @default(30)
  status            String    @default("scheduled") // scheduled | confirmed | completed | no_show | cancelled
  reason            String? // symptoms / reason for visit
  fee               Float     @default(0)
  diagnosis         String?
  prescriptionNotes String?
  followUpDate      DateTime?
  notes             String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([vendorId])
  @@index([vendorId, startAt])
  @@index([vendorId, status])
  @@map("g4d_clinic_appointments")
}

// ── Final 3 — Restaurant: menu-linked order + kitchen flow (tables reuse PosTable) ──
model RestaurantOrder {
  id            String                @id @default(cuid())
  vendorId      String
  vendor        Vendor                @relation(fields: [vendorId], references: [id])
  tableId       String? // soft ref to g4d_pos_tables (reused)
  tableName     String?
  orderType     String                @default("Dine-in") // Dine-in | Takeaway | Delivery
  customerName  String?
  contactId     String?
  status        String                @default("new") // new | preparing | ready | served | billed | cancelled
  subtotal      Float                 @default(0)
  taxAmount     Float                 @default(0)
  total         Float                 @default(0)
  paymentMethod String? // cash | upi | card (set when billed)
  notes         String?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  items         RestaurantOrderItem[]

  @@index([vendorId])
  @@index([vendorId, status])
  @@map("g4d_restaurant_orders")
}

model RestaurantOrderItem {
  id            String          @id @default(cuid())
  vendorId      String
  vendor        Vendor          @relation(fields: [vendorId], references: [id])
  orderId       String
  order         RestaurantOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  catalogItemId String? // soft ref to the menu (VendorProduct)
  name          String
  station       String          @default("kitchen") // kitchen | bar
  quantity      Int             @default(1)
  price         Float           @default(0)
  status        String          @default("queued") // queued | preparing | ready | served
  notes         String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([vendorId])
  @@index([orderId])
  @@map("g4d_restaurant_order_items")
}

// ── Final 3 — Retail: product stock (sales reuse PosSale, decrement on sale) ──
model RetailProduct {
  id           String   @id @default(cuid())
  vendorId     String
  vendor       Vendor   @relation(fields: [vendorId], references: [id])
  name         String
  sku          String?
  category     String?
  price        Float    @default(0)
  stockQty     Int      @default(0)
  reorderLevel Int      @default(5)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([vendorId])
  @@map("g4d_retail_products")
}

// ── OPERATION REGISTRY (PRD §10, §31-33) — platform reference table ───────────
// First-class operational capabilities. Config-in-DB so the platform can evolve the
// operation catalog without a redeploy; mirrors get4domain_mvp/src/config/operations.ts.
// NOT vendor-scoped — a shared reference table seeded idempotently by `prisma/seed.ts`.
model OperationType {
  id           String   @id @default(cuid())
  key          String   @unique // appointment | booking | site_visit | cart | order | ...
  label        String
  cta          String
  groupKey     String // convert | transact | fulfil | relationship (UX ordering)
  actionIntent String? // engine action intent when transactional (else null)
  description  String
  sortOrder    Int      @default(0)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  // Universal Catalogue back-relation (VendorProduct.operationKey) — no column on this table.
  catalogItems VendorProduct[]

  @@map("g4d_operation_types")
}

// ── INDUSTRY EXPERIENCE REGISTRY (PRD §8, §31-32) — platform reference table ──
// Makes industry selection meaningful: drives vendor modules + mobile nav, client
// modules, CRM pipeline, and primary/secondary operations. Mirrors
// get4domain_mvp/src/config/industry-experience.ts. Array/object fields use Json to
// match this schema's convention (see Vendor.configOverride etc.). Seeded idempotently.
model IndustryExperience {
  id                  String   @id @default(cuid())
  industry            String   @unique // canonical engine id (clinic, salon, gym, ...)
  label               String
  groupKey            String // PRD §31 industry group
  businessModel       String // product | service | property | appointment | booking | ...
  primaryOperation    String // OperationType.key
  secondaryOperations Json // string[] of OperationType.key
  primaryCta          String
  vendorModules       Json // string[]
  vendorMobileNav     Json // string[] (≤5)
  clientModules       Json // string[]
  crmPipeline         Json // string[] pipeline stages
  active              Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@map("g4d_industry_experiences")
}

/// One SMS OTP per mobile number per IST calendar day (demo-gate cost control,
/// dispatch 24-Sep-2026). One row per phone, upserted on every successful OTP
/// verification (real code or same-day auto-pass) — `verifiedAt` is checked against
/// "today in Asia/Kolkata" at request time, not stored as a separate day string, so
/// there is one source of truth. Deliberately its own tiny table, not new columns on
/// Lead: a Lead row doesn't exist yet at OTP-request time for a brand-new number, and
/// this must stay fully decoupled from the existing category-visit cap on Lead.
model OtpDailyVerification {
  phone      String   @id // 10-digit, same normalization as OtpService.key()
  verifiedAt DateTime
  updatedAt  DateTime @updatedAt

  @@map("g4d_otp_daily_verifications")
}

// ═══════════════════════════════════════════════════════════════════════════════════
// COMMERCIAL ENGINE v1 (dispatch 07-Oct-2026) — custom deals, pay links, UPI QR, promos.
// ADDITIVE ONLY. Money is paise (Int). Entitlements derive from `planKey`, never from price.
// Note: the model is called BillingDeal because `Deal` is already the real-estate model.
// ═══════════════════════════════════════════════════════════════════════════════════

enum BillingPlanKey {
  WORKSPACE
  BOS
}

enum BillingCycle {
  MONTHLY
  HALF_YEARLY
  ANNUAL
  CUSTOM_MONTHS
}

enum GstMode {
  EXCLUSIVE
  INCLUSIVE
  NONE
}

enum BillingTermStatus {
  DEMO
  ACTIVE
  ACTIVE_PAYMENT_DUE
  LAPSED
  CANCELLED
}

enum TermSource {
  STANDARD
  ADMIN_DEAL
}

enum DealStatus {
  DRAFT
  SENT
  ACCEPTED
  EXPIRED
}

enum InvoiceKind {
  ACTIVATION
  RENEWAL
  PLAN_CHANGE
  ADDON
  MANAGED_SERVICE
}

enum PayChannel {
  RAZORPAY
  UPI_QR
  OFFLINE
}

enum SubmissionStatus {
  SUBMITTED
  CONFIRMED
  REJECTED
}

enum PromoType {
  PERCENT
  FLAT
}

enum PlanChangeEffective {
  AT_RENEWAL
  NOW
}

enum PlanChangeStatus {
  REQUESTED
  APPROVED
  REJECTED
  APPLIED
}

/// Single-row payee configuration (UPI VPA, optional static QR, bank details, instructions).
model PayeeSettings {
  id                String   @id @default(cuid())
  key               String   @unique @default("default")
  upiId             String?
  payeeName         String?
  qrImageUrl        String?
  bankName          String?
  bankAccountName   String?
  bankAccountNumber String?
  bankIfsc          String?
  bankBranch        String?
  instructions      String?
  updatedBy         String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("g4d_payee_settings")
}

/// A vendor's commercial term. History is kept (isCurrent marks the live one).
model BillingTerm {
  id                       String            @id @default(cuid())
  vendorId                 String
  vendor                   Vendor            @relation(fields: [vendorId], references: [id])
  planKey                  BillingPlanKey
  billingCycle             BillingCycle
  cycleMonths              Int
  listAmountPaise          Int
  discountPaise            Int               @default(0)
  netAmountPaise           Int
  gstMode                  GstMode           @default(EXCLUSIVE)
  gstNote                  String?
  periodStart              DateTime?
  periodEnd                DateTime?
  graceDays                Int               @default(7)
  status                   BillingTermStatus @default(DEMO)
  source                   TermSource        @default(STANDARD)
  isCurrent                Boolean           @default(true)
  allowedChannels          PayChannel[]      @default([])
  scheduledNextPlan        BillingPlanKey?
  scheduledNextCycle       BillingCycle?
  scheduledNextCycleMonths Int?
  scheduledNextNetPaise    Int? // price KSM approved for the scheduled change (null = list price); the renewal invoice bills exactly this
  scheduledNextDiscountReason String? // why the approved price differs from list
  aiCreditPaise            Int? // one-time AI Studio credit this term entitles the vendor to (prorated by term; null = compute from plan+months)
  subscriptionId           String? // legacy Subscription row that carries the theme-change counter
  activationInvoiceId      String?
  renewalInvoiceId         String? // the renewal invoice created by the T-15 job (idempotency)
  paymentDueAt             DateTime? // ACTIVE_PAYMENT_DUE: when payment is expected
  activatedAt              DateTime?
  lapsedAt                 DateTime?
  reminders                Json? // { T15, T7, T1, OVERDUE: ISO timestamps } — which reminders were sent
  createdBy                String?
  createdAt                DateTime          @default(now())
  updatedAt                DateTime          @updatedAt

  @@index([vendorId, isCurrent])
  @@index([status, periodEnd])
  @@map("g4d_billing_terms")
}

/// An admin-built commercial offer for an existing vendor or a prospect (with a demo subdomain).
model BillingDeal {
  id               String          @id @default(cuid())
  vendorId         String?
  vendor           Vendor?         @relation(fields: [vendorId], references: [id])
  prospectName     String?
  prospectPhone    String?
  prospectEmail    String?
  prospectBusiness String?
  demoSubdomain    String?
  status           DealStatus      @default(DRAFT)
  planKey          BillingPlanKey?
  billingCycle     BillingCycle?
  cycleMonths      Int?
  lineItems        Json // [{ kind, label, amountPaise, qty }] — server-built, not client totals
  listAmountPaise  Int             @default(0)
  discountPaise    Int             @default(0)
  discountReason   String?
  promoCodeId      String?
  gstMode          GstMode         @default(EXCLUSIVE)
  graceDays        Int             @default(7)
  allowedChannels  PayChannel[]    @default([])
  linkExpiryDays   Int             @default(14)
  allowPromoEntry  Boolean         @default(false)
  activateNow      Boolean         @default(false)
  paymentDueDays   Int?
  aiCreditPaise     Int? // AI Studio credit for this deal's term (computed from plan+months, or the admin's override); stored so the term gets a concrete number
  notes            String?
  createdBy        String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  invoices Invoice[]

  @@index([vendorId])
  @@index([status])
  @@map("g4d_billing_deals")
}

/// A payer's "I have paid" claim for UPI / bank transfer. Proof files live on PRIVATE disk.
model ManualPaymentSubmission {
  id                   String           @id @default(cuid())
  invoiceId            String
  utr                  String           @unique // normalised upper-case; a duplicate is rejected and flagged
  claimedAmountPaise   Int // what the payer says they sent — a claim, never used to credit
  confirmedAmountPaise Int? // what admin actually received
  paidAt               DateTime
  screenshotUrl        String? // private reference (never a public URL, never in any list API)
  screenshotMime       String?
  payerNote            String?
  status               SubmissionStatus @default(SUBMITTED)
  reviewedBy           String?
  reviewedAt           DateTime?
  reason               String?
  submittedByIpHash    String?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  @@index([invoiceId])
  @@index([status])
  @@map("g4d_manual_payment_submissions")
}

model PromoCode {
  id              String           @id @default(cuid())
  code            String           @unique // stored upper-case; lookups are case-insensitive
  description     String?
  type            PromoType
  value           Int // PERCENT: whole percent (1-100); FLAT: paise
  appliesToPlans  BillingPlanKey[] @default([])
  appliesToCycles BillingCycle[]   @default([])
  appliesToKinds  InvoiceKind[]    @default([])
  minCycleMonths  Int?
  validFrom       DateTime?
  validTo         DateTime?
  maxRedemptions  Int?
  perVendorLimit  Int              @default(1)
  active          Boolean          @default(true)
  createdBy       String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  redemptions PromoRedemption[]

  @@map("g4d_promo_codes")
}

/// Recorded ONLY when the invoice reaches PAID.
model PromoRedemption {
  id            String    @id @default(cuid())
  promoCodeId   String
  promoCode     PromoCode @relation(fields: [promoCodeId], references: [id])
  vendorId      String
  invoiceId     String    @unique // one promo per invoice
  discountPaise Int
  redeemedAt    DateTime  @default(now())

  @@index([promoCodeId])
  @@index([vendorId])
  @@map("g4d_promo_redemptions")
}

model PlanChangeRequest {
  id                   String              @id @default(cuid())
  vendorId             String
  vendor               Vendor              @relation(fields: [vendorId], references: [id])
  fromTermId           String?
  toPlanKey            BillingPlanKey
  toCycle              BillingCycle
  toCycleMonths        Int
  effective            PlanChangeEffective @default(AT_RENEWAL)
  status               PlanChangeStatus    @default(REQUESTED)
  prorationCreditPaise Int                 @default(0)
  listPaise            Int? // list price of the target plan/cycle at approval
  approvedNetPaise     Int? // net price (before GST) the admin approved; equals listPaise unless overridden
  discountReason       String? // mandatory when approvedNetPaise < listPaise
  vendorNote           String?
  adminNote            String?
  newInvoiceId         String?
  requestedAt          DateTime            @default(now())
  reviewedBy           String?
  reviewedAt           DateTime?
  appliedAt            DateTime?
  updatedAt            DateTime            @updatedAt

  @@index([vendorId])
  @@index([status])
  @@map("g4d_plan_change_requests")
}

/// Append-only audit trail for money-affecting admin actions (discounts, overrides, confirmations).
model CommercialAuditLog {
  id         String   @id @default(cuid())
  actor      String
  actorRole  String?
  action     String
  entityType String
  entityId   String
  detail     Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("g4d_commercial_audit_log")
}

enum StockMovementReason {
  ONLINE_ORDER
  SHOP_SALE
  ADJUSTMENT
  RETURN
  CANCEL
  OPENING
  DAMAGE
  RECOUNT
  PURCHASE
  TRANSFER
}

/// Append-only ledger of every stock change on a VendorProduct. Written in the SAME transaction as the stock update.
model StockMovement {
  id             String              @id @default(cuid())
  vendorId       String
  productId      String
  product        VendorProduct       @relation(fields: [productId], references: [id], onDelete: Cascade)
  delta          Int
  reason         StockMovementReason
  refType        String?
  refId          String?
  note           String?
  balanceAfter   Int
  createdBy      String?
  idempotencyKey String              @unique
  /// BOS (additive): which variant (size / colour) and which stock location the movement belongs to; null = the product total / default location.
  variantKey     String?
  locationId     String?
  createdAt      DateTime            @default(now())

  @@index([vendorId, productId, createdAt])
  @@index([refType, refId])
  @@map("g4d_stock_movements")
}

/// Release 1A: an admin-controlled exception to the standard commercial rule (annual, Razorpay only, GST 18% on top).
/// Only an ACTIVE row whose validUntil has not passed lets a deal/invoice use a half-year term, GST not charged, or a manual (UPI QR / offline) channel.
/// ADDITIVE: new table; existing rows and behaviour are untouched. `history` is an append-only JSON list of every change (also written to the commercial audit log).
model SpecialArrangement {
  id                String       @id @default(cuid())
  vendorId          String
  vendor            Vendor       @relation(fields: [vendorId], references: [id])
  allowHalfYear     Boolean      @default(false)
  gstMode           GstMode      @default(EXCLUSIVE)
  allowedChannels   PayChannel[] @default([])
  validUntil        DateTime
  reason            String
  createdBy         String
  active            Boolean      @default(true)
  endedAt           DateTime?
  endedBy           String?
  endReason         String?
  history           Json         @default("[]")
  expiryWarnedAt    DateTime? // the 15-days-before notice went out (idempotency)
  expiredNotifiedAt DateTime? // the expired notice went out (idempotency)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@index([vendorId, active])
  @@index([validUntil])
  @@map("g4d_special_arrangements")
}

// ══════════════════════════════════════════════════════════════════════════════════════════════════════════════
// FULL BOS SPINE (dispatch 09-Oct-2026) — ADDITIVE ONLY. One set of business records for every plan and every industry:
// parties are the existing Contact rows, items are the existing VendorProduct rows, stock is the existing StockMovement ledger.
// Money is integer paise. Documents are numbered gaplessly per vendor, per document type, per financial year. Everything posts to
// a double-entry journal in the same transaction as the document. Posted documents are never deleted: cancel = reversal.
// Plans only switch screens, reports and limits on or off; nothing here is gated at capture time.
// ══════════════════════════════════════════════════════════════════════════════════════════════════════════════

/// Per-vendor business settings for the BOS (one row per vendor, created on first use).
model BosSettings {
  id                  String    @id @default(cuid())
  vendorId            String    @unique
  /// Registered for GST? false = bills are "Bill of Supply" with no tax.
  gstRegistered       Boolean   @default(false)
  gstin               String?
  legalName           String?
  /// Vendor state, used for place of supply (CGST+SGST inside the state, IGST outside).
  state               String?
  defaultGstRate      Float     @default(18)
  /// Prices entered on documents include GST (INCLUSIVE) or not (EXCLUSIVE).
  priceMode           String    @default("EXCLUSIVE")
  roundOff            Boolean   @default(true)
  /// Per document type prefixes, e.g. { "SALES_INVOICE": "SNR" }. Missing = built-in default.
  prefixes            Json?
  /// BLOCK | WARN | ALLOW — what a sale does when stock would go below zero.
  negativeStock       String    @default("WARN")
  /// PAID | CONFIRMED | OFF — when a website order creates its invoice by itself.
  orderInvoiceOn      String    @default("PAID")
  /// A purchase bill updates the item purchase price.
  purchaseUpdatesCost Boolean   @default(true)
  bankDetails         String?
  upiId               String?
  terms               String?
  notes               String?
  /// Documents dated on or before this day cannot be created, changed or cancelled (period lock).
  lockedUntil         DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@map("g4d_bos_settings")
}

/// Gapless numbering: one row per (vendor, document type, financial year). Incremented inside the document's own transaction,
/// so a failed document never burns a number.
model BosDocSeries {
  id         String @id @default(cuid())
  vendorId   String
  docType    String
  fy         String // "26-27"
  lastNumber Int    @default(0)

  @@unique([vendorId, docType, fy])
  @@map("g4d_bos_doc_series")
}

/// Quote, sales order, sales invoice, credit note and purchase bill share one header table (docType). A sales invoice is called
/// BosDocument/SALES_INVOICE so it can never be confused with Get4Domain's own `Invoice` (what the vendor pays Get4Domain).
model BosDocument {
  id               String   @id @default(cuid())
  vendorId         String
  /// QUOTE | SALES_ORDER | SALES_INVOICE | CREDIT_NOTE | PURCHASE_BILL
  docType          String
  number           String?  // null while DRAFT; assigned on issue
  fy               String?
  /// DRAFT | ISSUED | PART_PAID | PAID | CANCELLED (quotes: DRAFT | ISSUED(sent) | ACCEPTED | REJECTED | CONVERTED | CANCELLED)
  status           String   @default("DRAFT")
  partyId          String?
  partyName        String?  // snapshot at issue time (walk-in customers have no party)
  partyGstin       String?
  partyState       String?
  billingAddress   String?
  docDate          DateTime
  dueDate          DateTime?
  /// GST (tax invoice) | NONE (bill of supply, no tax)
  taxKind          String   @default("NONE")
  priceMode        String   @default("EXCLUSIVE")
  placeOfSupply    String?
  intraState       Boolean  @default(true)
  subtotalPaise    Int      @default(0) // sum of line amounts before document discount, ex-tax
  discountPaise    Int      @default(0)
  shippingPaise    Int      @default(0)
  taxablePaise     Int      @default(0)
  cgstPaise        Int      @default(0)
  sgstPaise        Int      @default(0)
  igstPaise        Int      @default(0)
  roundOffPaise    Int      @default(0)
  totalPaise       Int      @default(0)
  /// Money received/credited against this document (derived from allocations, cached for lists).
  paidPaise        Int      @default(0)
  /// MANUAL | COUNTER | ORDER | QUOTE | RECURRING | WEBSITE
  source           String   @default("MANUAL")
  sourceType       String?  // e.g. POS_SALE
  sourceId         String?  // e.g. the PosSale id of the website order
  refDocId         String?  // credit note → invoice; invoice → quote; supplier credit etc.
  supplierRef      String?  // the supplier's own bill number (purchase bills)
  notes            String?
  terms            String?
  publicToken      String?  @unique
  idempotencyKey   String?
  issuedAt         DateTime?
  cancelledAt      DateTime?
  cancelReason     String?
  createdBy        String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  lines            BosDocumentLine[]

  @@unique([vendorId, docType, number])
  @@unique([vendorId, idempotencyKey])
  @@unique([vendorId, docType, sourceType, sourceId])
  @@index([vendorId, docType, status])
  @@index([vendorId, partyId])
  @@index([vendorId, docDate])
  @@map("g4d_bos_documents")
}

model BosDocumentLine {
  id             String      @id @default(cuid())
  documentId     String
  document       BosDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  vendorId       String
  lineNo         Int
  itemId         String?     // VendorProduct id (null = free text line)
  name           String
  description    String?
  variantKey     String?     // e.g. "9 / Black"
  hsn            String?
  unit           String?
  qty            Float       @default(1)
  ratePaise      Int         @default(0) // per unit, as entered (ex-tax or incl-tax by the document price mode)
  discountPaise  Int         @default(0) // line discount
  taxablePaise   Int         @default(0)
  gstRate        Float       @default(0)
  cgstPaise      Int         @default(0)
  sgstPaise      Int         @default(0)
  igstPaise      Int         @default(0)
  totalPaise     Int         @default(0)
  /// Purchase cost per unit at the moment of sale; drives cost of goods sold and item-wise profit.
  unitCostPaise  Int?
  /// Stock units this line moved (0 for untracked items).
  stockQty       Float       @default(0)
  /// Credit note lines: the invoice line this one returns (so a line can never be credited more than once), and whether the goods go back on the shelf.
  refLineId      String?
  restock        Boolean     @default(true)

  @@index([documentId])
  @@index([vendorId, itemId])
  @@map("g4d_bos_document_lines")
}

/// Money in (receipt) or money out (payment to a supplier). Allocated to documents; any part not allocated is an advance.
model BosPayment {
  id             String   @id @default(cuid())
  vendorId       String
  /// RECEIPT | PAYMENT_OUT
  kind           String
  number         String?
  fy             String?
  partyId        String?
  partyName      String?
  /// CASH | UPI | BANK | CARD | CHEQUE | GATEWAY
  mode           String   @default("CASH")
  amountPaise    Int
  paymentDate    DateTime
  reference      String?
  notes          String?
  /// ACTIVE | CANCELLED
  status         String   @default("ACTIVE")
  source         String   @default("MANUAL") // MANUAL | COUNTER | ORDER | GATEWAY
  sourceId       String?
  idempotencyKey String?
  cancelledAt    DateTime?
  cancelReason   String?
  createdBy      String?
  createdAt      DateTime @default(now())
  allocations    BosAllocation[]

  @@unique([vendorId, kind, number])
  @@unique([vendorId, idempotencyKey])
  @@index([vendorId, partyId])
  @@index([vendorId, paymentDate])
  @@map("g4d_bos_payments")
}

/// A slice of a payment or a credit note applied to an invoice or purchase bill.
model BosAllocation {
  id           String      @id @default(cuid())
  vendorId     String
  documentId   String      // the invoice / purchase bill being settled
  paymentId    String?
  payment      BosPayment? @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  creditNoteId String?     // a CREDIT_NOTE document applied to the invoice
  amountPaise  Int
  createdAt    DateTime    @default(now())

  @@index([vendorId, documentId])
  @@index([paymentId])
  @@map("g4d_bos_allocations")
}

model BosExpense {
  id             String   @id @default(cuid())
  vendorId       String
  number         String?
  fy             String?
  expenseDate    DateTime
  /// Account code of the expense head (see the chart of accounts), e.g. 5300 Rent.
  category       String
  description    String
  supplierId     String?
  taxablePaise   Int
  gstRate        Float    @default(0)
  cgstPaise      Int      @default(0)
  sgstPaise      Int      @default(0)
  igstPaise      Int      @default(0)
  totalPaise     Int
  /// CASH | UPI | BANK | CARD | CHEQUE | CREDIT (unpaid, owed to the supplier)
  paymentMode    String   @default("CASH")
  attachment     String?
  /// NONE | MONTHLY | QUARTERLY | YEARLY
  recurring      String   @default("NONE")
  /// ACTIVE | CANCELLED
  status         String   @default("ACTIVE")
  idempotencyKey String?
  cancelledAt    DateTime?
  cancelReason   String?
  createdBy      String?
  createdAt      DateTime @default(now())

  @@unique([vendorId, number])
  @@unique([vendorId, idempotencyKey])
  @@index([vendorId, expenseDate])
  @@map("g4d_bos_expenses")
}

/// Chart of accounts, seeded per vendor on first use. `system` accounts cannot be removed.
model BosAccount {
  id        String  @id @default(cuid())
  vendorId  String
  code      String
  name      String
  /// ASSET | LIABILITY | INCOME | EXPENSE | EQUITY
  type      String
  system    Boolean @default(false)

  @@unique([vendorId, code])
  @@map("g4d_bos_accounts")
}

model BosJournalEntry {
  id            String   @id @default(cuid())
  vendorId      String
  entryDate     DateTime
  /// SALES_INVOICE | CREDIT_NOTE | PURCHASE_BILL | RECEIPT | PAYMENT_OUT | EXPENSE | STOCK | OPENING
  sourceType    String
  sourceId      String
  sourceVersion Int      @default(1)
  memo          String?
  /// Set when this entry reverses another (cancellation).
  reversalOfId  String?
  createdAt     DateTime @default(now())
  lines         BosJournalLine[]

  @@unique([vendorId, sourceType, sourceId, sourceVersion])
  @@index([vendorId, entryDate])
  @@index([vendorId, sourceType, sourceId])
  @@map("g4d_bos_journal_entries")
}

model BosJournalLine {
  id          String          @id @default(cuid())
  entryId     String
  entry       BosJournalEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  vendorId    String
  accountCode String
  partyId     String?
  debitPaise  Int             @default(0)
  creditPaise Int             @default(0)

  @@index([entryId])
  @@index([vendorId, accountCode])
  @@index([vendorId, partyId])
  @@map("g4d_bos_journal_lines")
}

/// Stock locations (Pro: more than one). Every vendor has one default location, created on first use.
model BosStockLocation {
  id        String  @id @default(cuid())
  vendorId  String
  name      String
  isDefault Boolean @default(false)
  active    Boolean @default(true)

  @@unique([vendorId, name])
  @@map("g4d_bos_stock_locations")
}

/// A recurring invoice template (Pro): the daily job issues a new invoice from it on `nextRunOn`.
model BosRecurring {
  id           String    @id @default(cuid())
  vendorId     String
  templateId   String // a SALES_INVOICE document used as the template
  /// MONTHLY | QUARTERLY | YEARLY
  frequency    String
  nextRunOn    DateTime
  endsOn       DateTime?
  active       Boolean   @default(true)
  lastRunOn    DateTime?
  createdAt    DateTime  @default(now())

  @@index([vendorId, active, nextRunOn])
  @@map("g4d_bos_recurring")
}

/// Admin-editable plan access (Release: Full BOS). `key` = a registry feature id or capability id, `value` = { minPlan?, limits? }.
/// The registry holds the defaults; a row here changes them without a deploy.
model PlanOverride {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  updatedBy String?
  updatedAt DateTime @updatedAt

  @@map("g4d_plan_overrides")
}

// ── LEADSPACE (Dispatch B, 10-Oct-2026) — ADDITIVE ONLY ─────────────────────────────────────────────
// A free single landing page per vendor, verified enquiries / bookings / site visits / orders, a prepaid LEADS purse charged per verified event,
// and a Get4Domain-run promotion scheduler. Vendor links are soft (vendorId, no FK) so no existing table changes. Money is integer paise.

/// One per vendor: the landing page and its single goal.
model LeadspaceProfile {
  id                 String    @id @default(cuid())
  vendorId           String    @unique
  slug               String    @unique
  category           String
  subcategory        String?
  city               String
  serviceArea        String?
  /// ENQUIRY | BOOKING | APPOINTMENT | SITE_VISIT | CART_ORDER
  goal               String    @default("ENQUIRY")
  /// TEMPLATE | EXISTING_PAGE
  mode               String    @default("TEMPLATE")
  templateId         String    @default("generic")
  businessName       String
  tagline            String?
  about              String?
  phone              String?
  /// The vendor's own WhatsApp number: where alerts go and where the conversation continues.
  alertWhatsapp      String?
  email              String?
  address            String?
  mapsLink           String?
  heroImage          String?
  /// [{ name, price?, description?, image? }]
  services           Json      @default("[]")
  /// { headline?, text?, validUntil? }
  offer              Json?
  gallery            Json?
  faqs               Json?
  trust              Json?
  hours              String?
  existingPageUrl    String?
  /// UNVERIFIED | VERIFIED | REJECTED
  verificationStatus String    @default("UNVERIFIED")
  noindex            Boolean   @default(true)
  /// { advocate?, clinic?, realEstate? } : regulated-trade flags set from the category
  regulated          Json?
  reraNumber         String?
  /// DRAFT | PUBLISHED | SUSPENDED
  status             String    @default("DRAFT")
  suspendedReason    String?
  /// HOLD (default: capture, hold, unlock on refill) | REJECT (polite message)
  lowBalanceMode     String    @default("HOLD")
  /// vendor switch + admin switch must both be on before any post goes out
  promotionEnabled   Boolean   @default(false)
  views              Int       @default(0)
  /// hash of the network that created the page, for the creation rate limit
  createdIpHash      String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([category, city])
  @@index([status])
  @@map("g4d_leadspace_profiles")
}

/// A verified customer event. Created in one transaction with its charge.
model LeadEvent {
  id               String    @id @default(cuid())
  vendorId         String
  profileId        String?
  /// ENQUIRY | BOOKING | APPOINTMENT | SITE_VISIT | CART_ORDER
  type             String
  customerName     String
  customerPhone    String
  phoneHash        String
  /// { message?, items?, date?, time?, service?, property?, budget?, address?, notes? }
  payload          Json      @default("{}")
  source           String?
  utm              Json?
  consentId        String?
  otpVerifiedAt    DateTime?
  /// NEW | HELD | DELIVERED | CONTACTED | WON | LOST | DISPUTED | CREDITED
  status           String    @default("NEW")
  /// the price the event was quoted at capture (null when no price rule existed yet)
  priceQuotedPaise Int?
  priceChargedPaise Int      @default(0)
  ledgerId         String?
  vendorNote       String?
  /// cart orders: PENDING | CONFIRMED | DECLINED
  orderDecision    String?
  /// the vendor's own reminder: call this customer again on or after this moment
  callbackAt       DateTime?
  idempotencyKey   String
  deliveredAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([vendorId, idempotencyKey])
  @@index([vendorId, createdAt])
  @@index([vendorId, status, createdAt])
  @@index([vendorId, phoneHash, type, createdAt])
  @@index([vendorId, callbackAt])
  @@map("g4d_lead_events")
}

/// Admin-editable fixed price per event type. Rows are never edited: a change ends the old row and adds a new one (versioned).
model LeadPriceRule {
  id            String    @id @default(cuid())
  category      String?
  city          String?
  eventType     String
  pricePaise    Int
  effectiveFrom DateTime  @default(now())
  effectiveTo   DateTime?
  createdBy     String?
  note          String?
  createdAt     DateTime  @default(now())

  @@index([eventType, effectiveFrom])
  @@map("g4d_lead_price_rules")
}

/// A typed purse. LEADS is the only kind stored here: the AI credit stays in the existing wallet, untouched.
model LeadPurse {
  id             String   @id @default(cuid())
  vendorId       String
  /// LEADS
  kind           String   @default("LEADS")
  balancePaise   Int      @default(0)
  totalCredited  Int      @default(0)
  totalDebited   Int      @default(0)
  updatedAt      DateTime @updatedAt
  createdAt      DateTime @default(now())

  @@unique([vendorId, kind])
  @@map("g4d_lead_purses")
}

/// Append-only ledger of the purse. Every row carries the running balance and a unique idempotency key.
model LeadPurseEntry {
  id             String    @id @default(cuid())
  purseId        String
  vendorId       String
  /// CREDIT | DEBIT
  type           String
  amountPaise    Int
  balanceAfter   Int
  /// REFILL | LEAD_CHARGE | CREDIT_INVALID | REFUND | ADJUSTMENT | EXPIRY
  reason         String
  refType        String?
  refId          String?
  note           String?
  idempotencyKey String    @unique
  razorpayId     String?   @unique
  expiresAt      DateTime?
  createdBy      String?
  createdAt      DateTime  @default(now())

  @@index([vendorId, createdAt])
  @@map("g4d_lead_purse_entries")
}

/// What the customer was shown and agreed to when they asked for the code.
model ConsentRecord {
  id           String   @id @default(cuid())
  phoneHash    String
  textVersion  String
  purpose      String
  vendorId     String?
  slug         String?
  ipHash       String?
  createdAt    DateTime @default(now())

  @@index([phoneHash, createdAt])
  @@map("g4d_consent_records")
}

/// Credit given back for a lead that was not valid. Every one also has a CREDIT row in the purse ledger.
model InvalidLeadCredit {
  id          String   @id @default(cuid())
  leadId      String
  vendorId    String
  /// WRONG_NUMBER | DUPLICATE | SPAM | VENDOR_OWN | OTHER
  reason      String
  /// AUTO | ADMIN
  decidedBy   String
  decidedById String?
  amountPaise Int
  note        String?
  createdAt   DateTime @default(now())

  @@index([vendorId, createdAt])
  @@index([leadId])
  @@map("g4d_invalid_lead_credits")
}

/// A vendor's dispute of a delivered lead, decided by an admin.
model LeadDispute {
  id          String    @id @default(cuid())
  leadId      String
  vendorId    String
  reason      String
  note        String?
  /// OPEN | CREDITED | REJECTED
  status      String    @default("OPEN")
  decidedBy   String?
  decisionNote String?
  decidedAt   DateTime?
  createdAt   DateTime  @default(now())

  @@index([status, createdAt])
  @@index([vendorId])
  @@map("g4d_lead_disputes")
}

/// One-time codes sent over WhatsApp. Only a hash of the code is stored.
model LeadOtp {
  id         String    @id @default(cuid())
  phoneHash  String
  codeHash   String
  vendorId   String?
  consentId  String?
  deviceHash String?
  ipHash     String?
  attempts   Int       @default(0)
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime  @default(now())

  @@index([phoneHash, createdAt])
  @@index([deviceHash, createdAt])
  @@map("g4d_lead_otps")
}

/// Numbers that never receive a code again (spam, opt-out).
model LeadBlockedPhone {
  id        String   @id @default(cuid())
  phoneHash String   @unique
  reason    String?
  createdAt DateTime @default(now())

  @@map("g4d_lead_blocked_phones")
}

/// Refill packs. `payPaise` is what the vendor pays Razorpay; `creditPaise` is what lands in the purse; `gstMode` says whether the price includes GST.
model LeadRefillPack {
  id          String   @id @default(cuid())
  label       String
  payPaise    Int
  creditPaise Int
  /// INCLUSIVE | EXCLUSIVE
  gstMode     String   @default("INCLUSIVE")
  active      Boolean  @default(true)
  sort        Int      @default(0)
  createdAt   DateTime @default(now())

  @@map("g4d_lead_refill_packs")
}

/// A vendor's request to take unused balance back.
model LeadRefundRequest {
  id            String    @id @default(cuid())
  vendorId      String
  amountPaise   Int
  note          String?
  /// REQUESTED | APPROVED | PAID | REJECTED
  status        String    @default("REQUESTED")
  paymentFeePaise Int     @default(0)
  decidedBy     String?
  decidedAt     DateTime?
  createdAt     DateTime  @default(now())

  @@index([status])
  @@map("g4d_lead_refund_requests")
}

/// Admin settings for LeadSpace (key to JSON): refund and expiry rules, dedupe window, margin floor, global kill switch, daily caps.
model LeadspaceSetting {
  key       String   @id
  value     Json
  updatedBy String?
  updatedAt DateTime @updatedAt

  @@map("g4d_leadspace_settings")
}

/// Template registry for the WhatsApp provider layer, with approval status per template.
model WhatsappTemplate {
  id                 String   @id @default(cuid())
  name               String   @unique
  /// AUTHENTICATION | UTILITY
  category           String
  language           String   @default("en")
  body               String
  /// SANDBOX | PENDING | APPROVED | REJECTED
  approvalStatus     String   @default("SANDBOX")
  providerTemplateId String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@map("g4d_whatsapp_templates")
}

/// Every message the common Get4Domain number sends (the number is masked), for spam-rate monitoring per vendor.
model WhatsappMessageLog {
  id                String   @id @default(cuid())
  provider          String
  template          String
  toMasked          String
  phoneHash         String
  vendorId          String?
  /// QUEUED | SENT | DELIVERED | FAILED | REFUSED
  status            String
  providerMessageId String?
  error             String?
  createdAt         DateTime @default(now())

  @@index([vendorId, createdAt])
  @@index([phoneHash, createdAt])
  @@map("g4d_whatsapp_message_logs")
}

/// A connected social account (Get4Domain's own page, or a vendor's own). Tokens are stored encrypted.
model SocialAccount {
  id         String    @id @default(cuid())
  /// PLATFORM | VENDOR
  ownerType  String
  vendorId   String?
  /// FACEBOOK_PAGE | INSTAGRAM | TELEGRAM | GOOGLE_BUSINESS
  channel    String
  name       String
  externalId String?
  /// the theme of a Get4Domain page, for example "Chennai Home Services Deals"
  theme      String?
  city       String?
  category   String?
  tokenEnc   String?
  scopes     Json?
  /// SANDBOX | AWAITING_APPROVAL | CONNECTED | DISCONNECTED
  status     String    @default("SANDBOX")
  dailyCap   Int       @default(3)
  lastSyncAt DateTime?
  lastError  String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([ownerType, channel])
  @@index([vendorId])
  @@map("g4d_social_accounts")
}

/// The shared publisher's post log: scheduling, retries and results.
model SocialPost {
  id             String    @id @default(cuid())
  accountId      String
  /// TEXT | IMAGE | LINK
  kind           String    @default("TEXT")
  content        String
  imageUrl       String?
  linkUrl        String?
  scheduledFor   DateTime
  /// SCHEDULED | POSTING | POSTED | FAILED | CANCELLED
  status         String    @default("SCHEDULED")
  attempts       Int       @default(0)
  nextAttemptAt  DateTime?
  providerPostId String?
  postUrl        String?
  error          String?
  results        Json?
  idempotencyKey String    @unique
  createdBy      String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([status, scheduledFor])
  @@index([accountId, scheduledFor])
  @@map("g4d_social_posts")
}

/// Which vendor Get4Domain promotes, where, how often.
model PromotionPlan {
  id              String    @id @default(cuid())
  vendorId        String    @unique
  channels        Json      @default("[]")
  /// { perWeek: number, days?: string[] }
  schedule        Json      @default("{}")
  theme           String?
  offer           String?
  /// DRAFT | ACTIVE | PAUSED
  status          String    @default("DRAFT")
  /// posts need an admin's approval until this date, then optionally never
  manualUntil     DateTime?
  autoApprove     Boolean   @default(false)
  killSwitch      Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@map("g4d_promotion_plans")
}

/// One post to make. Network groups that have no API become a manual task with ready copy.
model PostJob {
  id            String    @id @default(cuid())
  planId        String
  vendorId      String
  /// FACEBOOK_PAGE | INSTAGRAM | TELEGRAM | GOOGLE_BUSINESS | MANUAL
  channel       String
  accountId     String?
  scheduledFor  DateTime
  theme         String?
  /// { caption, hashtags?, imagePrompt? }
  content       Json
  assetUrl      String?
  linkUrl       String?
  /// DRAFT | AWAITING_APPROVAL | APPROVED | SCHEDULED | POSTED | FAILED | SKIPPED
  status        String    @default("AWAITING_APPROVAL")
  approvalLog   Json      @default("[]")
  results       Json?
  socialPostId  String?
  manualTask    Boolean   @default(false)
  manualDoneAt  DateTime?
  manualTarget  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([status, scheduledFor])
  @@index([vendorId])
  @@map("g4d_post_jobs")
}

/// Money Get4Domain spends itself on boosts (entered by hand), so cost per verified lead can be measured.
model AdSpendEntry {
  id          String   @id @default(cuid())
  date        DateTime
  channel     String
  category    String?
  city        String?
  amountPaise Int
  note        String?
  createdBy   String?
  createdAt   DateTime @default(now())

  @@index([date])
  @@map("g4d_ad_spend_entries")
}

/// "Report this page" on a public LeadSpace page.
model LeadspaceAbuseReport {
  id        String   @id @default(cuid())
  slug      String
  reason    String
  note      String?
  ipHash    String?
  /// OPEN | ACTIONED | DISMISSED
  status    String   @default("OPEN")
  createdAt DateTime @default(now())

  @@index([slug])
  @@index([status])
  @@map("g4d_leadspace_abuse_reports")
}

/// One row per page per day: the top of the funnel (page views, button taps, forms started). Views are not lead events, so they live here.
model LeadspaceDailyStat {
  id         String   @id @default(cuid())
  profileId  String
  vendorId   String
  day        DateTime @db.Date
  views      Int      @default(0)
  ctaClicks  Int      @default(0)
  formStarts Int      @default(0)
  /// taps on a product's own "buy it here" link (counted, never charged)
  outboundClicks Int  @default(0)

  @@unique([profileId, day])
  @@index([vendorId, day])
  @@map("g4d_leadspace_daily_stats")
}

// ============================================================================================================================
// V3 slice 5.1: plans, tracks and entitlements. ALL ADDITIVE. Model and enum names carry a V3 prefix because Plan, SubStatus and others already exist;
// the table names (@@map) are the ones fixed by the slice spec. No relation to any legacy billing, BOS, commercial or menu-gating model (owner decision D1).
// Every price, limit, state and rule is DATA edited by an admin; nothing is defined in code.
// ============================================================================================================================
enum V3PlanTrack {
  HANDYMAN
  PROFESSIONAL
  ECOMMERCE
}

enum V3PlanLevel {
  FREE
  PRO
}

enum V3PlanStatus {
  DRAFT
  ACTIVE
  RETIRED
}

enum V3PriceStatus {
  PROPOSED
  APPROVED
}

enum V3FeatureKind {
  BOOLEAN
  LIMIT
  ENUM
}

enum V3FeatureState {
  ACTIVE
  LIMITED
  LOCKED_PREVIEW
  HIDDEN
}

enum V3DiscountType {
  TERM
  PROMO
  MIGRATION
}

enum V3SubscriptionStatus {
  ACTIVE
  GRACE
  EXPIRED
  CANCELLED
}

enum V3SubscriptionSource {
  REGISTRATION
  SELF
  STAFF
  MIGRATION
  PROMO
}

enum V3ActorType {
  SYSTEM
  STAFF
  VENDOR
}

model V3Plan {
  id          String       @id @default(cuid())
  key         String       @unique // handyman_free, handyman_pro, professional_free, professional_pro, ecommerce_free, ecommerce_pro
  track       V3PlanTrack
  level       V3PlanLevel
  name        String
  description String?
  status      V3PlanStatus @default(DRAFT)
  isPublic    Boolean      @default(false)
  sortOrder   Int          @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  prices        V3PlanPrice[]
  features      V3PlanFeature[]
  subscriptions V3PlanSubscription[]
  orders        V3PlanOrder[]

  @@unique([track, level])
  @@map("g4d_plans")
}

model V3PlanPrice {
  id            String        @id @default(cuid())
  planId        String
  termMonths    Int // 3, 6, 12 (1 only while the setting allowMonthly is true)
  amountPaise   Int
  currency      String        @default("INR")
  taxInclusive  Boolean       @default(false)
  status        V3PriceStatus @default(PROPOSED)
  effectiveFrom DateTime      @default(now())
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  plan V3Plan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, termMonths, effectiveFrom])
  @@index([planId])
  @@map("g4d_plan_prices")
}

model V3Feature {
  id          String        @id @default(cuid())
  key         String        @unique // dotted, e.g. site.video
  name        String
  group       String
  kind        V3FeatureKind @default(BOOLEAN)
  unit        String?
  description String?
  sortOrder   Int           @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  planFeatures V3PlanFeature[]
  overrides    V3EntitlementOverride[]

  @@map("g4d_features")
}

model V3PlanFeature {
  id          String         @id @default(cuid())
  planId      String
  featureKey  String
  state       V3FeatureState @default(HIDDEN)
  limitValue  Int?
  enumValue   String?
  upsellText  String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  plan    V3Plan    @relation(fields: [planId], references: [id], onDelete: Cascade)
  feature V3Feature @relation(fields: [featureKey], references: [key], onDelete: Restrict)

  @@unique([planId, featureKey])
  @@index([featureKey])
  @@map("g4d_plan_features")
}

model V3TaxRate {
  id          String   @id @default(cuid())
  name        String
  ratePercent Decimal  @db.Decimal(6, 3)
  appliesTo   String   @default("ALL")
  active      Boolean  @default(true)
  validFrom   DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("g4d_tax_rates")
}

model V3DiscountRule {
  id             String         @id @default(cuid())
  type           V3DiscountType
  name           String
  percentOff     Decimal?       @db.Decimal(6, 3)
  amountOffPaise Int?
  conditions     Json           @default("{}")
  validFrom      DateTime       @default(now())
  validTo        DateTime?
  stackable      Boolean        @default(false)
  active         Boolean        @default(true)
  status         V3PriceStatus  @default(PROPOSED)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([type, active])
  @@map("g4d_discount_rules")
}

model V3PlanSetting {
  id          String   @id @default(cuid())
  key         String   @unique
  valueJson   Json
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("g4d_plan_settings")
}

model V3PlanSubscription {
  id                String               @id @default(cuid())
  vendorId          String
  planId            String
  status            V3SubscriptionStatus @default(ACTIVE)
  termMonths        Int? // null for a FREE plan
  startsAt          DateTime             @default(now())
  endsAt            DateTime?
  graceEndsAt       DateTime?
  source            V3SubscriptionSource
  priceSnapshotJson Json                 @default("{}")
  createdByType     V3ActorType          @default(SYSTEM)
  createdById       String?
  // At most one CURRENT (ACTIVE or GRACE) subscription per vendor: equals vendorId while current, NULL otherwise; the unique index does the rest.
  currentVendorId   String?              @unique
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  vendor Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  plan   V3Plan @relation(fields: [planId], references: [id], onDelete: Restrict)
  reminders V3ReminderLog[]

  @@index([vendorId, status])
  @@index([planId])
  @@map("g4d_plan_subscriptions")
}

model V3SubscriptionEvent {
  id             String      @id @default(cuid())
  subscriptionId String?
  vendorId       String
  type           String // ASSIGNED, CHANGED, CANCELLED, FREE_PROVISIONED
  fromPlanId     String?
  toPlanId       String?
  reason         String?
  actorType      V3ActorType @default(SYSTEM)
  actorId        String?
  at             DateTime    @default(now())

  vendor Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([vendorId, at])
  @@index([subscriptionId])
  @@map("g4d_subscription_events")
}

model V3EntitlementOverride {
  id                String         @id @default(cuid())
  vendorId          String
  featureKey        String
  state             V3FeatureState
  limitValue        Int?
  enumValue         String?
  reason            String
  expiresAt         DateTime?
  createdByStaffId  String
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  vendor  Vendor    @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  feature V3Feature @relation(fields: [featureKey], references: [key], onDelete: Restrict)

  @@index([vendorId, featureKey])
  @@index([expiresAt])
  @@map("g4d_entitlement_overrides")
}

model V3AuditLog {
  id         String      @id @default(cuid())
  actorType  V3ActorType @default(STAFF)
  actorId    String?
  action     String
  entityType String
  entityId   String?
  beforeJson Json?
  afterJson  Json?
  ip         String?
  at         DateTime    @default(now())

  @@index([entityType, entityId, at])
  @@index([at])
  @@map("g4d_audit_logs")
}

model V3VendorFlag {
  id                 String   @id @default(cuid())
  vendorId           String
  key                String // v3_plans
  enabled            Boolean  @default(false)
  updatedByStaffId   String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  vendor Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@unique([vendorId, key])
  @@map("g4d_vendor_flags")
}

// ───────────────────────────────────────────────────────────────────────────────────────────────────────────────────
// V3 slice 5.3: provisioning jobs and steps, claim tokens, invites. Additive. No relation to any legacy billing / BOS / commercial table.
// Design: docs/v3/V3_S3_PROVISIONING.md
// ───────────────────────────────────────────────────────────────────────────────────────────────────────────────────

enum V3JobKind {
  BUSINESS_FREE_SITE
}

enum V3JobStatus {
  QUEUED
  RUNNING
  WAITING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum V3StepKey {
  CREATE_VENDOR
  ASSIGN_FREE_PLAN
  CREATE_FREE_SITE_DRAFT
  CREATE_CLAIM_LINK
  SEND_INVITE
  CREATE_DIRECTORY_PROFILE
}

enum V3StepStatus {
  PENDING
  RUNNING
  DONE
  FAILED
  SKIPPED
}

enum V3ClaimPurpose {
  CLAIM
}

enum V3ClaimStatus {
  ACTIVE
  USED
  REVOKED
  EXPIRED
}

enum V3InviteChannel {
  EMAIL
}

enum V3InviteMode {
  SANDBOX
  LIVE
}

enum V3InviteStatus {
  QUEUED
  SENT
  FAILED
  BOUNCED
}

model V3ProvisioningJob {
  id             String      @id @default(cuid())
  kind           V3JobKind   @default(BUSINESS_FREE_SITE)
  status         V3JobStatus @default(QUEUED)
  idempotencyKey String      @unique
  // filled once the vendor step succeeds; a staff-only back-reference (no vendor route reads jobs)
  vendorId       String?
  input          Json // validated business details; never a secret or a token
  currentStep    V3StepKey?
  attempt        Int         @default(0)
  maxAttempts    Int         @default(5)
  nextRunAt      DateTime    @default(now())
  lockedBy       String?
  lockedUntil    DateTime?
  lastErrorCode  String?
  lastErrorMessage String? // sanitised sentence; never raw provider text
  createdByType  V3ActorType @default(STAFF)
  createdById    String?
  finishedAt     DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  vendor Vendor?               @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  steps  V3ProvisioningStep[]

  @@index([status, nextRunAt])
  @@index([vendorId])
  @@map("g4d_provisioning_jobs")
}

model V3ProvisioningStep {
  id         String       @id @default(cuid())
  jobId      String
  stepKey    V3StepKey
  status     V3StepStatus @default(PENDING)
  attempts   Int          @default(0)
  startedAt  DateTime?
  finishedAt DateTime?
  outputRef  Json? // ids only
  errorCode  String?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  job V3ProvisioningJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([jobId, stepKey])
  @@map("g4d_provisioning_steps")
}

model V3ClaimToken {
  id            String         @id @default(cuid())
  vendorId      String
  // SHA-256 (hex) of a 32-byte random token. The raw token exists only inside the invite message at send time.
  tokenHash     String         @unique
  purpose       V3ClaimPurpose @default(CLAIM)
  status        V3ClaimStatus  @default(ACTIVE)
  expiresAt     DateTime
  usedAt        DateTime?
  createdByType V3ActorType    @default(SYSTEM)
  createdById   String?
  // At most one ACTIVE token per vendor and purpose: "<vendorId>:<purpose>" while ACTIVE, NULL otherwise; the unique index does the rest.
  activeKey     String?        @unique
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  vendor  Vendor     @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  invites V3Invite[]

  @@index([vendorId, status])
  @@map("g4d_claim_tokens")
}

model V3Invite {
  id                String          @id @default(cuid())
  vendorId          String
  channel           V3InviteChannel @default(EMAIL)
  toAddress         String // stored; masked in every list
  claimTokenId      String
  adapterMode       V3InviteMode    @default(SANDBOX)
  status            V3InviteStatus  @default(QUEUED)
  providerMessageId String?
  subject           String
  bodyPreview       String // the token is masked
  // The full rendered message, ONLY in sandbox mode (staff and tests read it); never stored for a live send; cleared when the token is used or revoked.
  sandboxBody       String?
  sentAt            DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  vendor     Vendor       @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  claimToken V3ClaimToken @relation(fields: [claimTokenId], references: [id], onDelete: Cascade)

  @@index([vendorId, createdAt])
  @@index([claimTokenId])
  @@map("g4d_invites")
}

// ───────────────────────────────────────────────────────────────────────────────────────────────────────────────────
// V3 slice 5.4: site settings, versioned publications (rendered HTML snapshots), their pages, and site events. Additive. No relation to any legacy table
// (the legacy VendorCMS document is READ through a port only). Design: docs/v3/V3_S4_RENDERER_PUBLISH.md
// ───────────────────────────────────────────────────────────────────────────────────────────────────────────────────

enum V3MotionIntensity {
  OFF
  LOW
  MEDIUM
  RICH
}

enum V3PublicationStatus {
  DRAFT_PREVIEW
  PUBLISHED
  SUPERSEDED
  ROLLED_BACK
}

model V3SiteSettings {
  id              String            @id @default(cuid())
  vendorId        String            @unique
  themeId         String? // null = the category's default Standard theme
  language        String            @default("en") // en, ta, or "en,ta"
  variant         String? // the layout variant id: derived from the category, read-only for vendors
  motionIntensity V3MotionIntensity @default(LOW)
  forceNoindex    Boolean           @default(false) // staff switch: the site is noindex whatever the indexing rule says
  canonicalHost   String? // slice 5.6b: the canonical host the published pages and sitemap were last built for; the controlled switch moves it (null = never switched)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  vendor Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@map("g4d_site_settings")
}

model V3SitePublication {
  id                    String              @id @default(cuid())
  vendorId              String
  version               Int // monotonic per vendor
  status                V3PublicationStatus @default(DRAFT_PREVIEW)
  themeId               String
  themeHash             String
  contentHash           String
  settingsHash          String              @default("")
  indexable             Boolean             @default(false)
  indexHeader           String              @default("noindex, nofollow") // the robots value stored with the snapshot (meta and header)
  missingFieldsJson     Json                @default("[]")
  warningsJson          Json                @default("[]")
  languages             String              @default("en")
  totalBytes            Int                 @default(0)
  rolledBackFromVersion Int?
  createdByType         V3ActorType         @default(SYSTEM)
  createdById           String?
  createdAt             DateTime            @default(now())
  publishedAt           DateTime?
  // At most one PUBLISHED publication per vendor: equals vendorId while PUBLISHED, NULL otherwise; the unique index does the rest.
  currentVendorId       String?             @unique

  vendor Vendor                   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  pages  V3SitePublicationPage[]
  events V3SiteEvent[]

  @@unique([vendorId, version])
  @@index([vendorId, status])
  @@map("g4d_site_publications")
}

model V3SitePublicationPage {
  id            String   @id @default(cuid())
  publicationId String
  vendorId      String // denormalised so the tenant guard can scope this table too
  path          String
  lang          String
  html          String // the stored document (or sitemap / robots / stylesheet text for the platform files)
  seoJson       Json     @default("{}")
  bytes         Int
  sha256        String
  createdAt     DateTime @default(now())

  publication V3SitePublication @relation(fields: [publicationId], references: [id], onDelete: Cascade)
  vendor      Vendor            @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@unique([publicationId, path, lang])
  @@index([vendorId])
  @@map("g4d_site_publication_pages")
}

model V3SiteEvent {
  id            String      @id @default(cuid())
  vendorId      String
  publicationId String?
  type          String // BUILT, PUBLISHED, ROLLED_BACK, THEME_CHANGED, NOINDEX_CHANGED
  actorType     V3ActorType @default(SYSTEM)
  actorId       String?
  detailJson    Json        @default("{}") // ids and codes only
  createdAt     DateTime    @default(now())

  vendor      Vendor             @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  publication V3SitePublication? @relation(fields: [publicationId], references: [id], onDelete: SetNull)

  @@index([vendorId, createdAt])
  @@map("g4d_site_events")
}

// ─── V3 slice 5.6: subdomain rules and domain mapping (additive; no registrar, no real DNS or SSL change) ──────────────────────────────────────────────────

enum V3DomainKind {
  SUBDOMAIN
  CUSTOM
}

enum V3DomainStatus {
  PENDING
  VERIFYING
  ACTIVE
  FAILED
  REMOVED
}

enum V3SslStatus {
  NONE
  PENDING
  ACTIVE
  FAILED
}

model V3Domain {
  id                String         @id @default(cuid())
  vendorId          String
  hostname          String         @unique // lowercase, punycode (ASCII) form
  kind              V3DomainKind
  status            V3DomainStatus @default(PENDING)
  isPrimary         Boolean        @default(false)
  primaryVendorId   String?        @unique // = vendorId while isPrimary: one primary per vendor, enforced by the database
  subdomainVendorId String?        @unique // = vendorId while this is the vendor's ACTIVE free subdomain: one free subdomain per vendor
  verifiedAt        DateTime?
  sslStatus         V3SslStatus    @default(NONE) // recorded only; nothing in this slice issues a certificate
  createdByType     String         @default("VENDOR") // VENDOR | STAFF | SYSTEM
  createdById       String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  removedAt         DateTime?

  vendor        Vendor                 @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  verifications V3DomainVerification[]

  @@index([vendorId, status])
  @@map("g4d_domains")
}

model V3DomainVerification {
  id            String    @id @default(cuid())
  domainId      String    @unique
  vendorId      String
  method        String    @default("TXT")
  expectedValue String // public by design: it is what the owner puts in their DNS
  lastCheckedAt DateTime?
  attempts      Int       @default(0)
  result        String    @default("PENDING") // PENDING | MATCHED | NOT_FOUND | MISMATCH | ERROR | DISABLED
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  domain V3Domain @relation(fields: [domainId], references: [id], onDelete: Cascade)
  vendor Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@map("g4d_domain_verifications")
}

model V3Redirect {
  id        String   @id @default(cuid())
  vendorId  String
  fromHost  String
  fromPath  String   @default("/")
  toHost    String
  toPath    String   @default("/")
  status    Int      @default(301) // 301 | 302
  source    String   @default("SYSTEM") // SYSTEM | STAFF
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  vendor Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@unique([fromHost, fromPath])
  @@index([vendorId])
  @@map("g4d_redirects")
}

// ─── V3 slice 5.7: public directory, claim by phone OTP, removal links (additive). Directory objects carry the Directory prefix; nothing here is called a listing. ─────────────

enum V3DirectoryLocationKind {
  STATE
  DISTRICT
  CITY
}

enum V3DirectoryBusinessStatus {
  DRAFT
  UNCLAIMED
  CLAIMED
  SUSPENDED
  REMOVED
}

enum V3DirectoryPlacementKind {
  SPONSORED
}

enum V3OtpChannel {
  SMS
}

enum V3OtpStatus {
  PENDING
  VERIFIED
  EXPIRED
  LOCKED
  REVOKED
}

enum V3DirectoryRemovalStatus {
  REQUESTED
  APPROVED
  REJECTED
  EXECUTED
}

enum V3GrantStatus {
  ACTIVE
  USED
  EXPIRED
  REVOKED
}

model V3DirectoryLocation {
  id        String                  @id @default(cuid())
  parentId  String?
  parentKey String // = parentId, or "ROOT" for a state: lets the database keep slugs unique per parent (NULLs would not)
  kind      V3DirectoryLocationKind
  name      String
  slug      String
  sortOrder Int                     @default(0)
  proposed  Boolean                 @default(false) // seed rows wait for the owner's review
  active    Boolean                 @default(true)
  createdAt DateTime                @default(now())
  updatedAt DateTime                @updatedAt

  parent     V3DirectoryLocation?     @relation("DirectoryLocationTree", fields: [parentId], references: [id], onDelete: Restrict)
  children   V3DirectoryLocation[]    @relation("DirectoryLocationTree")
  businesses V3DirectoryBusiness[]

  @@unique([parentKey, slug])
  @@index([parentId])
  @@map("g4d_directory_locations")
}

model V3DirectoryCategory {
  id              String   @id @default(cuid())
  parentId        String?
  parentKey       String // = parentId, or "ROOT"
  name            String
  slug            String
  themeCategoryId String? // the theme kit category this maps to (for example "plumber")
  family          String? // the kit's family, for grouping
  sortOrder       Int      @default(0)
  proposed        Boolean  @default(false)
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  parent     V3DirectoryCategory?  @relation("DirectoryCategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children   V3DirectoryCategory[] @relation("DirectoryCategoryTree")
  businesses V3DirectoryBusiness[]

  @@unique([parentKey, slug])
  @@index([parentId])
  @@index([themeCategoryId])
  @@map("g4d_directory_categories")
}

model V3DirectoryBusiness {
  id              String                    @id @default(cuid())
  vendorId        String?                   @unique // set when the business is claimed (or created by provisioning)
  slug            String                    @unique
  name            String
  categoryId      String
  locationId      String?
  addressJson     Json                      @default("{}")
  phoneE164       String?
  emailMasked     String? // only a masked form is ever stored here; the clear address lives on the vendor
  hoursJson       Json                      @default("{}")
  geoJson         Json?
  descriptionText String                    @default("")
  status          V3DirectoryBusinessStatus @default(DRAFT)
  indexable       Boolean                   @default(false)
  source          String                    @default("STAFF") // STAFF | PROVISIONING | VENDOR | IMPORT
  claimedAt       DateTime?
  removedAt       DateTime?
  searchVector    Unsupported("tsvector")? // generated by the database from name and description (see the migration); never written by the application
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt

  vendor     Vendor?                         @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  category   V3DirectoryCategory             @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  location   V3DirectoryLocation?            @relation(fields: [locationId], references: [id], onDelete: Restrict)
  services   V3DirectoryBusinessService[]
  media      V3DirectoryBusinessMedia[]
  placements V3DirectoryPlacement[]
  removals   V3DirectoryRemovalRequest[]
  visitDays  V3DirectoryVisitDaily[]
  visitRefs  V3DirectoryVisitRef[]
  seededSite V3SeededSite?
  overrides  V3DirectoryClaimOverride[]

  @@index([status, indexable])
  @@index([categoryId])
  @@index([locationId])
  @@index([searchVector], type: Gin)
  @@map("g4d_directory_businesses")
}

model V3DirectoryBusinessService {
  id          String   @id @default(cuid())
  businessId  String
  name        String
  description String   @default("")
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  business V3DirectoryBusiness @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@map("g4d_directory_business_services")
}

model V3DirectoryBusinessMedia {
  id         String   @id @default(cuid())
  businessId String
  url        String
  kind       String   @default("IMAGE")
  altText    String   @default("")
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business V3DirectoryBusiness @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@map("g4d_directory_business_media")
}

model V3DirectoryPlacement {
  id               String                   @id @default(cuid())
  businessId       String
  kind             V3DirectoryPlacementKind @default(SPONSORED)
  startsAt         DateTime
  endsAt           DateTime
  label            String // required: a sponsored placement is always labelled
  createdByStaffId String?
  revokedAt        DateTime?
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt

  business V3DirectoryBusiness @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([startsAt, endsAt])
  @@map("g4d_directory_placements")
}

model V3OtpChallenge {
  id            String       @id @default(cuid())
  subjectType   String // CLAIM
  subjectId     String // the claim token id
  channel       V3OtpChannel @default(SMS)
  phoneHash     String // HMAC of the E.164 number: the number itself is not stored here
  codeHash      String // HMAC of the code with the per-row salt
  salt          String
  attempts      Int          @default(0)
  maxAttempts   Int          @default(5)
  expiresAt     DateTime
  usedAt        DateTime?
  requestIpHash String?
  status        V3OtpStatus  @default(PENDING)
  sandboxBody   String? // SANDBOX adapter only: the message is kept here instead of being sent. Always null in live mode.
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([phoneHash, createdAt])
  @@index([subjectType, subjectId, createdAt])
  @@index([requestIpHash, createdAt])
  @@map("g4d_otp_challenges")
}

model V3DirectoryRemovalRequest {
  id                      String                   @id @default(cuid())
  businessId              String
  tokenHash               String                   @unique
  status                  V3DirectoryRemovalStatus @default(REQUESTED)
  reason                  String?
  requesterContactMasked  String?
  confirmedAt             DateTime? // set when the link sent to the business contact on file is followed: proves the requester controls it
  handledByStaffId        String?
  handledAt               DateTime?
  executedAt              DateTime?
  expiresAt               DateTime
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt

  business V3DirectoryBusiness @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, status])
  @@map("g4d_directory_removal_requests")
}

model V3DirectoryClaimOverride {
  id                String    @id @default(cuid())
  businessId        String
  phoneE164         String
  phoneHash         String
  reason            String
  approvedByStaffId String
  revokedAt         DateTime?
  createdAt         DateTime  @default(now())

  business V3DirectoryBusiness @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@map("g4d_directory_claim_overrides")
}

model V3AccountSetupGrant {
  id        String        @id @default(cuid())
  vendorId  String
  tokenHash String        @unique
  status    V3GrantStatus @default(ACTIVE)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime      @default(now())

  vendor Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([vendorId])
  @@map("g4d_account_setup_grants")
}

// ─── V3 slice 5.1b: plan purchase and renewal (Razorpay TEST mode only; additive). Integer paise end to end; nothing here stores a card, bank or PAN detail. ─────────────────

enum V3PlanOrderStatus {
  CREATED
  PENDING_PAYMENT
  PAID
  FAILED
  EXPIRED
  CANCELLED
  REVIEW // money and order disagree (amount or currency), or a payment arrived for an expired order: staff decide; never activates by itself
}

enum V3PlanOrderKind {
  NEW
  RENEWAL
  UPGRADE
}

model V3PlanOrder {
  id                  String            @id @default(cuid())
  vendorId            String
  planId              String
  termMonths          Int
  kind                V3PlanOrderKind   @default(NEW)
  quoteJson           Json // the priceQuote snapshot (tax and discounts) the amount came from; later price edits never change it
  amountPaise         Int
  currency            String            @default("INR")
  status              V3PlanOrderStatus @default(CREATED)
  providerOrderId     String?           @unique
  idempotencyKey      String
  expiresAt           DateTime
  createdByType       String            @default("VENDOR") // VENDOR | STAFF
  createdById         String?
  paymentId           String? // the provider's payment id once paid
  paidAmountPaise     Int?
  paidAt              DateTime?
  source              String? // SELF (the provider paid it) | STAFF (marked paid offline)
  reason              String? // staff: why it was marked paid
  subscriptionId      String? // the subscription this payment created or extended
  refundRecordedPaise Int? // a RECORD only: no provider refund call is made in this slice
  refundNote          String?
  refundRecordedBy    String?
  refundRecordedAt    DateTime?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  vendor  Vendor          @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  plan    V3Plan          @relation(fields: [planId], references: [id], onDelete: Restrict)
  invoice V3PlanInvoice?

  @@unique([vendorId, idempotencyKey])
  @@index([vendorId, createdAt])
  @@index([status, expiresAt])
  @@map("g4d_plan_orders")
}

model V3PaymentEvent {
  id                  String   @id @default(cuid())
  provider            String   @default("razorpay")
  providerEventId     String   @unique // replay protection: the same event id is only ever processed once
  type                String
  payloadRedactedJson Json // contact, email and card-like fields are removed before storing
  signatureValid      Boolean
  orderId             String? // our order, when the event could be matched to one (no foreign key: events outlive anything)
  processedAt         DateTime?
  result              String? // PAID | DUPLICATE | IGNORED | REVIEW | NO_ORDER | BAD_SIGNATURE
  createdAt           DateTime @default(now())

  @@index([orderId])
  @@map("g4d_payment_events")
}

model V3PlanInvoice {
  id               String   @id @default(cuid())
  vendorId         String
  orderId          String   @unique
  invoiceNumber    String   @unique // gap-free per financial year, from g4d_invoice_counters under a lock
  financialYear    String // for example 2026-27
  issuedAt         DateTime
  snapshotJson     Json // seller and buyer details, plan, term, the money
  taxBreakdownJson Json
  createdAt        DateTime @default(now())

  vendor Vendor      @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  order  V3PlanOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([vendorId, issuedAt])
  @@map("g4d_plan_invoices")
}

model V3InvoiceCounter {
  financialYear String   @id
  lastNumber    Int      @default(0)
  updatedAt     DateTime @updatedAt

  @@map("g4d_invoice_counters")
}

model V3ReminderLog {
  id             String   @id @default(cuid())
  subscriptionId String
  daysBefore     Int
  endsAt         DateTime
  kind           String   @default("SENT") // SENT | SKIPPED (a larger offset passed while the cron was down; only the nearest one is sent)
  sentAt         DateTime @default(now())

  subscription V3PlanSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@unique([subscriptionId, daysBefore, endsAt])
  @@map("g4d_reminder_log")
}

// ─── V3 slice 5.11: AI Studio providers, usage and credits, prompts (additive). No model is called by any test; secrets are encrypted with the existing crypto helper. ─────────────

enum V3AiProviderKind {
  TEXT_LLM
}

enum V3AiProviderStatus {
  ACTIVE
  DISABLED
}

enum V3AiUsageStatus {
  RESERVED
  DONE
  FAILED
  REFUNDED
}

enum V3AiPromptStatus {
  DRAFT
  ACTIVE
  RETIRED
}

model V3AiProvider {
  id                String             @id @default(cuid())
  key               String             @unique // openai | anthropic: the providers the platform already uses
  kind              V3AiProviderKind   @default(TEXT_LLM)
  displayName       String
  status            V3AiProviderStatus @default(DISABLED)
  secretCipher      String? // AES-256-GCM, written by the platform settings crypto helper (PLATFORM_SETTINGS_KEY); write-only through the API
  secretIv          String?
  secretTag         String?
  secretLast4       String? // the only part of the secret that is ever shown
  model             String // the model name the staff member chose (nothing is assumed)
  settingsJson      Json               @default("{}")
  createdByStaffId  String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@map("g4d_ai_providers")
}

model V3AiUsage {
  id             String          @id @default(cuid())
  vendorId       String
  featureKey     String // site_copy | seo_suggestion | directory_description | review_reply
  providerKey    String // the provider key, or "mock"
  credits        Int
  inputTokens    Int             @default(0)
  outputTokens   Int             @default(0)
  idempotencyKey String
  status         V3AiUsageStatus @default(RESERVED)
  period         String // the calendar month (India time) the credits count in: 2026-11
  resultText     String? // the scanned suggestion, kept so a repeated request with the same key returns it instead of charging again
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  vendor Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@unique([vendorId, idempotencyKey])
  @@index([vendorId, period, status])
  @@map("g4d_ai_usage")
}

model V3AiPrompt {
  id               String           @id @default(cuid())
  key              String // the feature key
  version          Int
  template         String // the fixed instruction text; only the placeholders {{feature}}, {{maxChars}}, {{language}} are allowed
  status           V3AiPromptStatus @default(DRAFT)
  activeKey        String?          @unique // = key while ACTIVE: the database allows one ACTIVE version per key
  createdByStaffId String?
  createdAt        DateTime         @default(now())

  @@unique([key, version])
  @@map("g4d_ai_prompts")
}

model V3AiCreditGrant {
  id               String   @id @default(cuid())
  vendorId         String
  credits          Int
  reason           String
  grantedByStaffId String
  period           String // the month the extra credits count in
  createdAt        DateTime @default(now())

  vendor Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([vendorId, period])
  @@map("g4d_ai_credit_grants")
}

// ─── V3 batch 3 (B3.0b / slice 5.1d): a business whose site and listing were permanently removed (additive). The ONLY hide state: owner rule 9. ─────────────

enum V3SiteRemovalKind {
  VENDOR_REQUEST
  STAFF_EMPTY_LISTING
  SEEDED_REMOVAL
}

model V3SiteRemoval {
  vendorId    String            @id
  kind        V3SiteRemovalKind
  reason      String?
  phoneHash   String? // keyed hash of the phone on file; never the number
  requestedBy String? // vendor id, staff id or null for a public removal request
  removedAt   DateTime          @default(now())
  createdAt   DateTime          @default(now())

  vendor Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([removedAt])
  @@map("g4d_site_removals")
}

// ─── V3 batch 3 slice 5.1d: vendor-requested account deletion queue and the do-not-contact / removal register (additive) ───────────────────────────────────

enum V3DeletionRequestStatus {
  PENDING
  EXECUTED
  CANCELLED
}

model V3AccountDeletionRequest {
  id              String                  @id @default(cuid())
  vendorId        String
  status          V3DeletionRequestStatus @default(PENDING)
  pendingVendorId String?                 @unique // = vendorId while PENDING, null after: the database allows one open request per vendor
  requestedById   String? // the signed-in owner
  verifiedAt      DateTime // the fresh one-time code was entered at this time
  executedAt      DateTime?
  executedById    String?
  note            String?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  vendor Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([vendorId])
  @@map("g4d_account_deletion_requests")
}

/// Phone hashes of businesses that asked not to be contacted or listed. Rows are never deleted by any code path. Used by removals (5.1d) and seeded sites (5.13a).
model V3DncRegister {
  id        String   @id @default(cuid())
  phoneHash String   @unique // keyed hash of the E.164 number; never the number
  reason    String
  source    String   @default("REMOVAL") // REMOVAL | DO_NOT_CONTACT | STAFF
  addedBy   String?
  addedAt   DateTime @default(now())

  @@map("g4d_dnc_register")
}

// ─── V3 batch 3 slice 5.7b: directory visits (counts only, no personal data) and the short-lived attribution reference (additive) ──────────────────────────────────

/// One row per business per day. `count` = every Visit site click, `searchCount` = the ones that came from a search result. No visitor data of any kind.
model V3DirectoryVisitDaily {
  id          String   @id @default(cuid())
  businessId  String
  day         String // YYYY-MM-DD, UTC
  count       Int      @default(0)
  searchCount Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  business V3DirectoryBusiness @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, day])
  @@index([day])
  @@map("g4d_directory_visit_daily")
}

/// The opaque reference the Visit link appends (?src=dir&ref=...). Only a hash of it is stored. It expires and can attribute ONE later request.
model V3DirectoryVisitRef {
  id         String    @id @default(cuid())
  refHash    String    @unique
  businessId String
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime  @default(now())

  business V3DirectoryBusiness @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@map("g4d_directory_visit_refs")
}

// ─── V3 batch 3 slice 5.13a: seeded sites (promotion pages made from public facts for businesses that have not signed up) (additive) ───────────────────────────

enum V3SeededLifecycle {
  SEEDED
  INVITED
  CLAIMED_FREE
  PRO
  REMOVED
}

enum V3SeededSourceKind {
  PUBLIC_LISTING
  FIELD_VISIT
  PHONE_CALL
  REFERRAL
}

enum V3OutreachStatus {
  NOT_CONTACTED
  CALLED
  INTERESTED
  CLAIM_LINK_SENT
  CLAIMED
  DECLINED
  DO_NOT_CONTACT
}

enum V3OutreachKind {
  CALL
  NOTE
  CLAIM_LINK
  REMOVAL
}

enum V3SeededBatchMode {
  DRY_RUN
  APPLIED
}

/// One row per seeded business. The vendor is a shell with a placeholder login nobody can use until the owner claims the page; the directory profile is UNCLAIMED.
model V3SeededSite {
  id                    String             @id @default(cuid())
  vendorId              String             @unique
  directoryBusinessId   String?            @unique
  lifecycle             V3SeededLifecycle  @default(SEEDED)
  sourceKind            V3SeededSourceKind
  sourceNote            String?
  publicFactsConfirmed  Boolean // the staff checkbox: only public facts, no invented reviews, no copied photos or text. Required on every create.
  phoneHash             String // keyed hash of the E.164 number
  emailHash             String? // keyed hash of the public email, for duplicate detection only
  nameKey               String // normalised name plus city, for duplicate detection
  outreachStatus        V3OutreachStatus   @default(NOT_CONTACTED)
  outreachOwnerStaffId  String?
  lastContactAt         DateTime?
  nextFollowUpAt        DateTime?
  ownerAgreedToContact  Boolean            @default(false)
  ownerAgreedAt         DateTime?
  ownerAgreedBy         String?
  createdByStaffId      String?
  batchId               String?
  removedAt             DateTime?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  vendor   Vendor                @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  business V3DirectoryBusiness?  @relation(fields: [directoryBusinessId], references: [id], onDelete: SetNull)
  outreach V3SeededOutreachLog[]
  batch    V3SeededBatch?        @relation(fields: [batchId], references: [id], onDelete: SetNull)

  @@index([lifecycle])
  @@index([phoneHash])
  @@index([emailHash])
  @@index([nameKey])
  @@index([batchId])
  @@map("g4d_seeded_sites")
}

model V3SeededBatch {
  id           String            @id @default(cuid())
  createdBy    String?
  fileName     String
  rowsTotal    Int
  rowsCreated  Int               @default(0)
  rowsRejected Int               @default(0)
  mode         V3SeededBatchMode
  reportJson   Json              @default("{}")
  createdAt    DateTime          @default(now())

  sites V3SeededSite[]

  @@index([createdAt])
  @@map("g4d_seeded_batches")
}

model V3SeededOutreachLog {
  id           String         @id @default(cuid())
  seededSiteId String
  kind         V3OutreachKind
  at           DateTime       @default(now())
  staffId      String?
  outcome      String?
  note         String?

  site V3SeededSite @relation(fields: [seededSiteId], references: [id], onDelete: Cascade)

  @@index([seededSiteId, at])
  @@map("g4d_seeded_outreach_log")
}

// ─── V3 batch 3 slice 5.14: requests and orders bridge (additive). Get4Domain passes requests to the vendor; it never receives or holds a customer's money. ──────────

