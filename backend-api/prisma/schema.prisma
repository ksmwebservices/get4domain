// ── Track A: AI template library (2.2) — admin-created prebuilt AI designs that
// vendors browse and use as a starting point in AI Studio. Platform-level (not
// vendor-scoped); optionally industry-scoped. ─────────────────────────────────
model AiTemplate {
  id              String   @id @default(cuid())
  name            String
  contentType     String // social_post | festival_poster | blog | ad_creative | document | …
  industry        String? // null = all industries
  prompt          String // the base prompt/design brief the vendor starts from
  thumbnail       String? // preview image URL
  // AI Studio Redesign (17 Aug): one library, several template kinds. `source`
  // discriminates the row so the Content Library + AI Studio picker can show/
  // filter all types in one list. 'prompt' = the existing AI-generation flow;
  // 'canva' = a synced Canva Brand Template (Canva Integration dispatch, parked);
  // 'document' = a coded business-document layout; 'design' = an in-app editable
  // design template (Fabric.js scene in editorJson); 'reel' = a Remotion reel
  // template (slot/text/music config in videoConfig).
  source          String   @default("prompt") // prompt | canva | document | design | reel
  // Canva Integration: the Canva brand_template_id this row mirrors (source=canva).
  canvaTemplateId String?
  // Data-fill field definitions (cmsSchema-style) for canva/document templates —
  // an array of { key, label, type, required, maxLength?, prefillFrom? }. Lets the
  // AI Studio data-collection form render only what THIS template needs. Adopts the
  // Template-Driven CMS `cmsSchema` shape later without a rewrite.
  fields          Json?
  // Template Editor dispatch (17 Aug): Fabric.js scene JSON for source='design'
  // (the editable canvas — text boxes, image objects, shapes; placeholder objects
  // tagged with fieldKey). Stored here, not in a parallel table.
  editorJson      Json?
  // Remotion reel template config for source='reel' — { slots (image count), text
  // overlay spec, aspect, durationInFrames, fps, allowedTrackIds }.
  videoConfig     Json?
  active          Boolean  @default(true)
  createdBy       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([contentType])
  @@index([industry])
  @@index([source])
  @@map("g4d_ai_templates")
}

// ── Track A: website theme system (2.3) — one base theme per industry with
// CSS-variable-driven variations, so a theme swap is a variable swap not a fork.
// Admin-created; a vendor selects one (VendorCMS.themeId). Platform-level. ─────
model WebsiteTheme {
  id          String   @id @default(cuid())
  name        String
  // Short marketplace description shown on the vendor theme card.
  description String?
  industry    String? // null = works for any industry
  cssVars     Json // { "--primary": "#...", "--accent": "#...", "--radius": "..." }
  // Uploaded static-HTML theme (from Bolt / a designer). Multi-page: an array of
  // { slug, title, html } — home is the first entry (or slug "home"). Content is injected
  // at render via {{tokens}} bound to VendorCMS. `css` is optional shared CSS for all pages.
  // When `pages` is present the live site renders this raw HTML; else it uses `layout`
  // (data-driven section-kit) or a colours-only re-skin of the industry default.
  pages       Json?
  css         String?
  // Uploaded theme's JavaScript (runs in the isolated render iframe) + font stylesheet
  // hrefs to preserve (e.g. Google Fonts). Both optional/additive.
  js          String?
  fonts       Json?
  // Full data-driven template (engine WebsiteTemplate shape minus id/name/industry:
  // { theme, brandDefaults, choices, choiceLabel, nav, bottomNav, primaryCta, sections }).
  // When present, the vendor's live site renders THIS layout via the engine (no redeploy);
  // null = a colours-only theme applied over the industry default layout.
  layout      Json?
  // Premium templates: one-time unlock price in ₹ (rupees), ex-GST (null/0 = free/included).
  // Charged to Get4Domain's platform Razorpay (+18% GST); a paid unlock is a VendorTemplateUnlock.
  price       Int?
  preview     String? // preview image URL
  isDefault   Boolean  @default(false)
  active      Boolean  @default(true)
  createdBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([industry])
  @@map("g4d_website_themes")
}

// Per-vendor payment credentials. Each vendor collects public-site payments DIRECTLY
// into their OWN Razorpay account (Get4Domain never holds the funds), so the public
// checkout creates the order with these keys. The secret is encrypted at rest
// (platform-settings crypto.util) and never returned to the client.
model VendorPaymentConfig {
  id                String   @id @default(cuid())
  vendorId          String   @unique
  provider          String   @default("razorpay")
  razorpayKeyId     String?
  razorpayKeySecret String? // encrypted
  enabled           Boolean  @default(false)
  /// 'ONLINE' (vendor's own Razorpay) or 'ORDER_REQUEST' (order saved PENDING_PAYMENT, vendor confirms). null = legacy behaviour.
  checkoutMode      String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("g4d_vendor_payment_config")
}

// A vendor's one-time purchase (unlock) of a premium WebsiteTheme. Applying a priced
// template requires a row here; free templates need none.
model VendorTemplateUnlock {
  id          String   @id @default(cuid())
  vendorId    String
  themeId     String
  amountPaise Int      @default(0)
  paymentId   String?
  createdAt   DateTime @default(now())

  @@unique([vendorId, themeId])
  @@index([vendorId])
  @@map("g4d_vendor_template_unlock")
}

// ── Track B 2C: vendor expense entry (bookkeeping support). GST is EXCLUSIVE —
// `amount` is the taxable base, gstAmount = amount*gstRate/100, total = amount+gst
// (mirrors GenericInvoice + the invoice service). Rupee floats, vendorId-scoped. ──
model Expense {
  id            String   @id @default(cuid())
  vendorId      String
  vendor        Vendor   @relation(fields: [vendorId], references: [id])
  description   String
  category      String?
  amount        Float // taxable base (₹, exclusive of GST)
  gstRate       Float    @default(0) // 0 = not GST-claimable
  gstAmount     Float    @default(0)
  total         Float // amount + gstAmount
  paymentMethod String   @default("offline") // online | offline (cash)
  attachment    String? // receipt photo URL
  date          DateTime
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([vendorId])
  @@map("g4d_expenses")
}

// ── Track B 2D: office/stationery tracker (simple list, not procurement). ──────
model StationeryItem {
  id               String   @id @default(cuid())
  vendorId         String
  vendor           Vendor   @relation(fields: [vendorId], references: [id])
  name             String
  unit             String? // e.g. box, ream, pcs
  quantity         Float    @default(0)
  reorderThreshold Float? // low-stock marker (optional)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([vendorId])
  @@map("g4d_stationery")
}

// ── WhatsApp bot: vendor-managed knowledge base (Q&A). The bot answers from THESE
// first (keyword/pattern match); AI is only the fallback. Primary source of truth
// so answers use the vendor's real price/hours, not an AI guess. ───────────────
model KnowledgeBaseEntry {
  id        String   @id @default(cuid())
  vendorId  String
  vendor    Vendor   @relation(fields: [vendorId], references: [id])
  // Short label for the vendor's own reference (e.g. "Pricing", "Opening hours").
  question  String
  // Comma/space-separated trigger terms matched against the inbound message
  // (e.g. "price, cost, charges, rate"). Case-insensitive, word-boundary match.
  keywords  String
  // The exact answer the bot sends verbatim when this entry matches.
  answer    String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([vendorId])
  @@map("g4d_kb_entries")
}

// ── WhatsApp bot: per-customer conversation state + billing window. One row per
// (vendor, phone). Tracks the bot's state machine and the current billed session
// window so session messages are billed once per conversation, not per message. ─
model WhatsappConversation {
  id            String    @id @default(cuid())
  vendorId      String
  vendor        Vendor    @relation(fields: [vendorId], references: [id])
  contactId     String?
  contact       Contact?  @relation(fields: [contactId], references: [id])
  phone         String
  phoneNumberId String? // Fast2SMS phone_number_id (the vendor's WA number)
  // active = bot answering · awaiting_name = asked for name, waiting · agent =
  // handed off to a human, bot muted.
  state         String    @default("active")
  nameCaptured  Boolean   @default(false)
  leadId        String? // CampaignLead created once interest + name captured
  // Start of the current billed 24h session window (null until first billed send).
  windowStart   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([vendorId, phone])
  @@index([vendorId])
  @@map("g4d_wa_conversations")
}

// ─────────────────────────────────────────────────────────────────────────
// VENDOR APP — PHASE 4 OPERATIONS MODELS (dedicated, vendorId-scoped).
// Priority industries: clinic (Appointment), restaurant (PosTable/KitchenTicket/
// PosSale), retail (PosSale + CatalogItem.stock). Others reuse booking/generic
// per the inspection report and are BACKLOGGED (gym memberships/classes, hotel
// rooms/housekeeping, salon chairs) — not modelled here yet.
// ─────────────────────────────────────────────────────────────────────────

// Kanban task / process board (the reference's drag-drop is non-functional;
// here `stage` is real and persisted on move).
model VendorTask {
  id          String    @id @default(cuid())
  vendorId    String
  vendor      Vendor    @relation(fields: [vendorId], references: [id])
  title       String
  description String?
  stage       String    @default("new") // new | assigned | in-progress | review | completed
  priority    String    @default("medium") // low | medium | high | urgent
  assignee    String?
  segment     String?
  subtasks    Json? // [{ label: string, done: boolean }]
  dueDate     DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([vendorId])
  @@index([vendorId, stage])
  @@map("g4d_vendor_tasks")
}

// Restaurant floor/table map.
model PosTable {
  id         String   @id @default(cuid())
  vendorId   String
  vendor     Vendor   @relation(fields: [vendorId], references: [id])
  name       String // "T1"
  seats      Int      @default(2)
  status     String   @default("available") // available | occupied | reserved | cleaning
  orderTotal Float? // current open order total
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([vendorId])
  @@map("g4d_pos_tables")
}

// Kitchen order queue ("Send to Kitchen" creates one; staff see status update).
model KitchenTicket {
  id        String   @id @default(cuid())
  vendorId  String
  vendor    Vendor   @relation(fields: [vendorId], references: [id])
  tableName String?
  items     String // human-readable line list
  total     Float    @default(0)
  status    String   @default("preparing") // preparing | ready | overdue | served
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([vendorId])
  @@index([vendorId, status])
  @@map("g4d_kitchen_tickets")
}

// A completed POS sale (retail "Complete Sale" / food order). Line items are
// value objects on the sale; retail sales decrement CatalogItem.stock.
model PosSale {
  id            String   @id @default(cuid())
  vendorId      String
  vendor        Vendor   @relation(fields: [vendorId], references: [id])
  type          String   @default("retail") // retail | food
  items         Json // [{ catalogItemId?, name, qty, price }]
  subtotal      Float
  taxAmount     Float    @default(0)
  total         Float
  paymentMethod String   @default("cash") // cash | upi | card | bank
  status        String   @default("completed") // completed | refunded
  tableName     String?
  // Public web checkout: the Razorpay order/payment this sale was recorded for. The unique
  // payment id makes confirm idempotent (a captured request replayed cannot mint a second sale).
  razorpayOrderId   String?
  razorpayPaymentId String?  @unique
  // Handover 2026-10-08 — storefront order requests (no online payment): who ordered, where to deliver, and an
  // idempotency key so a double submit creates one order. status adds PENDING_PAYMENT and CANCELLED.
  customerName    String?
  customerPhone   String?
  customerEmail   String?
  deliveryAddress String?
  orderNote       String?
  orderSource     String?
  idempotencyKey  String?
  paidAt          DateTime?
  cancelledAt     DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([vendorId])
  @@index([vendorId, createdAt])
  @@unique([vendorId, idempotencyKey])
  @@map("g4d_pos_sales")
}

// Booking / appointment (clinic, salon, and any booking-mode industry).
model Appointment {
  id           String   @id @default(cuid())
  vendorId     String
  vendor       Vendor   @relation(fields: [vendorId], references: [id])
  contactId    String? // optional link to g4d_contacts (no FK — soft ref)
  customerName String
  phone        String?
  service      String?
  startAt      DateTime
  durationMin  Int      @default(30)
  status       String   @default("booked") // booked | completed | cancelled | no_show
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([vendorId])
  @@index([vendorId, startAt])
  @@map("g4d_appointments")
}

// Business payments ledger (Accounts → Payments tab).
model PaymentRecord {
  id        String   @id @default(cuid())
  vendorId  String
  vendor    Vendor   @relation(fields: [vendorId], references: [id])
  party     String
  method    String // upi | cash | card | cheque | bank
  direction String // inward | outward
  amount    Float
  reference String?
  status    String   @default("cleared") // cleared | pending | bounced
  date      DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([vendorId])
  @@index([vendorId, date])
  @@map("g4d_payment_records")
}

// GST return filing-status tracker (Accounts → GST tab).
model GstFiling {
  id        String    @id @default(cuid())
  vendorId  String
  vendor    Vendor    @relation(fields: [vendorId], references: [id])
  period    String // e.g. "2026-08"
  formType  String // GSTR-1 | GSTR-3B | GSTR-2B | Annual
  status    String    @default("pending") // pending | in_progress | filed | not_due
  dueDate   DateTime?
  filedAt   DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([vendorId, period, formType])
  @@index([vendorId])
  @@map("g4d_gst_filings")
}

// Domain registrations + connected (externally-owned) domains, per vendor.
// Registration is a real paid purchase charged to the vendor's wallet
// (dispatch 26-Aug-2026, Phase 2). Mapping status tracks DNS propagation before
// a domain is marked active.
model DomainRegistration {
  id                String    @id @default(cuid())
  vendorId          String
  vendor            Vendor    @relation(fields: [vendorId], references: [id])
  domainName        String // full sld.tld
  tld               String
  // registered = bought through Get4Domain; connected = vendor-owned, mapped only
  source            String    @default("registered")
  registrar         String    @default("resellerclub")
  registrarOrderId  String?
  // pending | registered | mapping_pending | active | failed | cancelled
  status            String    @default("pending")
  pricePaise        Int       @default(0) // amount charged to wallet (0 for connected)
  years             Int       @default(1)
  mappingType       String? // A | CNAME
  mappingVerifiedAt DateTime?
  expiresAt         DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@unique([vendorId, domainName])
  @@index([vendorId])
  @@index([vendorId, status])
  @@map("g4d_domain_registrations")
}

// ── Travel Operations (Phase 1) ──────────────────────────────────────────────
// Dedicated models, vendorId-scoped. Fleet + Driver are addon-gated in the UI
// (existing fleet/driver addon flags); Trips + Visa are core Travel features.
// Bookings stay on the shared Record model (untouched).
model Vehicle {
  id                  String               @id @default(cuid())
  vendorId            String
  vendor              Vendor               @relation(fields: [vendorId], references: [id])
  name                String
  type                String               @default("sedan") // sedan | suv | tempo | bus | other
  regNumber           String?
  capacity            Int                  @default(4)
  status              String               @default("available") // available | on_trip | maintenance
  notes               String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  trips               Trip[]
  contractAssignments ContractAssignment[]

  @@index([vendorId])
  @@map("g4d_vehicles")
}

model Driver {
  id                  String               @id @default(cuid())
  vendorId            String
  vendor              Vendor               @relation(fields: [vendorId], references: [id])
  name                String
  phone               String?
  licenseNo           String?
  status              String               @default("available") // available | on_trip | off_duty
  notes               String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  trips               Trip[]
  contractAssignments ContractAssignment[]

  @@index([vendorId])
  @@map("g4d_drivers")
}

model Trip {
  id          String            @id @default(cuid())
  vendorId    String
  vendor      Vendor            @relation(fields: [vendorId], references: [id])
  contactId   String? // soft ref to g4d_contacts (customer) — no FK
  title       String
  destination String?
  startDate   DateTime?
  endDate     DateTime?
  pax         Int               @default(1)
  status      String            @default("planning") // planning | confirmed | ongoing | completed | cancelled
  packageCost Float             @default(0) // supplier cost
  sellPrice   Float             @default(0) // price charged to customer (markup = sell - cost)
  itinerary   Json? // [{ day, title, detail }]
  vehicleId   String?
  vehicle     Vehicle?          @relation(fields: [vehicleId], references: [id])
  driverId    String?
  driver      Driver?           @relation(fields: [driverId], references: [id])
  notes       String?
  createdAt   DateTime          @default(now())
