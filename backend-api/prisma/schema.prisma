generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Vendor {
  id                     String       @id @default(cuid())
  name                   String
  email                  String       @unique
  password               String
  businessName           String
  phone                  String?
  industry               String?      @default("general")
  subdomain              String?      @unique
  widgetKey              String?      @unique // 3B: public per-vendor embeddable-widget key
  // WhatsApp-bot: the vendor's Fast2SMS phone_number_id, used to route an inbound
  // webhook to the correct tenant. Set by admin when provisioning the WA number.
  waPhoneNumberId        String?      @unique
  customDomain           String?
  // Per-vendor ResellerClub identity, created lazily on first domain registration
  // from the vendor's own business details. Domains register under these instead
  // of the shared default customer/contact once present.
  resellerClubCustomerId String?
  resellerClubContactId  String?
  role                   Role         @default(VENDOR)
  status                 VendorStatus @default(ACTIVE)
  // 3C: admin per-vendor override layered on the industry skin baseline (accent,
  // welcome text, website template). DB-driven, applied live, no redeploy.
  configOverride         Json?
  // Book-Demo Phase 4: a per-lead demo account, auto-expiring. Converts to a real
  // account at Phase 5 (buy-now). Filtered out of admin/real views.
  isSandbox              Boolean      @default(false)
  expiresAt              DateTime?
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt

  subscriptions Subscription[]
  invoices      Invoice[]
  tickets       SupportTicket[]
  cms           VendorCMS?
  products      VendorProduct[]
  categories    Category[]

  wallet        Wallet?
  walletTxns    WalletTransaction[]
  campaignPages CampaignPage[]
  campaignLeads CampaignLead[]
  teamMembers   TeamMember[]

  contacts        Contact[]
  catalogItems    CatalogItem[]
  records         Record[]
  genericInvoices GenericInvoice[]
  addons          VendorAddon[]
  modules         VendorModule[]
  messages        Message[]
  expenses        Expense[]
  stationery      StationeryItem[]
  kbEntries       KnowledgeBaseEntry[]
  waConversations WhatsappConversation[]
  commsSettings   VendorCommsSettings?

  // Vendor-app Phase 4 — operations models (dedicated, vendorId-scoped).
  vendorTasks    VendorTask[]
  posTables      PosTable[]
  kitchenTickets KitchenTicket[]
  posSales       PosSale[]
  appointments   Appointment[]
  paymentRecords PaymentRecord[]
  gstFilings     GstFiling[]
  domains        DomainRegistration[]

  // Travel Operations (Phase 1)
  vehicles         Vehicle[]
  drivers          Driver[]
  trips            Trip[]
  visaApplications VisaApplication[]
  contracts        Contract[]

  // Phase 2 — per-industry operations
  stylists            Stylist[]
  salonChairs         SalonChair[]
  salonAppointments   SalonAppointment[]
  gymClasses          GymClass[]
  memberships         Membership[]
  rooms               Room[]
  roomBookings        RoomBooking[]
  listings            Listing[]
  deals               Deal[]
  propertyVisits      PropertyVisit[]
  batches             Batch[]
  enrollments         StudentEnrollment[]
  engagements         Engagement[]
  engagementDocuments EngagementDocument[]

  // Phase 3 — per-industry operations
  constructionProjects ConstructionProject[]
  projectMilestones    ProjectMilestone[]
  projectMaterials     ProjectMaterial[]
  eventBookings        EventBooking[]
  eventVendors         EventVendorAssignment[]
  financeCases         FinanceCase[]
  financeCaseDocuments FinanceCaseDocument[]
  serviceJobs          ServiceJob[]
  jobLines             JobLine[]
  partStock            PartStock[]
  shipments            Shipment[]
  testOrders           TestOrder[]
  testOrderItems       TestOrderItem[]
  photoShoots          PhotoShoot[]
  shootDeliverables    ShootDeliverable[]
  produceOrders        ProduceOrder[]
  produceStock         ProduceStock[]
  coachingBatches      CoachingBatch[]
  coachingEnrollments  CoachingEnrollment[]
  coachingSessions     CoachingSession[]
  techProjects         TechProject[]
  projectTasks         ProjectTask[]
  doctors              Doctor[]
  clinicAppointments   ClinicAppointment[]
  restaurantOrders     RestaurantOrder[]
  restaurantOrderItems RestaurantOrderItem[]
  retailProducts       RetailProduct[]
  domainCampaignRecords DomainCampaignRecord[]

  // Commercial Engine v1
  billingTerms       BillingTerm[]
  specialArrangements SpecialArrangement[]
  billingDeals       BillingDeal[]
  planChangeRequests PlanChangeRequest[]
}

model Subscription {
  id        String    @id @default(cuid())
  vendorId  String
  vendor    Vendor    @relation(fields: [vendorId], references: [id])
  product   Product
  plan      Plan
  status    SubStatus @default(PENDING)
  startDate DateTime?
  endDate   DateTime?
  amount    Int
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  // Theme-change entitlement (dispatch 01-Oct-2026): Workspace = 2/year, BOS =
  // 4/year. themeChangesResetAt tracks the next reset (set to endDate at
  // creation/renewal); updateVendorCMS auto-resets the counter once that date
  // has passed rather than requiring a cron job.
  themeChangesUsed    Int       @default(0)
  themeChangesLimit   Int?
  themeChangesResetAt DateTime?

  invoices Invoice[]
}

model Invoice {
  id                String        @id @default(cuid())
  invoiceNumber     String        @unique
  vendorId          String
  vendor            Vendor        @relation(fields: [vendorId], references: [id])
  subscriptionId    String?
  subscription      Subscription? @relation(fields: [subscriptionId], references: [id])
  description       String
  amount            Int
  gstAmount         Int
  totalAmount       Int
  gstNumber         String?
  status            InvoiceStatus @default(PENDING)
  razorpayOrderId   String?
  razorpayPaymentId String?
  paidAt            DateTime?
  dueDate           DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  // ── COMMERCIAL ENGINE v1 (07-Oct-2026) — ADDITIVE ──────────────────────────────────────
  // All nullable/defaulted: legacy invoices (kind = null) keep their exact behaviour. amount /
  // gstAmount / totalAmount keep their meaning (taxable / GST / payable, paise); the fields
  // below describe how they were derived and how the invoice is paid. See docs/v2/COMMERCIAL_ENGINE.md.
  kind               InvoiceKind?
  dealId             String?
  deal               BillingDeal?    @relation(fields: [dealId], references: [id])
  termId             String? // BillingTerm this invoice activates / renews (soft ref)
  /// SHA-256 of the pay-link token. The token itself is never stored and never returned by any list API.
  payTokenHash       String?         @unique
  tokenExpiresAt     DateTime?
  allowedChannels    PayChannel[]    @default([])
  gstMode            GstMode         @default(EXCLUSIVE)
  listAmountPaise    Int? // subtotal before discount
  discountPaise      Int             @default(0)
  discountReason     String?
  adminDiscount      Boolean         @default(false) // an ad-hoc admin discount is baked in (blocks promo stacking)
  allowPromoStacking Boolean         @default(false)
  promoCodeId        String?
  allowPromoEntry    Boolean         @default(false)
  lineItems          Json? // [{ kind: PLAN|ADDON|CUSTOM|CREDIT, label, amountPaise, qty }]
  planKey            BillingPlanKey?
  billingCycle       BillingCycle?
  cycleMonths        Int?
  periodStart        DateTime?
  periodEnd          DateTime?
  paidPaise          Int             @default(0) // cumulative amount received (manual partials)
  overpaymentPaise   Int             @default(0)
  paidVia            PayChannel?
  sentAt             DateTime?
  voidedAt           DateTime?
  voidReason         String?
  effectsAppliedAt   DateTime? // idempotency marker for activation / renewal side effects
  /// Special arrangement (Release 1A): the GST this invoice WOULD have carried when it was issued with gstMode NONE, and the printed note. Null on every other invoice.
  gstForgonePaise    Int?
  gstNote            String?

  @@index([vendorId, status])
  @@index([kind, status])
}

model SupportTicket {
  id         String       @id @default(cuid())
  vendorId   String
  vendor     Vendor       @relation(fields: [vendorId], references: [id])
  category   String
  subject    String
  message    String
  status     TicketStatus @default(OPEN)
  adminReply String?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
}

model VendorCMS {
  id                String   @id @default(cuid())
  vendorId          String   @unique
  vendor            Vendor   @relation(fields: [vendorId], references: [id])
  businessName      String?
  tagline           String?
  about             String?
  logo              String?
  banner            String?
  favicon           String?
  themeId           String? // selected WebsiteTheme (2.3); null = industry default
  seoTitle          String?
  seoDesc           String?
  seoKeywords       String?
  phone             String?
  email             String?
  address           String?
  // Basic business hours shown on the site AND used to ground the WhatsApp bot's
  // answers (free text, e.g. "Mon–Sat 9am–8pm, Sun closed"). Additive/nullable.
  businessHours     String?
  whatsapp          String?
  facebook          String?
  instagram         String?
  linkedin          String?
  youtube           String?
  googleMaps        String?
  googleAnalyticsId String?
  // Lightweight categorized photo gallery (e.g. Ceremony/Portraits/Details/
  // Celebration for a photography vendor) - deliberately reuses VendorCMS rather
  // than a parallel product/model: [{id,src,alt,title,category,order}]. Additive/
  // nullable; a vendor's public site falls back to its own static showcase images
  // until this is populated via the dashboard.
  portfolio         Json?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model VendorProduct {
  id           String    @id @default(cuid())
  vendorId     String
  vendor       Vendor    @relation(fields: [vendorId], references: [id])
  name         String
  description  String?
  price        String?
  image        String?
  // `category` (free text) stays as the denormalized display name, kept in sync by
  // CmsService.findOrCreateCategory — every existing reader of this string column
  // (the public /cms/site/:subdomain response, every vendor site's own product
  // rendering) keeps working unchanged. `categoryId` is the real relational link,
  // added dispatch 24-Sep-2026 to fix a real gap: a same-named category typed twice
  // used to create two disconnected free-text values with nothing tying them
  // together. Nullable so pre-existing rows without a resolvable category don't break.
  category     String?
  categoryId   String?
  categoryRef  Category? @relation(fields: [categoryId], references: [id])
  // Rich per-category listing fields (area/config/type for real estate, course/diet
  // for restaurant, duration/department for healthcare, …). Shape driven by
  // listing-fields.ts on the frontend. Additive/nullable — no data migration needed.
  customFields Json?
  active       Boolean   @default(true)

  // ── UNIVERSAL CATALOGUE (dispatch 03-Oct-2026) — ADDITIVE ONLY ──────────────────────
  // VendorProduct is evolving into the single catalogue table for every industry
  // (CatalogItem + RetailProduct are folded in by scripts/catalogue-migration/, both old
  // tables stay untouched). Every column below is nullable or defaulted, so every existing
  // reader/writer keeps working unchanged. See docs/v2/UNIVERSAL_CATALOGUE_MODEL.md.
  /// Discriminator = Vendor.industry at write time (engine id: retail, clinic, realestate…).
  /// Industry-specific attributes (sizes/colors, specialization, sqft/bedrooms, duration/
  /// inclusions…) stay in `customFields`; this says which shape that JSON follows.
  industryType String?
  /// Typed numeric price. `price` (String) stays as the DISPLAY value ("On Request", "from ₹500").
  priceAmount  Float?
  /// Selling unit: kg, session, night, month…
  unit         String?
  /// Promoted from RetailProduct — applies to any physical or inventory-tracked item.
  sku          String?
  /// null = stock not tracked (CatalogItem.stock semantics); a number = tracked.
  stockQty     Int?
  /// Handover 2026-10-08: true = stockQty is authoritative (orders reserve it, adjustments move it). false = stock not tracked.
  trackStock   Boolean   @default(false)
  reorderLevel Int?
  /// BOS item master (additive): HSN/SAC code, GST rate % (null = vendor default), purchase price in rupees (drives cost of goods sold).
  hsn          String?
  gstRate      Float?
  purchasePriceAmount Float?
  /// active | inactive | draft | archived | out_of_stock. `active` (Boolean) remains what
  /// live readers filter on until the separate cutover dispatch; migrated rows carry
  /// active=false + their real state here, so copying never surfaces anything new.
  status       String    @default("active")
  /// Primary Operation Registry action for THIS item (appointment, booking, cart, enquiry…).
  /// null = inherit IndustryExperience.primaryOperation for the vendor's industry.
  operationKey String?
  operation    OperationType? @relation(fields: [operationKey], references: [key], onDelete: SetNull)
  /// Provenance of rows copied in by the data migration: 'catalog_item' | 'retail_product'.
  /// (id is preserved from the source row, so Record.catalogItemId / PosSale lines stay valid.)
  sourceModel  String?
  sourceId     String?

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([categoryId])
  @@index([vendorId, status])
  @@index([vendorId, industryType])
  @@index([vendorId, sku])
  @@unique([sourceModel, sourceId])
  stockMovements StockMovement[]
}

/// A vendor's own product category — dispatch 24-Sep-2026, fixes a real gap:
/// VendorProduct.category was (and remains, for backward compat) a bare free-text
/// column with no dedicated taxonomy, so a vendor dashboard entering a same-named
/// category twice silently created two disconnected values. Scoped per-vendor (not
/// global) since different vendors' "Sneakers" are unrelated categories; uniqueness is
/// case-insensitive via `nameNormalized` (Postgres @unique is case-sensitive) so
/// "Sneakers" and "sneakers" resolve to the SAME row — see CmsService.
/// findOrCreateCategory, the single place a category name ever gets created.
model Category {
  id             String          @id @default(cuid())
  vendorId       String
  vendor         Vendor          @relation(fields: [vendorId], references: [id])
  industry       String
  name           String
  nameNormalized String
  /// Handover 2026-10-08: dashboard ordering and visibility of the storefront filter list.
  sortOrder      Int             @default(0)
  hidden         Boolean         @default(false)
  products       VendorProduct[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@unique([vendorId, nameNormalized])
  @@index([vendorId])
  @@map("g4d_categories")
}

model PlatformCMS {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

model Lead {
  id             String        @id @default(cuid())
  name           String
  phone          String
  email          String?
  business       String
  industry       String
  interest       String
  message        String?
  status         String        @default("pending")
  // Lead origin: "demo" = Book-Demo funnel (Phase 1 OTP-verified), else campaign/etc.
  source         String?
  // Preferred demo slot chosen by the visitor in the Book-a-Demo wizard.
  preferredDate  DateTime?
  preferredSlot  String?
  // TeleCRM fields (admin marketing team works these enquiries).
  notes          String?
  assignedTo     String?
  followUpDate   DateTime?
  callLogs       LeadCallLog[]
  // Demo-visit tracking (additive, on the same OTP-gate lead — dispatch 28-Aug-2026).
  // demoCategory = the FIRST main category this phone viewed; the visitor is scoped
  // to it (sub-categories within it are free). demoVisitKeys = comma-separated distinct
  // "category" / "category/sub" keys already viewed; demoVisitCount = their count. After
  // 3 distinct visits the 4th is redirected to a warm-lead sales page, not another demo.
  demoCategory   String?
  demoVisitKeys  String?
  demoVisitCount Int           @default(0)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@map("g4d_leads")
}

// Call activity logged against a demo-booking Lead by the admin marketing team.
// Mirrors CallLog (which is bound to vendor CampaignLead) but for platform leads.
model LeadCallLog {
  id         String    @id @default(cuid())
  leadId     String
  lead       Lead      @relation(fields: [leadId], references: [id])
  calledBy   String?
  duration   Int?
  outcome    String?
  notes      String?
  aiSummary  String?
  followUpAt DateTime?
  createdAt  DateTime  @default(now())

  @@map("g4d_lead_call_logs")
}

model Wallet {
  id            String              @id @default(cuid())
  vendorId      String              @unique
  vendor        Vendor              @relation(fields: [vendorId], references: [id])
  balance       Int                 @default(0)
  totalCredited Int                 @default(0)
  totalDebited  Int                 @default(0)
  updatedAt     DateTime            @updatedAt
  transactions  WalletTransaction[]

  @@map("g4d_wallets")
}

model WalletTransaction {
  id           String    @id @default(cuid())
  vendorId     String
  vendor       Vendor    @relation(fields: [vendorId], references: [id])
  walletId     String
  wallet       Wallet    @relation(fields: [walletId], references: [id])
  type         String
  amount       Int
  description  String
  service      String
  balanceAfter Int
  expiresAt    DateTime?
  razorpayId   String?   @unique
  createdAt    DateTime  @default(now())

  @@map("g4d_wallet_transactions")
}

model CampaignPage {
  id           String         @id @default(cuid())
  vendorId     String
  vendor       Vendor         @relation(fields: [vendorId], references: [id])
  slug         String         @unique
  title        String
  headline     String
  subheadline  String?
  benefits     Json
  aboutText    String?
  heroImage    String?
  photos       Json?
  style        String         @default("LIGHT")
  phone        String
  whatsapp     String
  email        String?
  address      String?
  mapsLink     String?
  testimonials Json?
  ctaText      String         @default("Enquire Now")
  active       Boolean        @default(true)
  views        Int            @default(0)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  leads        CampaignLead[]

  @@map("g4d_campaign_pages")
}

model CampaignLead {
  id             String        @id @default(cuid())
  campaignPageId String?
  campaignPage   CampaignPage? @relation(fields: [campaignPageId], references: [id])
  vendorId       String
  vendor         Vendor        @relation(fields: [vendorId], references: [id])
  name           String
  phone          String
  message        String?
  source         String?
  status         String        @default("new")
  customFields   Json? // industry-specific contact fields (config-driven form)
  notes          String?
  assignedTo     String?
  followUpDate   DateTime?
  // Optional link to the Contact whose Message history is this lead's conversation
  // transcript (e.g. WhatsApp-bot leads). Lets TeleCRM surface the full chat.
  contactId      String?
  contact        Contact?      @relation(fields: [contactId], references: [id])
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  callLogs       CallLog[]

  @@map("g4d_campaign_leads")
}

model CallLog {
  id         String       @id @default(cuid())
  leadId     String
  lead       CampaignLead @relation(fields: [leadId], references: [id])
  vendorId   String
  calledBy   String
  duration   Int?
  outcome    String?
  notes      String?
  aiSummary  String?
  followUpAt DateTime?
  createdAt  DateTime     @default(now())

  @@map("g4d_call_logs")
}

model Campaign {
  id          String    @id @default(cuid())
  vendorId    String
  name        String
  description String?
  status      String    @default("draft")
  channels    Json
  content     Json
  walletCost  Int       @default(0)
  startDate   DateTime?
  endDate     DateTime?
  analytics   Json?
  approvedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("g4d_campaigns")
}

model TeamMember {
  id          String    @id @default(cuid())
  vendorId    String
  vendor      Vendor    @relation(fields: [vendorId], references: [id])
  name        String
  email       String?
  phone       String?
  role        String
  department  String? // 3D: Sales | Support | Accounts | Marketing — prefills module access
  modules     Json
  status      String    @default("active")
  inviteToken String?
  password    String?
  lastLogin   DateTime?
  createdAt   DateTime  @default(now())

  @@map("g4d_team_members")
}

model Notification {
  id             String   @id @default(cuid())
  recipientId    String
  recipientType  String
  type           String
  priority       String   @default("INFO")
  title          String
  message        String
  data           Json?
  read           Boolean  @default(false)
  actionRequired Boolean  @default(false)
  actionType     String?
  actionData     Json?
  createdAt      DateTime @default(now())

  @@map("g4d_notifications")
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  userType  String
  endpoint  String
  p256dh    String
  auth      String
  device    String
  createdAt DateTime @default(now())

  @@map("g4d_push_subscriptions")
}

model PlatformIncome {
  id          String   @id @default(cuid())
  vendorId    String
  invoiceId   String?
  amount      Int
  source      String
  description String?
  createdAt   DateTime @default(now())

  @@map("g4d_platform_income")
}

// ===========================================================================
// DomainApp v2.0 core — shared, generic backend engine for ALL industries.
// One set of tables stores data for every industry; the frontend tailors the
// experience per industry via the industry config system. Multi-tenant: every
// row is scoped by vendorId.
// ===========================================================================

model Contact {
  id              String                 @id @default(cuid())
  vendorId        String
  vendor          Vendor                 @relation(fields: [vendorId], references: [id])
  name            String
  phone           String
  email           String?
  type            String                 @default("customer")
  address         String?
  portalAccess    Boolean                @default(false)
  customFields    Json?
  tags            Json?
  notes           String?
  /// BOS party fields (additive): GSTIN, place-of-supply state, shipping address, opening balance (paise; customer: they owe us, supplier: we owe them).
  gstin           String?
  state           String?
  shippingAddress String?
  openingBalancePaise Int                @default(0)
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  records         Record[]
  invoices        GenericInvoice[]
  messages        Message[]
  campaignLeads   CampaignLead[]
  waConversations WhatsappConversation[]
  contracts       Contract[]

  @@index([vendorId])
  @@map("g4d_contacts")
}

// Communication Hub message history (Phase: real unified inbox). Outbound messages
// are persisted on send; inbound would be captured by provider webhooks (future).
model Message {
  id                String   @id @default(cuid())
  vendorId          String
  vendor            Vendor   @relation(fields: [vendorId], references: [id])
  contactId         String?
  contact           Contact? @relation(fields: [contactId], references: [id])
  channel           String // whatsapp | email | sms
  direction         String   @default("out") // out | in
  subject           String?
  body              String
  status            String   @default("sent") // sent | mock | failed | received
  providerMessageId String?
  createdAt         DateTime @default(now())

  @@index([vendorId])
  @@index([contactId])
  @@map("g4d_messages")
}

model CatalogItem {
  id           String   @id @default(cuid())
  vendorId     String
  vendor       Vendor   @relation(fields: [vendorId], references: [id])
  name         String
  description  String?
  price        Float
  unit         String?
  image        String?
  active       Boolean  @default(true)
  // Vendor-app Phase 4 — optional live stock for retail POS decrement (nullable
  // = untracked; only industries that manage inventory set it).
  stock        Int?
  customFields Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  records      Record[]

  @@index([vendorId])
  @@map("g4d_catalog_items")
}

model Record {
  id            String          @id @default(cuid())
  vendorId      String
  vendor        Vendor          @relation(fields: [vendorId], references: [id])
  contactId     String?
  contact       Contact?        @relation(fields: [contactId], references: [id])
  catalogItemId String?
  catalogItem   CatalogItem?    @relation(fields: [catalogItemId], references: [id])
  status        String          @default("draft")
  date          DateTime
  amount        Float           @default(0)
  notes         String?
  customFields  Json?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  invoice       GenericInvoice?

  @@index([vendorId])
  @@index([status])
  @@map("g4d_records")
}

// Generic DomainApp invoice (distinct from the subscription `Invoice` model).
model GenericInvoice {
  id             String    @id @default(cuid())
  vendorId       String
  vendor         Vendor    @relation(fields: [vendorId], references: [id])
  recordId       String?   @unique
  record         Record?   @relation(fields: [recordId], references: [id])
  contactId      String
  contact        Contact   @relation(fields: [contactId], references: [id])
  invoiceNumber  String    @unique
  items          Json
  subtotal       Float
  gstRate        Float     @default(0)
  gstAmount      Float     @default(0)
  total          Float
  status         String    @default("PENDING")
  dueDate        DateTime?
  paidAt         DateTime?
  razorpayLinkId String?
  pdfUrl         String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([vendorId])
  @@map("g4d_generic_invoices")
}

model VendorAddon {
  id        String   @id @default(cuid())
  vendorId  String
  vendor    Vendor   @relation(fields: [vendorId], references: [id])
  addonKey  String
  enabled   Boolean  @default(true)
  enabledAt DateTime @default(now())
  config    Json?

  @@unique([vendorId, addonKey])
  @@map("g4d_vendor_addons")
}

model VendorModule {
  id        String   @id @default(cuid())
  vendorId  String
  vendor    Vendor   @relation(fields: [vendorId], references: [id])
  moduleKey String
  enabled   Boolean  @default(true)
  enabledAt DateTime @default(now())

  @@unique([vendorId, moduleKey])
  @@map("g4d_vendor_modules")
}

model PlatformSetting {
