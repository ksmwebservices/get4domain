generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Vendor {
  id                     String       @id @default(cuid())
  name                   String
  email                  String       @unique
  password               String
  businessName           String
  phone                  String?
  industry               String?      @default("general")
  subdomain              String?      @unique
  widgetKey              String?      @unique // 3B: public per-vendor embeddable-widget key
  // WhatsApp-bot: the vendor's Fast2SMS phone_number_id, used to route an inbound
  // webhook to the correct tenant. Set by admin when provisioning the WA number.
  waPhoneNumberId        String?      @unique
  customDomain           String?
  // Per-vendor ResellerClub identity, created lazily on first domain registration
  // from the vendor's own business details. Domains register under these instead
  // of the shared default customer/contact once present.
  resellerClubCustomerId String?
  resellerClubContactId  String?
  role                   Role         @default(VENDOR)
  status                 VendorStatus @default(ACTIVE)
  // 3C: admin per-vendor override layered on the industry skin baseline (accent,
  // welcome text, website template). DB-driven, applied live, no redeploy.
  configOverride         Json?
  // Book-Demo Phase 4: a per-lead demo account, auto-expiring. Converts to a real
  // account at Phase 5 (buy-now). Filtered out of admin/real views.
  isSandbox              Boolean      @default(false)
  expiresAt              DateTime?
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt

  subscriptions Subscription[]
  invoices      Invoice[]
  tickets       SupportTicket[]
  cms           VendorCMS?
  products      VendorProduct[]

  wallet        Wallet?
  walletTxns    WalletTransaction[]
  campaignPages CampaignPage[]
  campaignLeads CampaignLead[]
  teamMembers   TeamMember[]

  contacts        Contact[]
  catalogItems    CatalogItem[]
  records         Record[]
  genericInvoices GenericInvoice[]
  addons          VendorAddon[]
  modules         VendorModule[]
  messages        Message[]
  expenses        Expense[]
  stationery      StationeryItem[]
  kbEntries       KnowledgeBaseEntry[]
  waConversations WhatsappConversation[]
  commsSettings   VendorCommsSettings?

  // Vendor-app Phase 4 — operations models (dedicated, vendorId-scoped).
  vendorTasks    VendorTask[]
  posTables      PosTable[]
  kitchenTickets KitchenTicket[]
  posSales       PosSale[]
  appointments   Appointment[]
  paymentRecords PaymentRecord[]
  gstFilings     GstFiling[]
  domains        DomainRegistration[]

  // Travel Operations (Phase 1)
  vehicles         Vehicle[]
  drivers          Driver[]
  trips            Trip[]
  visaApplications VisaApplication[]
  contracts        Contract[]

  // Phase 2 — per-industry operations
  stylists            Stylist[]
  salonChairs         SalonChair[]
  salonAppointments   SalonAppointment[]
  gymClasses          GymClass[]
  memberships         Membership[]
  rooms               Room[]
  roomBookings        RoomBooking[]
  listings            Listing[]
  deals               Deal[]
  propertyVisits      PropertyVisit[]
  batches             Batch[]
  enrollments         StudentEnrollment[]
  engagements         Engagement[]
  engagementDocuments EngagementDocument[]

  // Phase 3 — per-industry operations
  constructionProjects ConstructionProject[]
  projectMilestones    ProjectMilestone[]
  projectMaterials     ProjectMaterial[]
  eventBookings        EventBooking[]
  eventVendors         EventVendorAssignment[]
  financeCases         FinanceCase[]
  financeCaseDocuments FinanceCaseDocument[]
  serviceJobs          ServiceJob[]
  jobLines             JobLine[]
  partStock            PartStock[]
  shipments            Shipment[]
  testOrders           TestOrder[]
  testOrderItems       TestOrderItem[]
}

model Subscription {
  id        String    @id @default(cuid())
  vendorId  String
  vendor    Vendor    @relation(fields: [vendorId], references: [id])
  product   Product
  plan      Plan
  status    SubStatus @default(PENDING)
  startDate DateTime?
  endDate   DateTime?
  amount    Int
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  invoices Invoice[]
}

model Invoice {
  id                String        @id @default(cuid())
  invoiceNumber     String        @unique
  vendorId          String
  vendor            Vendor        @relation(fields: [vendorId], references: [id])
  subscriptionId    String?
  subscription      Subscription? @relation(fields: [subscriptionId], references: [id])
  description       String
  amount            Int
  gstAmount         Int
  totalAmount       Int
  gstNumber         String?
  status            InvoiceStatus @default(PENDING)
  razorpayOrderId   String?
  razorpayPaymentId String?
  paidAt            DateTime?
  dueDate           DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
}

model SupportTicket {
  id         String       @id @default(cuid())
  vendorId   String
  vendor     Vendor       @relation(fields: [vendorId], references: [id])
  category   String
  subject    String
  message    String
  status     TicketStatus @default(OPEN)
  adminReply String?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
}

model VendorCMS {
  id                String   @id @default(cuid())
  vendorId          String   @unique
  vendor            Vendor   @relation(fields: [vendorId], references: [id])
  businessName      String?
  tagline           String?
  about             String?
  logo              String?
  banner            String?
  favicon           String?
  themeId           String? // selected WebsiteTheme (2.3); null = industry default
  seoTitle          String?
  seoDesc           String?
  seoKeywords       String?
  phone             String?
  email             String?
  address           String?
  // Basic business hours shown on the site AND used to ground the WhatsApp bot's
  // answers (free text, e.g. "Mon–Sat 9am–8pm, Sun closed"). Additive/nullable.
  businessHours     String?
  whatsapp          String?
  facebook          String?
  instagram         String?
  linkedin          String?
  youtube           String?
  googleMaps        String?
  googleAnalyticsId String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model VendorProduct {
  id           String   @id @default(cuid())
  vendorId     String
  vendor       Vendor   @relation(fields: [vendorId], references: [id])
  name         String
  description  String?
  price        String?
  image        String?
  category     String?
  // Rich per-category listing fields (area/config/type for real estate, course/diet
  // for restaurant, duration/department for healthcare, …). Shape driven by
  // listing-fields.ts on the frontend. Additive/nullable — no data migration needed.
  customFields Json?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model PlatformCMS {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

model Lead {
  id            String        @id @default(cuid())
  name          String
  phone         String
  email         String?
  business      String
  industry      String
  interest      String
  message       String?
  status        String        @default("pending")
  // Lead origin: "demo" = Book-Demo funnel (Phase 1 OTP-verified), else campaign/etc.
  source        String?
  // Preferred demo slot chosen by the visitor in the Book-a-Demo wizard.
  preferredDate DateTime?
  preferredSlot String?
  // TeleCRM fields (admin marketing team works these enquiries).
  notes         String?
  assignedTo    String?
  followUpDate  DateTime?
  callLogs      LeadCallLog[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@map("g4d_leads")
}

// Call activity logged against a demo-booking Lead by the admin marketing team.
// Mirrors CallLog (which is bound to vendor CampaignLead) but for platform leads.
model LeadCallLog {
  id         String    @id @default(cuid())
  leadId     String
  lead       Lead      @relation(fields: [leadId], references: [id])
  calledBy   String?
  duration   Int?
  outcome    String?
  notes      String?
  aiSummary  String?
  followUpAt DateTime?
  createdAt  DateTime  @default(now())

  @@map("g4d_lead_call_logs")
}

model Wallet {
  id            String              @id @default(cuid())
  vendorId      String              @unique
  vendor        Vendor              @relation(fields: [vendorId], references: [id])
  balance       Int                 @default(0)
  totalCredited Int                 @default(0)
  totalDebited  Int                 @default(0)
  updatedAt     DateTime            @updatedAt
  transactions  WalletTransaction[]

  @@map("g4d_wallets")
}

model WalletTransaction {
  id           String    @id @default(cuid())
  vendorId     String
  vendor       Vendor    @relation(fields: [vendorId], references: [id])
  walletId     String
  wallet       Wallet    @relation(fields: [walletId], references: [id])
  type         String
  amount       Int
  description  String
  service      String
  balanceAfter Int
  expiresAt    DateTime?
  razorpayId   String?
  createdAt    DateTime  @default(now())

  @@map("g4d_wallet_transactions")
}

model CampaignPage {
  id           String         @id @default(cuid())
  vendorId     String
  vendor       Vendor         @relation(fields: [vendorId], references: [id])
  slug         String         @unique
  title        String
  headline     String
  subheadline  String?
  benefits     Json
  aboutText    String?
  heroImage    String?
  photos       Json?
  style        String         @default("LIGHT")
  phone        String
  whatsapp     String
  email        String?
  address      String?
  mapsLink     String?
  testimonials Json?
  ctaText      String         @default("Enquire Now")
  active       Boolean        @default(true)
  views        Int            @default(0)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  leads        CampaignLead[]

  @@map("g4d_campaign_pages")
}

model CampaignLead {
  id             String        @id @default(cuid())
  campaignPageId String?
  campaignPage   CampaignPage? @relation(fields: [campaignPageId], references: [id])
  vendorId       String
  vendor         Vendor        @relation(fields: [vendorId], references: [id])
  name           String
  phone          String
  message        String?
  source         String?
  status         String        @default("new")
  customFields   Json? // industry-specific contact fields (config-driven form)
  notes          String?
  assignedTo     String?
  followUpDate   DateTime?
  // Optional link to the Contact whose Message history is this lead's conversation
  // transcript (e.g. WhatsApp-bot leads). Lets TeleCRM surface the full chat.
  contactId      String?
  contact        Contact?      @relation(fields: [contactId], references: [id])
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  callLogs       CallLog[]

  @@map("g4d_campaign_leads")
}

model CallLog {
  id         String       @id @default(cuid())
  leadId     String
  lead       CampaignLead @relation(fields: [leadId], references: [id])
  vendorId   String
  calledBy   String
  duration   Int?
  outcome    String?
  notes      String?
  aiSummary  String?
  followUpAt DateTime?
  createdAt  DateTime     @default(now())

  @@map("g4d_call_logs")
}

model Campaign {
  id          String    @id @default(cuid())
  vendorId    String
  name        String
  description String?
  status      String    @default("draft")
  channels    Json
  content     Json
  walletCost  Int       @default(0)
  startDate   DateTime?
  endDate     DateTime?
  analytics   Json?
  approvedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("g4d_campaigns")
}

model TeamMember {
  id          String    @id @default(cuid())
  vendorId    String
  vendor      Vendor    @relation(fields: [vendorId], references: [id])
  name        String
  email       String?
  phone       String?
  role        String
  department  String? // 3D: Sales | Support | Accounts | Marketing — prefills module access
  modules     Json
  status      String    @default("active")
  inviteToken String?
  password    String?
  lastLogin   DateTime?
  createdAt   DateTime  @default(now())

  @@map("g4d_team_members")
}

model Notification {
  id             String   @id @default(cuid())
  recipientId    String
  recipientType  String
  type           String
  priority       String   @default("INFO")
  title          String
  message        String
  data           Json?
  read           Boolean  @default(false)
  actionRequired Boolean  @default(false)
  actionType     String?
  actionData     Json?
  createdAt      DateTime @default(now())

  @@map("g4d_notifications")
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  userType  String
  endpoint  String
  p256dh    String
  auth      String
  device    String
  createdAt DateTime @default(now())

  @@map("g4d_push_subscriptions")
}

model PlatformIncome {
  id          String   @id @default(cuid())
  vendorId    String
  invoiceId   String?
  amount      Int
  source      String
  description String?
  createdAt   DateTime @default(now())

  @@map("g4d_platform_income")
}

// ===========================================================================
// DomainApp v2.0 core — shared, generic backend engine for ALL industries.
// One set of tables stores data for every industry; the frontend tailors the
// experience per industry via the industry config system. Multi-tenant: every
// row is scoped by vendorId.
// ===========================================================================

model Contact {
  id              String                 @id @default(cuid())
  vendorId        String
  vendor          Vendor                 @relation(fields: [vendorId], references: [id])
  name            String
  phone           String
  email           String?
  type            String                 @default("customer")
  address         String?
  portalAccess    Boolean                @default(false)
  customFields    Json?
  tags            Json?
  notes           String?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  records         Record[]
  invoices        GenericInvoice[]
  messages        Message[]
  campaignLeads   CampaignLead[]
  waConversations WhatsappConversation[]
  contracts       Contract[]

  @@index([vendorId])
  @@map("g4d_contacts")
}

// Communication Hub message history (Phase: real unified inbox). Outbound messages
// are persisted on send; inbound would be captured by provider webhooks (future).
model Message {
  id                String   @id @default(cuid())
  vendorId          String
  vendor            Vendor   @relation(fields: [vendorId], references: [id])
  contactId         String?
  contact           Contact? @relation(fields: [contactId], references: [id])
  channel           String // whatsapp | email | sms
  direction         String   @default("out") // out | in
  subject           String?
  body              String
  status            String   @default("sent") // sent | mock | failed | received
  providerMessageId String?
  createdAt         DateTime @default(now())

  @@index([vendorId])
  @@index([contactId])
  @@map("g4d_messages")
}

model CatalogItem {
  id           String   @id @default(cuid())
  vendorId     String
  vendor       Vendor   @relation(fields: [vendorId], references: [id])
  name         String
  description  String?
  price        Float
  unit         String?
  image        String?
  active       Boolean  @default(true)
  // Vendor-app Phase 4 — optional live stock for retail POS decrement (nullable
  // = untracked; only industries that manage inventory set it).
  stock        Int?
  customFields Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  records      Record[]

  @@index([vendorId])
  @@map("g4d_catalog_items")
}

model Record {
  id            String          @id @default(cuid())
  vendorId      String
  vendor        Vendor          @relation(fields: [vendorId], references: [id])
  contactId     String?
  contact       Contact?        @relation(fields: [contactId], references: [id])
  catalogItemId String?
  catalogItem   CatalogItem?    @relation(fields: [catalogItemId], references: [id])
  status        String          @default("draft")
  date          DateTime
  amount        Float           @default(0)
  notes         String?
  customFields  Json?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  invoice       GenericInvoice?

  @@index([vendorId])
  @@index([status])
  @@map("g4d_records")
}

// Generic DomainApp invoice (distinct from the subscription `Invoice` model).
model GenericInvoice {
  id             String    @id @default(cuid())
  vendorId       String
  vendor         Vendor    @relation(fields: [vendorId], references: [id])
  recordId       String?   @unique
  record         Record?   @relation(fields: [recordId], references: [id])
  contactId      String
  contact        Contact   @relation(fields: [contactId], references: [id])
  invoiceNumber  String    @unique
  items          Json
  subtotal       Float
  gstRate        Float     @default(0)
  gstAmount      Float     @default(0)
  total          Float
  status         String    @default("PENDING")
  dueDate        DateTime?
  paidAt         DateTime?
  razorpayLinkId String?
  pdfUrl         String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([vendorId])
  @@map("g4d_generic_invoices")
}

model VendorAddon {
  id        String   @id @default(cuid())
  vendorId  String
  vendor    Vendor   @relation(fields: [vendorId], references: [id])
  addonKey  String
  enabled   Boolean  @default(true)
  enabledAt DateTime @default(now())
  config    Json?

  @@unique([vendorId, addonKey])
  @@map("g4d_vendor_addons")
}

model VendorModule {
  id        String   @id @default(cuid())
  vendorId  String
  vendor    Vendor   @relation(fields: [vendorId], references: [id])
  moduleKey String
  enabled   Boolean  @default(true)
  enabledAt DateTime @default(now())

  @@unique([vendorId, moduleKey])
  @@map("g4d_vendor_modules")
}

model PlatformSetting {
  id        String   @id @default(cuid())
  category  String
  key       String
  value     String
  encrypted Boolean  @default(true)
  status    String   @default("NOT_CONFIGURED")
  updatedAt DateTime @updatedAt
  updatedBy String?

  @@unique([category, key])
  @@map("g4d_platform_settings")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  VENDOR
}

// Quotes sent by the admin marketing team to existing vendors or new prospects.
model Quote {
  id            String   @id @default(cuid())
  vendorId      String? // set when quoting an existing vendor
  prospectName  String
  prospectPhone String?
  prospectEmail String?
  quoteType     String // domainapp_plan | domaincampaign_wallet | custom
  itemLabel     String // human label of what is being quoted
  amount        Int // in paise
  notes         String?
  channel       String // email | whatsapp | sms
  status        String   @default("sent") // sent | viewed | accepted
  sentBy        String? // admin email/id that sent it
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("g4d_quotes")
}

// Get4Domain's OWN internal staff roles (distinct from vendor Role above).
enum AdminRole {
  SUPER_ADMIN
  MARKETING
  OPERATIONS
}

// Internal Get4Domain team members (marketing / operations staff). Mirrors the
// vendor-side TeamMember in spirit but is scoped to the platform, not a vendor.
// The bootstrap admin@get4domain.com stays a Vendor(role=SUPER_ADMIN); invited
// staff live here and authenticate as admin_member principals (see auth).
model AdminTeamMember {
  id          String    @id @default(cuid())
  name        String
  email       String    @unique
  phone       String?
  role        AdminRole @default(OPERATIONS)
  status      String    @default("invited") // invited | active | removed
  inviteToken String?
  password    String?
  lastLogin   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("g4d_admin_team_members")
}

enum VendorStatus {
  ACTIVE
  SUSPENDED
  PENDING
}

enum Product {
  DOMAIN_APP
  DOMAIN_CAMPAIGN
  BOTH
}

enum Plan {
  STARTUP
  ENTERPRISE
  STARTER
  BUSINESS
}

enum SubStatus {
  PENDING
  ACTIVE
  EXPIRED
  CANCELLED
}

enum InvoiceStatus {
  PENDING
  PAID
  OVERDUE
  CANCELLED
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

// ── Track A: AI template library (2.2) — admin-created prebuilt AI designs that
// vendors browse and use as a starting point in AI Studio. Platform-level (not
// vendor-scoped); optionally industry-scoped. ─────────────────────────────────
model AiTemplate {
  id              String   @id @default(cuid())
  name            String
  contentType     String // social_post | festival_poster | blog | ad_creative | document | …
  industry        String? // null = all industries
  prompt          String // the base prompt/design brief the vendor starts from
  thumbnail       String? // preview image URL
  // AI Studio Redesign (17 Aug): one library, several template kinds. `source`
  // discriminates the row so the Content Library + AI Studio picker can show/
  // filter all types in one list. 'prompt' = the existing AI-generation flow;
  // 'canva' = a synced Canva Brand Template (Canva Integration dispatch, parked);
  // 'document' = a coded business-document layout; 'design' = an in-app editable
  // design template (Fabric.js scene in editorJson); 'reel' = a Remotion reel
  // template (slot/text/music config in videoConfig).
  source          String   @default("prompt") // prompt | canva | document | design | reel
  // Canva Integration: the Canva brand_template_id this row mirrors (source=canva).
  canvaTemplateId String?
  // Data-fill field definitions (cmsSchema-style) for canva/document templates —
  // an array of { key, label, type, required, maxLength?, prefillFrom? }. Lets the
  // AI Studio data-collection form render only what THIS template needs. Adopts the
  // Template-Driven CMS `cmsSchema` shape later without a rewrite.
  fields          Json?
  // Template Editor dispatch (17 Aug): Fabric.js scene JSON for source='design'
  // (the editable canvas — text boxes, image objects, shapes; placeholder objects
  // tagged with fieldKey). Stored here, not in a parallel table.
  editorJson      Json?
  // Remotion reel template config for source='reel' — { slots (image count), text
  // overlay spec, aspect, durationInFrames, fps, allowedTrackIds }.
  videoConfig     Json?
  active          Boolean  @default(true)
  createdBy       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([contentType])
  @@index([industry])
  @@index([source])
  @@map("g4d_ai_templates")
}

// ── Track A: website theme system (2.3) — one base theme per industry with
// CSS-variable-driven variations, so a theme swap is a variable swap not a fork.
// Admin-created; a vendor selects one (VendorCMS.themeId). Platform-level. ─────
model WebsiteTheme {
  id        String   @id @default(cuid())
  name      String
  industry  String? // null = works for any industry
  cssVars   Json // { "--primary": "#...", "--accent": "#...", "--radius": "..." }
  preview   String? // preview image URL
  isDefault Boolean  @default(false)
  active    Boolean  @default(true)
  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([industry])
  @@map("g4d_website_themes")
}

// ── Track B 2C: vendor expense entry (bookkeeping support). GST is EXCLUSIVE —
// `amount` is the taxable base, gstAmount = amount*gstRate/100, total = amount+gst
// (mirrors GenericInvoice + the invoice service). Rupee floats, vendorId-scoped. ──
model Expense {
  id            String   @id @default(cuid())
  vendorId      String
  vendor        Vendor   @relation(fields: [vendorId], references: [id])
  description   String
  category      String?
  amount        Float // taxable base (₹, exclusive of GST)
  gstRate       Float    @default(0) // 0 = not GST-claimable
  gstAmount     Float    @default(0)
  total         Float // amount + gstAmount
  paymentMethod String   @default("offline") // online | offline (cash)
  attachment    String? // receipt photo URL
  date          DateTime
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([vendorId])
  @@map("g4d_expenses")
}

// ── Track B 2D: office/stationery tracker (simple list, not procurement). ──────
model StationeryItem {
  id               String   @id @default(cuid())
  vendorId         String
  vendor           Vendor   @relation(fields: [vendorId], references: [id])
  name             String
  unit             String? // e.g. box, ream, pcs
  quantity         Float    @default(0)
  reorderThreshold Float? // low-stock marker (optional)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([vendorId])
  @@map("g4d_stationery")
}

// ── WhatsApp bot: vendor-managed knowledge base (Q&A). The bot answers from THESE
// first (keyword/pattern match); AI is only the fallback. Primary source of truth
// so answers use the vendor's real price/hours, not an AI guess. ───────────────
model KnowledgeBaseEntry {
  id        String   @id @default(cuid())
  vendorId  String
  vendor    Vendor   @relation(fields: [vendorId], references: [id])
  // Short label for the vendor's own reference (e.g. "Pricing", "Opening hours").
  question  String
  // Comma/space-separated trigger terms matched against the inbound message
  // (e.g. "price, cost, charges, rate"). Case-insensitive, word-boundary match.
  keywords  String
  // The exact answer the bot sends verbatim when this entry matches.
  answer    String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([vendorId])
  @@map("g4d_kb_entries")
}

// ── WhatsApp bot: per-customer conversation state + billing window. One row per
// (vendor, phone). Tracks the bot's state machine and the current billed session
// window so session messages are billed once per conversation, not per message. ─
model WhatsappConversation {
  id            String    @id @default(cuid())
  vendorId      String
  vendor        Vendor    @relation(fields: [vendorId], references: [id])
  contactId     String?
  contact       Contact?  @relation(fields: [contactId], references: [id])
  phone         String
  phoneNumberId String? // Fast2SMS phone_number_id (the vendor's WA number)
  // active = bot answering · awaiting_name = asked for name, waiting · agent =
  // handed off to a human, bot muted.
  state         String    @default("active")
  nameCaptured  Boolean   @default(false)
  leadId        String? // CampaignLead created once interest + name captured
  // Start of the current billed 24h session window (null until first billed send).
  windowStart   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([vendorId, phone])
  @@index([vendorId])
  @@map("g4d_wa_conversations")
}

// ─────────────────────────────────────────────────────────────────────────
// VENDOR APP — PHASE 4 OPERATIONS MODELS (dedicated, vendorId-scoped).
// Priority industries: clinic (Appointment), restaurant (PosTable/KitchenTicket/
// PosSale), retail (PosSale + CatalogItem.stock). Others reuse booking/generic
// per the inspection report and are BACKLOGGED (gym memberships/classes, hotel
// rooms/housekeeping, salon chairs) — not modelled here yet.
// ─────────────────────────────────────────────────────────────────────────

// Kanban task / process board (the reference's drag-drop is non-functional;
// here `stage` is real and persisted on move).
model VendorTask {
  id          String    @id @default(cuid())
  vendorId    String
  vendor      Vendor    @relation(fields: [vendorId], references: [id])
  title       String
  description String?
  stage       String    @default("new") // new | assigned | in-progress | review | completed
  priority    String    @default("medium") // low | medium | high | urgent
  assignee    String?
  segment     String?
  subtasks    Json? // [{ label: string, done: boolean }]
  dueDate     DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([vendorId])
  @@index([vendorId, stage])
  @@map("g4d_vendor_tasks")
}

// Restaurant floor/table map.
model PosTable {
  id         String   @id @default(cuid())
  vendorId   String
  vendor     Vendor   @relation(fields: [vendorId], references: [id])
  name       String // "T1"
  seats      Int      @default(2)
  status     String   @default("available") // available | occupied | reserved | cleaning
  orderTotal Float? // current open order total
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([vendorId])
  @@map("g4d_pos_tables")
}

// Kitchen order queue ("Send to Kitchen" creates one; staff see status update).
model KitchenTicket {
  id        String   @id @default(cuid())
  vendorId  String
  vendor    Vendor   @relation(fields: [vendorId], references: [id])
  tableName String?
  items     String // human-readable line list
  total     Float    @default(0)
  status    String   @default("preparing") // preparing | ready | overdue | served
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([vendorId])
  @@index([vendorId, status])
  @@map("g4d_kitchen_tickets")
}

// A completed POS sale (retail "Complete Sale" / food order). Line items are
// value objects on the sale; retail sales decrement CatalogItem.stock.
model PosSale {
  id            String   @id @default(cuid())
  vendorId      String
  vendor        Vendor   @relation(fields: [vendorId], references: [id])
  type          String   @default("retail") // retail | food
  items         Json // [{ catalogItemId?, name, qty, price }]
  subtotal      Float
  taxAmount     Float    @default(0)
  total         Float
  paymentMethod String   @default("cash") // cash | upi | card | bank
  status        String   @default("completed") // completed | refunded
  tableName     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([vendorId])
  @@index([vendorId, createdAt])
  @@map("g4d_pos_sales")
}

// Booking / appointment (clinic, salon, and any booking-mode industry).
model Appointment {
  id           String   @id @default(cuid())
  vendorId     String
