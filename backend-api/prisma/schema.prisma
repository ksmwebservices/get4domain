  id        String   @id @default(cuid())
  vendorId  String
  vendor    Vendor   @relation(fields: [vendorId], references: [id])
  projectId String?
  name      String
  unit      String?
  quantity  Float    @default(0)
  unitCost  Float    @default(0)
  supplier  String?
  status    String   @default("ordered") // ordered | received | used
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([vendorId])
  @@map("g4d_project_materials")
}

// ── Phase 3 — Events & Wedding: booking + vendor coordination ──
model EventBooking {
  id           String                  @id @default(cuid())
  vendorId     String
  vendor       Vendor                  @relation(fields: [vendorId], references: [id])
  title        String
  clientName   String
  contactId    String?
  eventType    String                  @default("Wedding")
  eventDate    DateTime?
  venue        String?
  guestCount   Int                     @default(0)
  status       String                  @default("enquiry")
  packageValue Float                   @default(0)
  advancePaid  Float                   @default(0)
  notes        String?
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt
  vendors      EventVendorAssignment[]

  @@index([vendorId])
  @@index([vendorId, status])
  @@map("g4d_event_bookings")
}

model EventVendorAssignment {
  id           String       @id @default(cuid())
  vendorId     String
  vendor       Vendor       @relation(fields: [vendorId], references: [id])
  bookingId    String
  booking      EventBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  vendorName   String
  service      String       @default("Catering")
  contactPhone String?
  cost         Float        @default(0)
  status       String       @default("pending")
  notes        String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([vendorId])
  @@index([bookingId])
  @@map("g4d_event_vendors")
}

// ── Phase 3 — Finance & Consulting: case tracking + per-type doc checklist ──
model FinanceCase {
  id             String                @id @default(cuid())
  vendorId       String
  vendor         Vendor                @relation(fields: [vendorId], references: [id])
  title          String
  clientName     String
  contactId      String?
  caseType       String                @default("ITR") // ITR | GST | Audit | Loan | Insurance | Other
  status         String                @default("open") // open | in_review | filed | closed | cancelled
  feeValue       Float                 @default(0)
  filingDeadline DateTime?
  assignedTo     String?
  notes          String?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  documents      FinanceCaseDocument[]

  @@index([vendorId])
  @@index([vendorId, status])
  @@map("g4d_finance_cases")
}

model FinanceCaseDocument {
  id         String      @id @default(cuid())
  vendorId   String
  vendor     Vendor      @relation(fields: [vendorId], references: [id])
  caseId     String
  case       FinanceCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  name       String
  required   Boolean     @default(true)
  status     String      @default("pending") // pending | received | waived
  receivedAt DateTime?
  notes      String?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@index([vendorId])
  @@index([caseId])
  @@map("g4d_finance_case_docs")
}

// ── Phase 3 — Automobile Service: service-job + parts/labor, parts inventory ──
model ServiceJob {
  id             String    @id @default(cuid())
  vendorId       String
  vendor         Vendor    @relation(fields: [vendorId], references: [id])
  vehicleNumber  String
  vehicleModel   String?
  customerName   String
  contactId      String?
  jobType        String    @default("General Service") // General Service | Repair | Body Work | Insurance | Other
  status         String    @default("received") // received | in_service | ready | delivered | cancelled
  odometer       Int?
  complaint      String?
  estimateAmount Float     @default(0)
  receivedDate   DateTime  @default(now())
  promisedDate   DateTime?
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  lines          JobLine[]

  @@index([vendorId])
  @@index([vendorId, status])
  @@map("g4d_service_jobs")
}

model JobLine {
  id          String     @id @default(cuid())
  vendorId    String
  vendor      Vendor     @relation(fields: [vendorId], references: [id])
  jobId       String
  job         ServiceJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  kind        String     @default("labor") // part | labor
  description String
  quantity    Float      @default(1)
  rate        Float      @default(0)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([vendorId])
  @@index([jobId])
  @@map("g4d_job_lines")
}

model PartStock {
  id           String   @id @default(cuid())
  vendorId     String
  vendor       Vendor   @relation(fields: [vendorId], references: [id])
  name         String
  partNumber   String?
  quantity     Int      @default(0)
  reorderLevel Int      @default(5)
  unitPrice    Float    @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([vendorId])
  @@map("g4d_part_stock")
}

// ── Phase 3 — Logistics & Transport: shipment tracking ──
model Shipment {
  id              String    @id @default(cuid())
  vendorId        String
  vendor          Vendor    @relation(fields: [vendorId], references: [id])
  trackingNo      String
  clientName      String
  contactId       String?
  origin          String
  destination     String
  mode            String    @default("Road") // Road | Rail | Air | Sea
  weight          Float? // kg
  status          String    @default("booked") // booked | picked_up | in_transit | delivered | cancelled
  freightAmount   Float     @default(0)
  pickupDate      DateTime?
  eta             DateTime?
  deliveredAt     DateTime?
  assignedVehicle String?
  assignedDriver  String?
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([vendorId])
  @@index([vendorId, status])
  @@map("g4d_shipments")
}

// ── Phase 3 — Diagnostics & Lab: test-order + report tracking ──
model TestOrder {
  id              String          @id @default(cuid())
  vendorId        String
  vendor          Vendor          @relation(fields: [vendorId], references: [id])
  patientName     String
  contactId       String?
  referringDoctor String?
  status          String          @default("booked") // booked | sample_collected | processing | report_ready | cancelled
  amount          Float           @default(0)
  sampleId        String?
  testDate        DateTime?
  collectedAt     DateTime?
  reportReadyAt   DateTime?
  reportUrl       String?
  notes           String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  items           TestOrderItem[]

  @@index([vendorId])
  @@index([vendorId, status])
  @@map("g4d_test_orders")
}

model TestOrderItem {
  id         String    @id @default(cuid())
  vendorId   String
  vendor     Vendor    @relation(fields: [vendorId], references: [id])
  orderId    String
  order      TestOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  testName   String
  sampleType String    @default("Blood") // Blood | Urine | Imaging | Swab | Other
  price      Float     @default(0)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([vendorId])
  @@index([orderId])
  @@map("g4d_test_order_items")
}
