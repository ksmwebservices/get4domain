  @@map("g4d_platform_settings")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  VENDOR
}

// Quotes sent by the admin marketing team to existing vendors or new prospects.
model Quote {
  id            String   @id @default(cuid())
  vendorId      String? // set when quoting an existing vendor
  // Soft ref to a Lead (g4d_leads) this quote was built against — e.g. a Managed
  // Services enquiry. Nullable/no relation: the existing single-item Send-Quote
  // flow never sets this, only the newer multi-item proposal flow does.
  leadId        String?
  prospectName  String
  prospectPhone String?
  prospectEmail String?
  quoteType     String // domainapp_plan | domaincampaign_wallet | custom
  itemLabel     String // human label of what is being quoted
  amount        Int // in paise — total across all items when `items` is set
  notes         String?
  channel       String // email | whatsapp | sms
  status        String   @default("sent") // draft | sent | viewed | accepted | declined
  sentBy        String? // admin email/id that sent it
  // Multi-line proposal items (ProposalLineItem[] below) — set by the Managed
  // Services quoting tool. Null for the original single-item quote flow, which
  // keeps using itemLabel/amount directly.
  items         Json?
  // Random token for the optional public share link (GET /quotes/public/:token).
  shareToken    String?  @unique
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("g4d_quotes")
}

// Editable rate card for the Managed Services quoting tool — KSM's team edits
// these defaults; a specific quote's line items (Quote.items Json) are a frozen
// copy at quote-creation time, so changing a rate here never alters an already
// -sent quote.
model ManagedServiceCatalogItem {
  id          String   @id @default(cuid())
  label       String // e.g. "Custom Web Application"
  description String?
  defaultRate Int // in paise — admin-editable placeholder, not real pricing until KSM sets it
  unit        String? // free text, e.g. "one-time", "per month", "per project"
  active      Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("g4d_managed_service_catalog_items")
}

// DomainCampaign (dispatch 01-Oct-2026): one row per vendor per billing month,
// the manually-recorded ad spend that drives that month's fee. Client status
// itself is a Subscription row with product: DOMAIN_CAMPAIGN (that enum value
// already existed, unused, before this model) — this table only holds the
// month-by-month spend/fee history, since the fee varies monthly and a single
// Subscription.amount can't represent that.
model DomainCampaignRecord {
  id           String   @id @default(cuid())
  vendorId     String
  vendor       Vendor   @relation(fields: [vendorId], references: [id])
  month        String // "2026-10" (YYYY-MM)
  adSpendPaise Int // manually recorded — no live Meta/Google Ads API tracking yet
  feePaise     Int // bracket fee for adSpendPaise (PRD §88), or the admin-entered custom fee when isCustomFee
  isCustomFee  Boolean  @default(false) // Enterprise/multi-brand: admin-entered fee overrides the bracket
  invoiceId    String? // set once a monthly invoice has been generated for this record
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([vendorId, month])
  @@map("g4d_domain_campaign_records")
}

// Get4Domain's OWN internal staff roles (distinct from vendor Role above).
enum AdminRole {
  SUPER_ADMIN
  MARKETING
  OPERATIONS
}

// Internal Get4Domain team members (marketing / operations staff). Mirrors the
// vendor-side TeamMember in spirit but is scoped to the platform, not a vendor.
// The bootstrap admin@get4domain.com stays a Vendor(role=SUPER_ADMIN); invited
// staff live here and authenticate as admin_member principals (see auth).
model AdminTeamMember {
  id          String    @id @default(cuid())
  name        String
  email       String    @unique
  phone       String?
  role        AdminRole @default(OPERATIONS)
  status      String    @default("invited") // invited | active | removed
  inviteToken String?
  password    String?
  passwordChangedAt DateTime? // S13: sessions issued before this are refused
  lastLogin   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("g4d_admin_team_members")
}

/// S13: a single-use, short-lived password-reset token. Only the SHA-256 of the token is stored. accountType = VENDOR | ADMIN_MEMBER | TEAM_MEMBER.
/// Append-only security ledger (no updatedAt/deletedAt on purpose): rows are kept so a replayed token is still recognised as used.
model AccountPasswordReset {
  id          String    @id @default(cuid())
  accountType String
  accountId   String
  tokenHash   String    @unique
  expiresAt   DateTime
  usedAt      DateTime?
  revokedAt   DateTime?
  requestedIp String?
  createdAt   DateTime  @default(now())

  @@index([accountType, accountId, createdAt])
  @@map("g4d_password_resets")
}

/// S13: a rotating refresh token. Only the SHA-256 is stored. Every use marks the row used and issues the next one in the same family;
/// presenting a used token again (theft/replay) revokes the whole family. Same append-only ledger rule as AccountPasswordReset.
model AuthRefreshToken {
  id           String    @id @default(cuid())
  accountType  String
  accountId    String
  familyId     String
  tokenHash    String    @unique
  expiresAt    DateTime
  usedAt       DateTime?
  revokedAt    DateTime?
  replacedById String?
  userAgent    String?
  createdAt    DateTime  @default(now())

  @@index([accountType, accountId])
  @@index([familyId])
  @@map("g4d_refresh_tokens")
}

enum VendorStatus {
  ACTIVE
  SUSPENDED
  PENDING
}

enum Product {
  DOMAIN_APP
  DOMAIN_CAMPAIGN
  BOTH
}

enum Plan {
  STARTUP
  ENTERPRISE
  STARTER
  BUSINESS
}

