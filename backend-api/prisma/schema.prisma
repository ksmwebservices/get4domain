generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Vendor {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  password     String
  businessName String
  phone        String?
  industry     String?  @default("general")
  subdomain    String?  @unique
  customDomain String?
  role         Role     @default(VENDOR)
  status       VendorStatus @default(ACTIVE)
  // Book-Demo Phase 4: a per-lead demo account, auto-expiring. Converts to a real
  // account at Phase 5 (buy-now). Filtered out of admin/real views.
  isSandbox    Boolean  @default(false)
  expiresAt    DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  subscriptions Subscription[]
  invoices      Invoice[]
  tickets       SupportTicket[]
  cms           VendorCMS?
  products      VendorProduct[]

  wallet           Wallet?
  walletTxns       WalletTransaction[]
  campaignPages    CampaignPage[]
  campaignLeads    CampaignLead[]
  teamMembers      TeamMember[]

  contacts         Contact[]
  catalogItems     CatalogItem[]
  records          Record[]
  genericInvoices  GenericInvoice[]
  addons           VendorAddon[]
  modules          VendorModule[]
  messages         Message[]
}

model Subscription {
  id         String   @id @default(cuid())
  vendorId   String
  vendor     Vendor   @relation(fields: [vendorId], references: [id])
  product    Product
  plan       Plan
  status     SubStatus @default(PENDING)
  startDate  DateTime?
  endDate    DateTime?
  amount     Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  invoices   Invoice[]
}

model Invoice {
  id             String   @id @default(cuid())
  invoiceNumber  String   @unique
  vendorId       String
  vendor         Vendor   @relation(fields: [vendorId], references: [id])
  subscriptionId String?
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id])
  description    String
  amount         Int
  gstAmount      Int
  totalAmount    Int
  gstNumber      String?
  status         InvoiceStatus @default(PENDING)
  razorpayOrderId String?
  razorpayPaymentId String?
  paidAt         DateTime?
  dueDate        DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model SupportTicket {
  id        String   @id @default(cuid())
  vendorId  String
  vendor    Vendor   @relation(fields: [vendorId], references: [id])
  category  String
  subject   String
  message   String
  status    TicketStatus @default(OPEN)
  adminReply String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VendorCMS {
  id           String   @id @default(cuid())
  vendorId     String   @unique
  vendor       Vendor   @relation(fields: [vendorId], references: [id])
  businessName String?
  tagline      String?
  about        String?
  logo         String?
  favicon      String?
  seoTitle     String?
  seoDesc      String?
  seoKeywords  String?
  phone        String?
  email        String?
  address      String?
  whatsapp     String?
  facebook     String?
  instagram    String?
  linkedin     String?
  youtube      String?
  googleMaps   String?
  googleAnalyticsId String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model VendorProduct {
  id          String   @id @default(cuid())
  vendorId    String
  vendor      Vendor   @relation(fields: [vendorId], references: [id])
  name        String
  description String?
  price       String?
  image       String?
  category    String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model PlatformCMS {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String
  updatedAt   DateTime @updatedAt
}

model Lead {
  id           String        @id @default(cuid())
  name         String
  phone        String
  email        String?
  business     String
  industry     String
  interest     String
  message      String?
  status       String        @default("pending")
  // Lead origin: "demo" = Book-Demo funnel (Phase 1 OTP-verified), else campaign/etc.
  source       String?
  // Preferred demo slot chosen by the visitor in the Book-a-Demo wizard.
  preferredDate DateTime?
  preferredSlot String?
  // TeleCRM fields (admin marketing team works these enquiries).
  notes        String?
  assignedTo   String?
  followUpDate DateTime?
  callLogs     LeadCallLog[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  @@map("g4d_leads")
}

// Call activity logged against a demo-booking Lead by the admin marketing team.
// Mirrors CallLog (which is bound to vendor CampaignLead) but for platform leads.
model LeadCallLog {
  id         String    @id @default(cuid())
  leadId     String
  lead       Lead      @relation(fields: [leadId], references: [id])
  calledBy   String?
  duration   Int?
  outcome    String?
  notes      String?
  aiSummary  String?
  followUpAt DateTime?
  createdAt  DateTime  @default(now())
  @@map("g4d_lead_call_logs")
}

model Wallet {
  id            String              @id @default(cuid())
  vendorId      String              @unique
  vendor        Vendor              @relation(fields: [vendorId], references: [id])
  balance       Int                 @default(0)
  totalCredited Int                 @default(0)
  totalDebited  Int                 @default(0)
  updatedAt     DateTime            @updatedAt
  transactions  WalletTransaction[]
  @@map("g4d_wallets")
}

model WalletTransaction {
  id           String    @id @default(cuid())
  vendorId     String
  vendor       Vendor    @relation(fields: [vendorId], references: [id])
  walletId     String
  wallet       Wallet    @relation(fields: [walletId], references: [id])
  type         String
  amount       Int
  description  String
  service      String
  balanceAfter Int
  expiresAt    DateTime?
  razorpayId   String?
  createdAt    DateTime  @default(now())
  @@map("g4d_wallet_transactions")
}

model CampaignPage {
  id           String         @id @default(cuid())
  vendorId     String
  vendor       Vendor         @relation(fields: [vendorId], references: [id])
  slug         String         @unique
  title        String
  headline     String
  subheadline  String?
  benefits     Json
  aboutText    String?
  heroImage    String?
  photos       Json?
  style        String         @default("LIGHT")
  phone        String
  whatsapp     String
  email        String?
  address      String?
  mapsLink     String?
  testimonials Json?
  ctaText      String         @default("Enquire Now")
  active       Boolean        @default(true)
  views        Int            @default(0)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  leads        CampaignLead[]
  @@map("g4d_campaign_pages")
}

model CampaignLead {
  id             String        @id @default(cuid())
  campaignPageId String?
  campaignPage   CampaignPage? @relation(fields: [campaignPageId], references: [id])
  vendorId       String
  vendor         Vendor        @relation(fields: [vendorId], references: [id])
  name           String
  phone          String
  message        String?
  source         String?
  status         String        @default("new")
  notes          String?
  assignedTo     String?
  followUpDate   DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  callLogs       CallLog[]
  @@map("g4d_campaign_leads")
}

model CallLog {
  id         String       @id @default(cuid())
  leadId     String
  lead       CampaignLead @relation(fields: [leadId], references: [id])
  vendorId   String
  calledBy   String
  duration   Int?
  outcome    String?
  notes      String?
  aiSummary  String?
  followUpAt DateTime?
  createdAt  DateTime     @default(now())
  @@map("g4d_call_logs")
}

model Campaign {
  id          String    @id @default(cuid())
  vendorId    String
  name        String
  description String?
  status      String    @default("draft")
  channels    Json
  content     Json
  walletCost  Int       @default(0)
  startDate   DateTime?
  endDate     DateTime?
  analytics   Json?
  approvedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  @@map("g4d_campaigns")
}

model TeamMember {
  id          String    @id @default(cuid())
  vendorId    String
  vendor      Vendor    @relation(fields: [vendorId], references: [id])
  name        String
  email       String?
  phone       String?
  role        String
  modules     Json
  status      String    @default("active")
  inviteToken String?
  password    String?
  lastLogin   DateTime?
  createdAt   DateTime  @default(now())
  @@map("g4d_team_members")
}

model Notification {
  id             String   @id @default(cuid())
  recipientId    String
  recipientType  String
  type           String
  priority       String   @default("INFO")
  title          String
  message        String
  data           Json?
  read           Boolean  @default(false)
  actionRequired Boolean  @default(false)
  actionType     String?
  actionData     Json?
  createdAt      DateTime @default(now())
  @@map("g4d_notifications")
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  userType  String
  endpoint  String
  p256dh    String
  auth      String
  device    String
  createdAt DateTime @default(now())
  @@map("g4d_push_subscriptions")
}

model PlatformIncome {
  id          String   @id @default(cuid())
  vendorId    String
  invoiceId   String?
  amount      Int
  source      String
  description String?
  createdAt   DateTime @default(now())
  @@map("g4d_platform_income")
}

// ===========================================================================
// DomainApp v2.0 core — shared, generic backend engine for ALL industries.
// One set of tables stores data for every industry; the frontend tailors the
// experience per industry via the industry config system. Multi-tenant: every
// row is scoped by vendorId.
// ===========================================================================

model Contact {
  id           String           @id @default(cuid())
  vendorId     String
  vendor       Vendor           @relation(fields: [vendorId], references: [id])
  name         String
  phone        String
  email        String?
  type         String           @default("customer")
  address      String?
  portalAccess Boolean          @default(false)
  customFields Json?
  tags         Json?
  notes        String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  records      Record[]
  invoices     GenericInvoice[]
  messages     Message[]
  @@index([vendorId])
  @@map("g4d_contacts")
}

// Communication Hub message history (Phase: real unified inbox). Outbound messages
// are persisted on send; inbound would be captured by provider webhooks (future).
model Message {
  id                String   @id @default(cuid())
  vendorId          String
  vendor            Vendor   @relation(fields: [vendorId], references: [id])
  contactId         String?
  contact           Contact? @relation(fields: [contactId], references: [id])
  channel           String   // whatsapp | email | sms
  direction         String   @default("out") // out | in
  subject           String?
  body              String
  status            String   @default("sent") // sent | mock | failed | received
  providerMessageId String?
  createdAt         DateTime @default(now())
  @@index([vendorId])
  @@index([contactId])
  @@map("g4d_messages")
}

model CatalogItem {
  id           String   @id @default(cuid())
  vendorId     String
  vendor       Vendor   @relation(fields: [vendorId], references: [id])
  name         String
  description  String?
  price        Float
  unit         String?
  image        String?
  active       Boolean  @default(true)
  customFields Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  records      Record[]
  @@index([vendorId])
  @@map("g4d_catalog_items")
}

model Record {
  id            String          @id @default(cuid())
  vendorId      String
  vendor        Vendor          @relation(fields: [vendorId], references: [id])
  contactId     String?
  contact       Contact?        @relation(fields: [contactId], references: [id])
  catalogItemId String?
  catalogItem   CatalogItem?    @relation(fields: [catalogItemId], references: [id])
  status        String          @default("draft")
  date          DateTime
  amount        Float           @default(0)
  notes         String?
  customFields  Json?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  invoice       GenericInvoice?
  @@index([vendorId])
  @@index([status])
  @@map("g4d_records")
}

// Generic DomainApp invoice (distinct from the subscription `Invoice` model).
model GenericInvoice {
  id             String    @id @default(cuid())
  vendorId       String
  vendor         Vendor    @relation(fields: [vendorId], references: [id])
  recordId       String?   @unique
  record         Record?   @relation(fields: [recordId], references: [id])
  contactId      String
  contact        Contact   @relation(fields: [contactId], references: [id])
  invoiceNumber  String    @unique
  items          Json
  subtotal       Float
  gstRate        Float     @default(0)
  gstAmount      Float     @default(0)
  total          Float
  status         String    @default("PENDING")
  dueDate        DateTime?
  paidAt         DateTime?
  razorpayLinkId String?
  pdfUrl         String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  @@index([vendorId])
  @@map("g4d_generic_invoices")
}

model VendorAddon {
  id        String   @id @default(cuid())
  vendorId  String
  vendor    Vendor   @relation(fields: [vendorId], references: [id])
  addonKey  String
  enabled   Boolean  @default(true)
  enabledAt DateTime @default(now())
  config    Json?
  @@unique([vendorId, addonKey])
  @@map("g4d_vendor_addons")
}

model VendorModule {
  id        String   @id @default(cuid())
  vendorId  String
  vendor    Vendor   @relation(fields: [vendorId], references: [id])
  moduleKey String
  enabled   Boolean  @default(true)
  enabledAt DateTime @default(now())
  @@unique([vendorId, moduleKey])
  @@map("g4d_vendor_modules")
}

model PlatformSetting {
  id        String   @id @default(cuid())
  category  String
  key       String
  value     String
  encrypted Boolean  @default(true)
  status    String   @default("NOT_CONFIGURED")
  updatedAt DateTime @updatedAt
  updatedBy String?
  @@unique([category, key])
  @@map("g4d_platform_settings")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  VENDOR
}

// Quotes sent by the admin marketing team to existing vendors or new prospects.
model Quote {
  id            String    @id @default(cuid())
  vendorId      String? // set when quoting an existing vendor
  prospectName  String
  prospectPhone String?
  prospectEmail String?
  quoteType     String // domainapp_plan | domaincampaign_wallet | custom
  itemLabel     String // human label of what is being quoted
  amount        Int // in paise
  notes         String?
  channel       String // email | whatsapp | sms
  status        String    @default("sent") // sent | viewed | accepted
  sentBy        String? // admin email/id that sent it
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  @@map("g4d_quotes")
}

// Get4Domain's OWN internal staff roles (distinct from vendor Role above).
enum AdminRole {
  SUPER_ADMIN
  MARKETING
  OPERATIONS
}

// Internal Get4Domain team members (marketing / operations staff). Mirrors the
// vendor-side TeamMember in spirit but is scoped to the platform, not a vendor.
// The bootstrap admin@get4domain.com stays a Vendor(role=SUPER_ADMIN); invited
// staff live here and authenticate as admin_member principals (see auth).
model AdminTeamMember {
  id          String    @id @default(cuid())
  name        String
  email       String    @unique
  phone       String?
  role        AdminRole @default(OPERATIONS)
  status      String    @default("invited") // invited | active | removed
  inviteToken String?
  password    String?
  lastLogin   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  @@map("g4d_admin_team_members")
}

enum VendorStatus {
  ACTIVE
  SUSPENDED
  PENDING
}

enum Product {
  DOMAIN_APP
  DOMAIN_CAMPAIGN
  BOTH
}

enum Plan {
  STARTUP
  ENTERPRISE
  STARTER
  BUSINESS
}

enum SubStatus {
  PENDING
  ACTIVE
  EXPIRED
  CANCELLED
}

enum InvoiceStatus {
  PENDING
  PAID
  OVERDUE
  CANCELLED
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}
