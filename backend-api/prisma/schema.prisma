  DELIVERED
  SEEN
  RESPONDED
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CLOSED
  EXPIRED
  SPAM
}

enum V3RequestSource {
  DIRECTORY
  SITE
  WHATSAPP
  MANUAL
}

enum V3RequestActor {
  CUSTOMER
  VENDOR
  STAFF
  SYSTEM
}

enum V3PaymentMethodKind {
  OWN_GATEWAY
  UPI
  PAY_ON_DELIVERY
  PAY_AT_VISIT
  BANK_TRANSFER
}

enum V3PaymentMethodStatus {
  UNVERIFIED
  ACTIVE
  DISABLED
}

enum V3OrderStatus {
  PLACED
  AWAITING_PAYMENT
  PAID
  PACKED
  SHIPPED
  DELIVERED
  CANCELLED
  RETURNED
  REFUNDED_RECORDED
}

enum V3OrderPaymentMode {
  ONLINE
  COD
  AT_VISIT
  MANUAL
}

enum V3VendorInvoiceStatus {
  ISSUED
  VOID
}

enum V3OfferKind {
  BANNER
  COUPON
}

enum V3OfferStatus {
  ACTIVE
  PAUSED
  ENDED
}

enum V3MessageChannel {
  WHATSAPP
  SMS
  EMAIL
}

enum V3MessageStatus {
  QUEUED
  SENT_SANDBOX
  FAILED
  DELIVERED
}

enum V3ReportStatus {
  OPEN
  REVIEWED
  ACTIONED
  REJECTED
}

enum V3BlockKind {
  PHONE_HASH
  IP_HASH
  EMAIL_HASH
}

enum V3CounterKind {
  ORDER
  INVOICE
}

model V3Request {
  id                String          @id @default(cuid())
  vendorId          String
  siteHost          String
  kind              V3RequestKind
  status            V3RequestStatus @default(RECEIVED)
  customerName      String
  customerPhoneE164 String
  customerEmail     String?
  payloadJson       Json            @default("{}")
  sourceKind        V3RequestSource @default(SITE)
  directoryRefHash  String? // set only when a live Visit reference was consumed for this vendor's business
  utmSource         String?
  utmMedium         String?
  utmCampaign       String?
  idempotencyKey    String
  spamScore         Int             @default(0)
  firstSeenAt       DateTime?
  firstResponseAt   DateTime?
  expiresAt         DateTime
  convertedCustomerId String? // the CRM and booking modules arrive later: this slice only records the link
  convertedBookingId  String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  vendor   Vendor            @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  events   V3RequestEvent[]
  consent  V3RequestConsent?
  tracking V3RequestTracking?
  termsAcceptances V3TermsAcceptance[]
  order    V3Order?

  @@unique([vendorId, idempotencyKey])
  @@index([vendorId, status, createdAt])
  @@index([vendorId, createdAt])
  @@index([customerPhoneE164])
  @@map("g4d_requests")
}

/// Append-only: nothing in the code updates or deletes a row.
model V3RequestEvent {
  id             String         @id @default(cuid())
  requestId      String
  type           String
  actorType      V3RequestActor
  channel        String?
  deliveryResult String?
  at             DateTime       @default(now())
  metaJson       Json           @default("{}")

  request V3Request @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId, at])
  @@map("g4d_request_events")
}

model V3RequestConsent {
  id                 String   @id @default(cuid())
  requestId          String   @unique
  textVersion        Int
  textHash           String
  ipHash             String?
  at                 DateTime @default(now())
  contactByBusiness  Boolean
  contactByPlatform  Boolean
  marketing          Boolean

  request V3Request @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@map("g4d_request_consents")
}

model V3RequestTracking {
  id        String   @id @default(cuid())
  requestId String   @unique
  tokenHash String   @unique
  expiresAt DateTime

  request V3Request @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@map("g4d_request_tracking")
}

model V3VendorPaymentMethod {
  id                 String                @id @default(cuid())
  vendorId           String
  kind               V3PaymentMethodKind
  label              String
  configCipher       String? // sealed with the platform key; write-only, never returned
  configIv           String?
  configTag          String?
  last4              String?
  upiId              String? // the vendor's own UPI id, lower case; shown to the owner, masked to staff
  payeeName          String? // the name the customer sees in their UPI app
  isDefault          Boolean               @default(false) // one per vendor (partial unique index in the 5.17a migration)
  showToCustomers    Boolean               @default(false) // bank details only
  webhookSecretCipher String?
  webhookSecretIv    String?
  webhookSecretTag   String?
  status             V3PaymentMethodStatus @default(UNVERIFIED)
  verifiedAt         DateTime?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  vendor Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)
