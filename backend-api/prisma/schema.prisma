}

model V3StockLevel {
  id         String   @id @default(cuid())
  vendorId   String
  productRef String
  onHand     Int
  reserved   Int      @default(0)
  updatedAt  DateTime @updatedAt

  vendor Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@unique([vendorId, productRef])
  @@map("g4d_stock_levels")
}

model V3StockReservation {
  id         String    @id @default(cuid())
  vendorId   String
  orderId    String
  productRef String
  qty        Int
  expiresAt  DateTime
  releasedAt DateTime?
  committedAt DateTime?

  @@index([orderId])
  @@index([expiresAt])
  @@map("g4d_stock_reservations")
}

model V3Offer {
  id             String        @id @default(cuid())
  vendorId       String
  kind           V3OfferKind
  title          String
  code           String?
  percentOff     Int?
  flatPaise      Int?
  minOrderPaise  Int           @default(0)
  startsAt       DateTime?
  endsAt         DateTime?
  usageLimit     Int?
  usedCount      Int           @default(0)
  status         V3OfferStatus @default(ACTIVE)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  vendor Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@unique([vendorId, code])
  @@index([vendorId, status])
  @@map("g4d_offers")
}

model V3MessageOutbox {
  id                  String           @id @default(cuid())
  vendorId            String?
  channel             V3MessageChannel
  templateKey         String
  toHash              String
  toMasked            String
  payloadRedactedJson Json             @default("{}")
  senderRoute         String
  status              V3MessageStatus  @default(QUEUED)
  attempts            Int              @default(0)
  relatedRequestId    String?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  @@index([vendorId, createdAt])
  @@index([relatedRequestId])
  @@map("g4d_message_outbox")
}

/// A recipient who said STOP. Honoured by the message router. Append-only.
model V3MessageSuppression {
  id      String           @id @default(cuid())
  hash    String
  channel V3MessageChannel
  at      DateTime         @default(now())

  @@unique([hash, channel])
  @@map("g4d_message_suppressions")
}

model V3Report {
  id                   String         @id @default(cuid())
  reportedHost         String
  reasonKind           String
  text                 String
  reporterContactMasked String?
  status               V3ReportStatus @default(OPEN)
  handledBy            String?
  handledAt            DateTime?
  createdAt            DateTime       @default(now())

  @@index([status, createdAt])
  @@map("g4d_reports")
}

model V3Blocklist {
  id      String      @id @default(cuid())
  kind    V3BlockKind
  hash    String
  reason  String
  addedBy String?
  at      DateTime    @default(now())

  @@unique([kind, hash])
  @@map("g4d_blocklist")
}

enum V3TermsKind {
  VENDOR_TERMS
  ACCEPTABLE_USE
  DATA_PROCESSING
  REFUND_POLICY_TEMPLATE
  GRIEVANCE
  PRIVACY
  COOKIE
  CUSTOMER_TERMS
}

enum V3TermsStatus {
  DRAFT
  PUBLISHED
  RETIRED
}

/// A legal document, one row per kind and version. Only staff publish; a body that is still the placeholder can never be published.
model V3TermsDocument {
  id           String        @id @default(cuid())
  kind         V3TermsKind
  version      Int
  title        String        @default("")
  status       V3TermsStatus @default(DRAFT)
  bodyMarkdown String
  changeNote   String?
  publishedAt  DateTime?
  publishedBy  String?
  createdBy    String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  acceptances V3TermsAcceptance[]

  @@unique([kind, version])
  @@index([kind, status])
  @@map("g4d_terms_documents")
}

/// IMMUTABLE: a database trigger refuses every update and every delete (a delete is allowed only as the cascade of a tenant row that is already gone). One of vendorId and customerRequestId is set.
model V3TermsAcceptance {
  id                String      @id @default(cuid())
  vendorId          String?
  customerRequestId String?
  userId            String?
  documentId        String
  kind              V3TermsKind
  version           Int
  acceptedAt        DateTime    @default(now())
  ipHash            String?
  userAgentHash     String?

  vendor          Vendor?         @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  customerRequest V3Request?      @relation(fields: [customerRequestId], references: [id], onDelete: Cascade)
  document        V3TermsDocument @relation(fields: [documentId], references: [id], onDelete: Restrict)

  @@unique([vendorId, documentId])
  @@unique([customerRequestId, documentId])
  @@index([vendorId, kind])
  @@index([documentId])
  @@map("g4d_terms_acceptances")
}

// ───────────────────────────────────────────────────────────────────────────────────────── V3 wallet (slice 5.16a, 5.16a-2): Get4Domain's own wallet and ledger, integer paise, never legacy
enum V3WalletStatus {
  INACTIVE
  ACTIVE
  FROZEN
}

enum V3WalletLedgerKind {
  TOPUP
  HOLD
  RELEASE
  CHARGE
  REVERSAL
  EXPIRY
  ADJUSTMENT
  PACK_PURCHASE
  PLAN_RENEWAL
}

enum V3WalletTopupStatus {
  CREATED
  PENDING
  PAID
  FAILED
  EXPIRED
}

enum V3WalletLotStatus {
  OPEN
  SPENT
  EXPIRED
}

enum V3WalletLotSource {
  TOPUP
  ADJUSTMENT
}

/// One wallet per vendor. The balance and held numbers are a CACHE of the ledger (reconcile checks them); the database refuses a negative balance, a negative held amount and held above balance.
model V3Wallet {
  id                 String         @id @default(cuid())
  vendorId           String         @unique
  status             V3WalletStatus @default(INACTIVE)
  balancePaise       Int            @default(0)
  heldPaise          Int            @default(0)
  entryCount         Int            @default(0)
  version            Int            @default(0)
  activatedAt        DateTime?
  activatedByEventId String?
  frozenReason       String?
  billingStateCode   String? // the vendor's GST state code, used by the tax rule when a service is charged
  billingGstin       String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  vendor Vendor            @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  ledger V3WalletLedger[]
  lots   V3WalletLot[]

  @@map("g4d_v3_wallets")
}

/// APPEND-ONLY: a database trigger refuses every update and every delete (a delete is allowed only as the cascade of a wallet that is already gone).
model V3WalletLedger {
  id                String             @id @default(cuid())
  walletId          String
  vendorId          String
  entryNo           Int
  kind              V3WalletLedgerKind
  amountPaise       Int // the effect on the vendor's AVAILABLE money (see wallet-core.ts)
  balanceDeltaPaise Int
  heldDeltaPaise    Int
  balanceAfterPaise Int
  heldAfterPaise    Int
  refType           String?
  refId             String?
  idempotencyKey    String
  holdId            String? // set on the RELEASE or CHARGE that settles a HOLD; unique, so a hold is settled once
  reversesId        String? // set on a REVERSAL; unique, so a charge is reversed once
  reason            String?
  actorType         String
  actorId           String?
  lotUsesJson       Json               @default("[]")
  at                DateTime           @default(now())

  wallet V3Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@unique([walletId, idempotencyKey])
  @@unique([walletId, entryNo])
  @@unique([holdId])
  @@unique([reversesId])
  @@index([vendorId, at])
  @@index([refType, refId])
  @@map("g4d_wallet_ledger")
}

model V3WalletTopup {
  id              String              @id @default(cuid())
  vendorId        String
  amountPaise     Int
  currency        String              @default("INR")
  status          V3WalletTopupStatus @default(CREATED)
  providerOrderId String?             @unique
  idempotencyKey  String
  paymentId       String?
  paidAmountPaise Int?
  /// what the vendor pays: the credit (amountPaise) plus GST. null on a refill made before GST was added on top.
  payablePaise    Int?
  /// the tax worked out when the refill was made; the tax invoice is issued from this
  taxSnapshotJson Json                @default("{}")
  paidAt          DateTime?
  ledgerId        String?
  receiptId       String?
  createdByType   String              @default("VENDOR")
  createdById     String?
  expiresAt       DateTime
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  vendor  Vendor            @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  receipt V3WalletReceipt?

  @@unique([vendorId, idempotencyKey])
  @@index([vendorId, createdAt])
  @@index([status, expiresAt])
  @@map("g4d_wallet_topups")
}

/// The numbered document of a refill. Since 5 November 2026 it is a TAX_INVOICE from the shared invoice series (GST on top of the credit); a RECEIPT is a refill made before that. The wording and the treatment of an advance are for the accountant.
model V3WalletReceipt {
  id            String   @id @default(cuid())
  vendorId      String
  topupId       String   @unique
  receiptNumber String   @unique
  financialYear String
  documentType  String   @default("RECEIPT")
  issuedAt      DateTime
  snapshotJson  Json
  createdAt     DateTime @default(now())

  vendor Vendor        @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  topup  V3WalletTopup @relation(fields: [topupId], references: [id], onDelete: Cascade)

  @@index([vendorId, issuedAt])
  @@map("g4d_wallet_receipts")
}

/// One lot per top-up (or positive staff adjustment). Spending takes the lot that expires first; the lots always add up to the balance.
model V3WalletLot {
  id             String            @id @default(cuid())
  walletId       String
  vendorId       String
  topupId        String?           @unique
  source         V3WalletLotSource @default(TOPUP)
  amountPaise    Int
  remainingPaise Int
  expiresAt      DateTime
  status         V3WalletLotStatus @default(OPEN)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  wallet V3Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId, status, expiresAt])
  @@index([status, expiresAt])
  @@map("g4d_wallet_lots")
}

// ───────────────────────────────────────────────────────────────────────────────────────── V3 services and the price book (slice 5.16b)
enum V3ServiceDoneBy {
  VENDOR
  TEAM
  EITHER
}

enum V3ServiceDelivery {
  INSTANT
  TEAM_REQUEST
}

/// When a service can be bought. PRO_ACTIVE_OR_GRACE (default): only while the vendor's Pro plan is ACTIVE or in grace. ANY: in any plan state. Editable by staff per service.
enum V3ServicePlanRule {
  PRO_ACTIVE_OR_GRACE
  ANY
}

enum V3CatalogStatus {
  DRAFT
  ACTIVE
  RETIRED
}

enum V3ServicePriceStatus {
  PROPOSED
  APPROVED
  RETIRED
}

model V3Service {
  id               String            @id @default(cuid())
  key              String            @unique
  name             String
  shortDescription String
  includesText     String // what the service includes, in plain words (shown before the vendor confirms)
  approvalText     String // how approval works
  kind             String            @default("GENERAL")
  doneBy           V3ServiceDoneBy   @default(TEAM)
  deliveryKind     V3ServiceDelivery @default(TEAM_REQUEST)
  planStateRule    V3ServicePlanRule @default(PRO_ACTIVE_OR_GRACE)
  trackScope       String[] // empty = every track
  publicVisible    Boolean           @default(false)
  sortOrder        Int               @default(0)
  status           V3CatalogStatus   @default(ACTIVE)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  prices   V3ServicePrice[]
  requests V3ServiceRequest[]

  @@map("g4d_services")
}

/// A price is never set by code: PROPOSED by staff (or the one seeded row), APPROVED by SUPER_ADMIN with an effective date. The row in force is the APPROVED row with the latest effectiveFrom that has started.
model V3ServicePrice {
  id           String        @id @default(cuid())
  serviceId    String
  amountPaise  Int
  currency     String        @default("INR")
  taxCategory  String        @default("ALL")
  taxInclusive Boolean       @default(false)
  effectiveFrom DateTime? // required to approve; an undated PROPOSED row is a proposal only
  status       V3ServicePriceStatus @default(PROPOSED)
  note         String?
  createdBy    String?
  approvedBy   String?
  approvedAt   DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  service V3Service @relation(fields: [serviceId], references: [id], onDelete: Restrict)

  @@unique([serviceId, effectiveFrom])
  @@index([serviceId, status])
  @@map("g4d_service_prices")
}

model V3AddonPack {
  id           String          @id @default(cuid())
  key          String          @unique
  name         String
  description  String
  itemsJson    Json // [{ "serviceKey": "POSTER_DESIGN", "count": 3 }]
  validityDays Int? // null = the pack does not expire; a number is set by staff, never by code
  status       V3CatalogStatus @default(DRAFT)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  prices    V3AddonPackPrice[]
  purchases V3PackPurchase[]

  @@map("g4d_addon_packs")
}

model V3AddonPackPrice {
  id            String        @id @default(cuid())
  packId        String
  amountPaise   Int
  currency      String        @default("INR")
  taxCategory   String        @default("ALL")
  taxInclusive  Boolean       @default(false)
  effectiveFrom DateTime?
  status        V3ServicePriceStatus @default(PROPOSED)
  note          String?
  createdBy     String?
  approvedBy    String?
  approvedAt    DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  pack V3AddonPack @relation(fields: [packId], references: [id], onDelete: Restrict)

  @@unique([packId, effectiveFrom])
  @@index([packId, status])
  @@map("g4d_addon_pack_prices")
}

/// A pack a vendor bought with wallet credit. `remainingJson` counts down as services use it. The price and tax are copied here so later price edits never change what was bought.
model V3PackPurchase {
  id                 String    @id @default(cuid())
  vendorId           String
  packId             String
  idempotencyKey     String
  remainingJson      Json // { "POSTER_DESIGN": 3 }
  priceSnapshotPaise Int
  taxSnapshotJson    Json      @default("{}")
  purchasedAt        DateTime  @default(now())
  expiresAt          DateTime?
  ledgerEntryId      String    @unique
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  vendor Vendor      @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  pack   V3AddonPack @relation(fields: [packId], references: [id], onDelete: Restrict)

  @@unique([vendorId, idempotencyKey])
  @@index([vendorId, purchasedAt])
  @@map("g4d_pack_purchases")
}

// ───────────────────────────────────────────────────────────────────────────────────────── V3 service requests (slice 5.16c): team work paid by allowance, pack or wallet
enum V3ServiceRequestStatus {
  REQUESTED
  ACCEPTED
  IN_PRODUCTION
  READY_FOR_REVIEW
  REVISION_REQUESTED
  APPROVED
  REJECTED_BY_TEAM
  CANCELLED
}

enum V3ServiceFunding {
  INCLUDED_ALLOWANCE
  PACK
  WALLET
}

enum V3ServiceRequestCreator {
  VENDOR
  STAFF_ON_BEHALF
}

enum V3DeliverableKind {
  TEXT
  FILE_REF
  LINK
}

/// A request for our team to do a service. The money rule: a WALLET request HOLDS the price plus tax when it is made, CHARGES it when the vendor approves the work, and RELEASES it when the vendor cancels or the team rejects. Nothing is charged for work the vendor has not approved.
model V3ServiceRequest {
  id                 String                  @id @default(cuid())
  vendorId           String
  serviceId          String
  status             V3ServiceRequestStatus  @default(REQUESTED)
  briefJson          Json
  attachmentRefs     Json                    @default("[]")
  priceSnapshotPaise Int? // price plus tax at the time of the request (null for an allowance or pack, which were paid for earlier)
  taxSnapshotJson    Json                    @default("{}")
  fundingKind        V3ServiceFunding
  holdLedgerId       String?                 @unique
  chargeLedgerId     String?                 @unique
  packPurchaseId     String?
  assignedStaffId    String?
  slaDueAt           DateTime?
  slaBreachedAt      DateTime?
  readyAt            DateTime? // when the work last came to the vendor for review (the auto-approval timer starts here)
  revisionsUsed      Int                     @default(0)
  grantEndsAt        DateTime? // CUSTOM_DOMAIN_PROMOTION only: when the add-on ends, set by staff (never by code)
  grantOverrideId    String? // the entitlement override created on approval (or "PENDING" while it is being made)
  createdByType      V3ServiceRequestCreator @default(VENDOR)
  createdById        String?
  idempotencyKey     String
  rejectReason       String?
  approvedAt         DateTime?
  cancelledAt        DateTime?
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt

  vendor       Vendor                @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  service      V3Service             @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  events       V3ServiceRequestEvent[]
  deliverables V3ServiceDeliverable[]
  invoice      V3ServiceInvoice?

  @@unique([vendorId, idempotencyKey])
  @@index([vendorId, status, createdAt])
  @@index([status, slaDueAt])
  @@index([serviceId, status])
  @@map("g4d_service_requests")
}

/// APPEND-ONLY: a trigger refuses every update and delete (a delete is allowed only as the cascade of a request that is already gone).
model V3ServiceRequestEvent {
  id         String   @id @default(cuid())
  requestId  String
  vendorId   String
  type       String
  fromStatus String?
  toStatus   String?
  actorType  String
  actorId    String?
  note       String?
  metaJson   Json     @default("{}")
  at         DateTime @default(now())

  request V3ServiceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId, at])
  @@index([vendorId, at])
  @@map("g4d_service_request_events")
}

model V3ServiceDeliverable {
  id        String            @id @default(cuid())
  requestId String
  vendorId  String
  kind      V3DeliverableKind
  text      String?
  fileRef   String?
  createdBy String?
  createdAt DateTime          @default(now())

  request V3ServiceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId, createdAt])
  @@map("g4d_service_deliverables")
}

/// A tax invoice for a charge, numbered from the SAME gap-free series as plan invoices. APPEND-ONLY (a trigger refuses update and delete). One per request.
model V3ServiceInvoice {
  id               String   @id @default(cuid())
  vendorId         String
  requestId        String   @unique
  invoiceNumber    String   @unique
  financialYear    String
  issuedAt         DateTime
  ledgerEntryId    String   @unique
  snapshotJson     Json
  taxBreakdownJson Json
  createdAt        DateTime @default(now())

  request V3ServiceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([vendorId, issuedAt])
  @@map("g4d_service_invoices")
}

// ───────────────────────────────────────────────────────────────────────────────────────── V3 theme switch service (slice 5.16d)
enum V3ThemeSwitchKind {
  FREE_INCLUDED
  PAID
  COMPLIMENTARY_STAFF
  RESTORE
}

enum V3ThemeSwitchStatus {
  PENDING
  APPLIED
  FAILED
}

/// One row per theme switch. FREE_INCLUDED is the one switch a Pro plan includes (the first); every later switch is PAID (the Theme Switch Service fee from the price book); COMPLIMENTARY_STAFF is a staff gift with a reason; RESTORE re-applies the stored theme after a lapse and a renewal (no charge, not counted as a switch).
model V3ThemeSwitch {
  id                 String              @id @default(cuid())
  vendorId           String
  siteId             String? // the vendor's site settings row at the time
  fromThemeKey       String?
  toThemeKey         String
  kind               V3ThemeSwitchKind
  performedByType    String // VENDOR | STAFF | SYSTEM
  performedById      String?
  serviceRequestId   String? // set when the vendor asked our team (slice 5.16c): that request carries the fee
  ledgerEntryId      String?             @unique // the wallet CHARGE that paid for it
  packPurchaseId     String? // the pack a unit of which paid for it
  priceSnapshotPaise Int?
  taxSnapshotJson    Json                @default("{}")
  publicationId      String? // the publication snapshot the switch made (rollback to the previous one stays possible)
  status             V3ThemeSwitchStatus @default(PENDING)
  idempotencyKey     String
  reason             String?
  failureReason      String?
  hiddenFieldsJson   Json                @default("[]") // content the new theme does not draw: kept, never removed, drawn again if the vendor switches back
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  vendor Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@unique([vendorId, idempotencyKey])
  @@index([vendorId, createdAt])
  @@index([status, updatedAt])
  @@map("g4d_theme_switches")
}

// ── Batch 4B slice 5.20: activity log and alerts ─────────────────────────────────────────────────────────────────────

enum V3ActivityActorType {
  VENDOR_USER
  STAFF
  SYSTEM
}

enum V3AlertLevel {
  HIGH
  MEDIUM
  LOW
}

enum V3AlertStatus {
  NEW
  LOOKING
  RESOLVED
  NOT_AN_ISSUE
}

/// Append-only record of what a vendor, a staff member or the system did. The summary has secrets removed and personal data masked before it is stored. The vendorId has no foreign key on purpose: the log outlives the row it describes. The database refuses every update, and refuses a delete while the vendor still exists.
model V3ActivityLog {
  id          String              @id @default(cuid())
  vendorId    String?
  actorType   V3ActivityActorType
  actorId     String?
  actionKey   String
  entityType  String
  entityId    String?
  summaryJson Json                @default("{}")
  ipHash      String?
  at          DateTime            @default(now())

  @@index([vendorId, at])
  @@index([actionKey, at])
  @@map("g4d_activity_log")
}

/// One row per alert rule. Seeded disabled with no thresholds; staff set the numbers and switch a rule on. The level and the key of a seeded rule are fixed by the owner's table.
model V3AlertRule {
  id                String       @id @default(cuid())
  key               String       @unique
  level             V3AlertLevel
  thresholdJson     Json?
  notifyRoles       String[]     @default([])
  enabled           Boolean      @default(false)
  updatedByStaffId  String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@map("g4d_alert_rules")
}

/// A notice to staff raised after an event. It never hides, deletes or freezes anything by itself.
model V3Alert {
  id           String        @id @default(cuid())
  vendorId     String
  ruleKey      String
  level        V3AlertLevel
  status       V3AlertStatus @default(NEW)
  ownerStaffId String?
  activityIds  String[]      @default([])
  note         String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  resolvedAt   DateTime?

  @@index([status, level, createdAt])
  @@index([vendorId, createdAt])
  @@index([ownerStaffId, status])
  @@map("g4d_alerts")
}

/// (Table name g4d_v3_notifications: g4d_notifications is the legacy Notification table and is not touched.) In-app notification for one staff member (userId) or for every staff member of a role. In-app only: nothing is sent outside.
model V3Notification {
  id        String    @id @default(cuid())
  userId    String?
  role      String?
  kind      String
  refId     String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
  @@index([role, readAt])
  @@map("g4d_v3_notifications")
}

// ── Batch 4B slice 5.21: trust and safety ────────────────────────────────────────────────────────────────────────────

enum V3ProofKind {
  GST
  UDYAM
  SHOP_LICENCE
  PROFESSIONAL_REGISTRATION
  OTHER
}

enum V3ProofStatus {
  SUBMITTED
  CHECKED
  MISMATCH
}

enum V3TrustBlockKind {
  PHONE
  EMAIL
  DOMAIN
  UPI
  NAME
}

enum V3ReportSubject {
  LISTING
  SITE
}

enum V3BusinessReportStatus {
  NEW
  LOOKING
  CLOSED
}

enum V3TakedownStatus {
  ACTIVE
  REVERSED
}

/// A document or registration number a vendor offers to show the business is real. Optional at Pro activation; staff mark it CHECKED or MISMATCH. One row per vendor and kind (a new submission replaces the old one and starts again at SUBMITTED).
model V3BusinessProof {
  id          String        @id @default(cuid())
  vendorId    String
  kind        V3ProofKind
  number      String
  documentRef String?
  status      V3ProofStatus @default(SUBMITTED)
  checkedBy   String?
  checkedAt   DateTime?
  note        String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  vendor Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@unique([vendorId, kind])
  @@index([status, createdAt])
  @@map("g4d_business_proofs")
}

/// (The older g4d_blocklist is the do-not-contact register and is not touched.) A value the trust team refuses to deal with, stored as a keyed hash of its normalised form (never the value itself).
model V3TrustBlock {
  id               String      @id @default(cuid())
  kind             V3TrustBlockKind
  valueHash        String
  reason           String
  createdByStaffId String?
  at               DateTime    @default(now())

  @@unique([kind, valueHash])
  @@map("g4d_trust_blocklist")
}

/// A report from the public about a listing or a site. No personal data is required; a contact is optional.
model V3BusinessReport {
  id               String          @id @default(cuid())
  subjectType      V3ReportSubject
  subject          String
  reporterContact  String?
  reason           String
  status           V3BusinessReportStatus  @default(NEW)
  ipHash           String?
  handledByStaffId String?
  note             String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([status, createdAt])
  @@map("g4d_business_reports")
}

/// A phrase the scan looks for in published and requested text. The table starts empty: staff (SUPER_ADMIN) add the phrases, the code invents none. Stored lower case with single spaces.
model V3ProhibitedTerm {
  id        String   @id @default(cuid())
  term      String   @unique
  category  String
  enabled   Boolean  @default(true)
  editedBy  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("g4d_prohibited_terms")
}

/// A Legal takedown (SUPER_ADMIN only, written reason required). While ACTIVE the site serves a plain notice page and the listing is out of the directory. No foreign key on purpose: the record outlives the vendor row. The database refuses any change to the reason, the decider, the time and the target, and refuses a delete.
model V3Takedown {
  id                 String           @id @default(cuid())
  vendorId           String?
  listingId          String?
  reason             String
  documentRef        String?
  decidedBy          String
  at                 DateTime         @default(now())
  status             V3TakedownStatus @default(ACTIVE)
  priorListingStatus String?
  priorIndexable     Boolean?
  reversedBy         String?
  reversedAt         DateTime?
  reverseReason      String?

  @@index([vendorId, status])
  @@index([listingId, status])
  @@index([status, at])
  @@map("g4d_takedowns")
}

// ── Slice 5.17b (Batch 5, amendment 06 UPI only): pay requests and the payments a vendor confirms ──
enum V3PaySource {
  MANUAL
  REQUEST
  ORDER
}

enum V3PayStatus {
  AWAITING
  CUSTOMER_SAYS_PAID
  PAID
  EXPIRED
  CANCELLED
}

enum V3PaymentConfirmedBy {
  VENDOR
  GATEWAY // unused: no gateway is offered to vendors
}

model V3PaymentRequest {
  id             String      @id @default(cuid())
  vendorId       String
  code           String      @unique // unguessable, in the public pay link
  amountPaise    Int
  note           String?
  customerName   String
  customerPhone  String?
  source         V3PaySource @default(MANUAL)
  requestId      String?
  orderId        String?
  methodId       String
  status         V3PayStatus @default(AWAITING)
  expiresAt      DateTime
  customerSaidAt DateTime?
  customerUtr    String?
  createdBy      String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  vendor  Vendor                @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  method  V3VendorPaymentMethod @relation(fields: [methodId], references: [id], onDelete: Restrict)
  payment V3Payment?

  @@index([vendorId, status, createdAt])
  @@index([status, expiresAt])
  @@index([vendorId, orderId])
  @@map("g4d_payment_requests")
}

model V3Payment {
  id                String               @id @default(cuid())
  paymentRequestId  String               @unique
  vendorId          String
  amountPaise       Int
  level             Int                  @default(1)
  provider          String               @default("UPI_MANUAL")
  providerPaymentId String
  utr               String?
  confirmedBy       V3PaymentConfirmedBy @default(VENDOR)
  confirmedAt       DateTime
  idempotencyKey    String?
  createdAt         DateTime             @default(now())

  request V3PaymentRequest @relation(fields: [paymentRequestId], references: [id], onDelete: Cascade)
  vendor  Vendor           @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  document V3VendorDocument?

  @@unique([provider, providerPaymentId])
  @@unique([vendorId, idempotencyKey])
  @@index([vendorId, confirmedAt])
  @@map("g4d_payments")
}

// ── Slice 5.17d (Batch 5): the vendor receipts and invoices ──
enum V3DocKind {
  TAX_INVOICE
  BILL_OF_SUPPLY
  BILL
  FEE_RECEIPT
}

enum V3SendStatus {
  NONE
  PENDING
  SENT_SANDBOX
  FAILED
  SKIPPED
}

model V3VendorTaxProfile {
  id                String   @id @default(cuid())
  vendorId          String   @unique
  gstRegistered     Boolean  @default(false)
  gstin             String?
  stateCode         String?
  legalName         String?
  address           String?
  compositionScheme Boolean  @default(false)
  invoicePrefix     String   @default("INV")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  vendor Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@map("g4d_vendor_tax_profiles")
}

/// Gap-free numbering: one row per vendor and financial year; the next number is taken in the same transaction that writes the document, so a rollback gives the number back.
model V3InvoiceSeries {
  id         String   @id @default(cuid())
  vendorId   String
  periodKey  String
  prefix     String
  nextNumber Int      @default(1)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  vendor Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@unique([vendorId, periodKey])
  @@map("g4d_invoice_series")
}

model V3VendorDocument {
  id               String       @id @default(cuid())
  vendorId         String
  kind             V3DocKind
  number           String
  seq              Int
  periodKey        String
  paymentId        String       @unique
  customerSnapshot Json         @default("{}")
  itemsJson        Json         @default("[]")
  taxJson          Json         @default("{}")
  totalPaise       Int
  pdfRef           String?
  publicCode       String       @unique
  whatsappStatus   V3SendStatus @default(NONE)
  emailStatus      V3SendStatus @default(NONE)
  resendCount      Int          @default(0)
  flagsJson        Json         @default("{}")
  createdAt        DateTime     @default(now())

  vendor  Vendor    @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  payment V3Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@unique([vendorId, number])
  @@unique([vendorId, periodKey, seq])
  @@index([vendorId, createdAt])
  @@map("g4d_vendor_documents")
}

/// The message outbox of the payment slices. Batch 6 replaces the consumer; here only the fake sender reads it.
model V3Outbox {
  id             String   @id @default(cuid())
  vendorId       String?
  channel        String
  templateKey    String
  toHash         String
  toMasked       String
  payloadJson    Json     @default("{}")
  idempotencyKey String   @unique
  status         String   @default("PENDING")
  attempts       Int      @default(0)
  createdAt      DateTime @default(now())

  @@index([status, createdAt])
  @@map("g4d_outbox")
}

/// Slice 5.5a (Website manager): the vendor's working copy of the managed content document. One row per vendor; every autosave bumps `rev`.
model V3SiteDraft {
  vendorId    String   @id
  docJson     Json     @default("{}")
  rev         Int      @default(0)
  baseVersion Int? // the publication version the draft was started from
  updatedBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  vendor Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@map("g4d_site_drafts")
}

/// Slice 5.5a: the managed content document a publication was built from. The LIVE document is the snapshot of the current publication.
model V3SiteSnapshot {
  id            String   @id @default(cuid())
  vendorId      String
  publicationId String   @unique
  version       Int
  docJson       Json     @default("{}")
  docHash       String
  createdAt     DateTime @default(now())

  vendor Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@unique([vendorId, version])
  @@index([vendorId, createdAt])
  @@map("g4d_site_snapshots")
}

/// Slice 5.5b (Website manager): a picture a vendor (or staff on its behalf) uploaded. Re-encoded, sized, with alt text; the file lives under vendors/<vendorId>/ in storage.
model V3SitePicture {
  id             String      @id @default(cuid())
  vendorId       String
  storagePath    String
  url            String
  contentType    String
  bytes          Int
  width          Int
  height         Int
  altText        String
  sha256         String
  uploadedByType V3ActorType @default(SYSTEM)
  uploadedById   String?
  createdAt      DateTime    @default(now())
  deletedAt      DateTime?

  vendor Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@unique([vendorId, sha256])
  @@index([vendorId, createdAt])
  @@map("g4d_site_pictures")
}

/// Slice 5.5b: the Banner Library. Platform data (no vendor): reference banners per category, each with its source, author, licence and date obtained.
model V3BannerImage {
  id          String   @id @default(cuid())
  categoryId  String
  storagePath String
  url         String
  contentType String
  bytes       Int
  width       Int
  height      Int
  altText     String
  hasPeople   Boolean  @default(false)
  sourceUrl   String
  author      String
  licenceName String
  obtainedOn  String
  sha256      String
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([categoryId, sha256])
  @@index([categoryId, active])
  @@map("g4d_banner_images")
}
