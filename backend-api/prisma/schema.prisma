  role        AdminRole @default(OPERATIONS)
  status      String    @default("invited") // invited | active | removed
  inviteToken String?
  password    String?
  lastLogin   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

