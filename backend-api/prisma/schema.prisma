generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Vendor {
  id                     String       @id @default(cuid())
  name                   String
  email                  String       @unique
  password               String
  passwordChangedAt      DateTime? // S13: sessions issued before this are refused
  businessName           String
  phone                  String?
  industry               String?      @default("general")
  subdomain              String?      @unique
  widgetKey              String?      @unique // 3B: public per-vendor embeddable-widget key
  // WhatsApp-bot: the vendor's Fast2SMS phone_number_id, used to route an inbound
  // webhook to the correct tenant. Set by admin when provisioning the WA number.
  waPhoneNumberId        String?      @unique
  customDomain           String?
  // Per-vendor ResellerClub identity, created lazily on first domain registration
  // from the vendor's own business details. Domains register under these instead
  // of the shared default customer/contact once present.
  resellerClubCustomerId String?
  resellerClubContactId  String?
  role                   Role         @default(VENDOR)
  status                 VendorStatus @default(ACTIVE)
  // 3C: admin per-vendor override layered on the industry skin baseline (accent,
  // welcome text, website template). DB-driven, applied live, no redeploy.
  configOverride         Json?
  // Book-Demo Phase 4: a per-lead demo account, auto-expiring. Converts to a real
  // account at Phase 5 (buy-now). Filtered out of admin/real views.
  isSandbox              Boolean      @default(false)
  expiresAt              DateTime?
  // V3 slice 5.1: where the account came from (provenance only; nullable, no behaviour depends on it)
  source                 String?
  registeredByStaffId    String?
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt

  subscriptions Subscription[]
  v3Subscriptions V3PlanSubscription[]
  v3SubscriptionEvents V3SubscriptionEvent[]
  v3EntitlementOverrides V3EntitlementOverride[]
  v3Flags V3VendorFlag[]
  v3ClaimTokens V3ClaimToken[]
  v3Invites V3Invite[]
  v3ProvisioningJobs V3ProvisioningJob[]
  v3SiteSettings V3SiteSettings?
  v3SitePublications V3SitePublication[]
  v3SitePublicationPages V3SitePublicationPage[]
  v3SiteEvents V3SiteEvent[]
  v3Domains V3Domain[]
  v3DomainVerifications V3DomainVerification[]
  v3Redirects V3Redirect[]
  v3SiteRemoval V3SiteRemoval?
  v3BusinessProofs V3BusinessProof[]
  v3DeletionRequests V3AccountDeletionRequest[]
  v3SeededSite V3SeededSite?
  v3TermsAcceptances V3TermsAcceptance[]
  v3Requests V3Request[]
  v3Wallet V3Wallet?
  v3WalletTopups V3WalletTopup[]
  v3WalletReceipts V3WalletReceipt[]
  v3PackPurchases V3PackPurchase[]
  v3ServiceRequests V3ServiceRequest[]
  v3ThemeSwitches V3ThemeSwitch[]
  v3PaymentMethods V3VendorPaymentMethod[]
  v3Orders V3Order[]
  v3PaymentRequests V3PaymentRequest[]
  v3Payments V3Payment[]
  v3TaxProfile V3VendorTaxProfile?
  v3InvoiceSeries V3InvoiceSeries[]
  v3Documents V3VendorDocument[]
  v3Invoices V3VendorInvoice[]
  v3Offers V3Offer[]
  v3Counters V3VendorCounter[]
  v3SiteDrafts V3SiteDraft?
  v3SiteSnapshots V3SiteSnapshot[]
  v3SitePictures V3SitePicture[]
  v3StockLevels V3StockLevel[]
  v3DirectoryBusiness V3DirectoryBusiness?
  v3AccountSetupGrants V3AccountSetupGrant[]
  v3PlanOrders V3PlanOrder[]
  v3PlanInvoices V3PlanInvoice[]
  v3AiUsage V3AiUsage[]
  v3AiCreditGrants V3AiCreditGrant[]
  invoices      Invoice[]
  tickets       SupportTicket[]
  cms           VendorCMS?
  products      VendorProduct[]
  categories    Category[]

  wallet        Wallet?
  walletTxns    WalletTransaction[]
  campaignPages CampaignPage[]
  campaignLeads CampaignLead[]
  teamMembers   TeamMember[]

  contacts        Contact[]
  catalogItems    CatalogItem[]
  records         Record[]
  genericInvoices GenericInvoice[]
  addons          VendorAddon[]
  modules         VendorModule[]
  messages        Message[]
  expenses        Expense[]
  stationery      StationeryItem[]
  kbEntries       KnowledgeBaseEntry[]
  waConversations WhatsappConversation[]
  commsSettings   VendorCommsSettings?

  // Vendor-app Phase 4 — operations models (dedicated, vendorId-scoped).
  vendorTasks    VendorTask[]
  posTables      PosTable[]
  kitchenTickets KitchenTicket[]
  posSales       PosSale[]
  appointments   Appointment[]
  paymentRecords PaymentRecord[]
  gstFilings     GstFiling[]
  domains        DomainRegistration[]

  // Travel Operations (Phase 1)
  vehicles         Vehicle[]
  drivers          Driver[]
  trips            Trip[]
  visaApplications VisaApplication[]
  contracts        Contract[]

  // Phase 2 — per-industry operations
  stylists            Stylist[]
  salonChairs         SalonChair[]
  salonAppointments   SalonAppointment[]
  gymClasses          GymClass[]
  memberships         Membership[]
  rooms               Room[]
  roomBookings        RoomBooking[]
  listings            Listing[]
  deals               Deal[]
  propertyVisits      PropertyVisit[]
  batches             Batch[]
  enrollments         StudentEnrollment[]
  engagements         Engagement[]
  engagementDocuments EngagementDocument[]

  // Phase 3 — per-industry operations
  constructionProjects ConstructionProject[]
  projectMilestones    ProjectMilestone[]
  projectMaterials     ProjectMaterial[]
  eventBookings        EventBooking[]
  eventVendors         EventVendorAssignment[]
  financeCases         FinanceCase[]
  financeCaseDocuments FinanceCaseDocument[]
  serviceJobs          ServiceJob[]
  jobLines             JobLine[]
  partStock            PartStock[]
  shipments            Shipment[]
  testOrders           TestOrder[]
  testOrderItems       TestOrderItem[]
  photoShoots          PhotoShoot[]
  shootDeliverables    ShootDeliverable[]
  produceOrders        ProduceOrder[]
  produceStock         ProduceStock[]
  coachingBatches      CoachingBatch[]
  coachingEnrollments  CoachingEnrollment[]
  coachingSessions     CoachingSession[]
  techProjects         TechProject[]
  projectTasks         ProjectTask[]
  doctors              Doctor[]
  clinicAppointments   ClinicAppointment[]
  restaurantOrders     RestaurantOrder[]
  restaurantOrderItems RestaurantOrderItem[]
  retailProducts       RetailProduct[]
  domainCampaignRecords DomainCampaignRecord[]

  // Commercial Engine v1
  billingTerms       BillingTerm[]
  specialArrangements SpecialArrangement[]
  billingDeals       BillingDeal[]
  planChangeRequests PlanChangeRequest[]
}

model Subscription {
  id        String    @id @default(cuid())
  vendorId  String
  vendor    Vendor    @relation(fields: [vendorId], references: [id])
  product   Product
  plan      Plan
  status    SubStatus @default(PENDING)
  startDate DateTime?
  endDate   DateTime?
  amount    Int
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  // Theme-change entitlement (dispatch 01-Oct-2026): Workspace = 2/year, BOS =
  // 4/year. themeChangesResetAt tracks the next reset (set to endDate at
  // creation/renewal); updateVendorCMS auto-resets the counter once that date
  // has passed rather than requiring a cron job.
  themeChangesUsed    Int       @default(0)
  themeChangesLimit   Int?
  themeChangesResetAt DateTime?

  invoices Invoice[]
}

model Invoice {
  id                String        @id @default(cuid())
  invoiceNumber     String        @unique
  vendorId          String
  vendor            Vendor        @relation(fields: [vendorId], references: [id])
  subscriptionId    String?
  subscription      Subscription? @relation(fields: [subscriptionId], references: [id])
  description       String
  amount            Int
  gstAmount         Int
  totalAmount       Int
  gstNumber         String?
  status            InvoiceStatus @default(PENDING)
  razorpayOrderId   String?
  razorpayPaymentId String?
  paidAt            DateTime?
  dueDate           DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  // ── COMMERCIAL ENGINE v1 (07-Oct-2026) — ADDITIVE ──────────────────────────────────────
  // All nullable/defaulted: legacy invoices (kind = null) keep their exact behaviour. amount /
  // gstAmount / totalAmount keep their meaning (taxable / GST / payable, paise); the fields
  // below describe how they were derived and how the invoice is paid. See docs/v2/COMMERCIAL_ENGINE.md.
  kind               InvoiceKind?
  dealId             String?
  deal               BillingDeal?    @relation(fields: [dealId], references: [id])
  termId             String? // BillingTerm this invoice activates / renews (soft ref)
  /// SHA-256 of the pay-link token. The token itself is never stored and never returned by any list API.
  payTokenHash       String?         @unique
  tokenExpiresAt     DateTime?
  allowedChannels    PayChannel[]    @default([])
  gstMode            GstMode         @default(EXCLUSIVE)
  listAmountPaise    Int? // subtotal before discount
  discountPaise      Int             @default(0)
  discountReason     String?
  adminDiscount      Boolean         @default(false) // an ad-hoc admin discount is baked in (blocks promo stacking)
  allowPromoStacking Boolean         @default(false)
  promoCodeId        String?
  allowPromoEntry    Boolean         @default(false)
  lineItems          Json? // [{ kind: PLAN|ADDON|CUSTOM|CREDIT, label, amountPaise, qty }]
  planKey            BillingPlanKey?
  billingCycle       BillingCycle?
  cycleMonths        Int?
  periodStart        DateTime?
  periodEnd          DateTime?
  paidPaise          Int             @default(0) // cumulative amount received (manual partials)
  overpaymentPaise   Int             @default(0)
  paidVia            PayChannel?
  sentAt             DateTime?
  voidedAt           DateTime?
  voidReason         String?
  effectsAppliedAt   DateTime? // idempotency marker for activation / renewal side effects
  /// Special arrangement (Release 1A): the GST this invoice WOULD have carried when it was issued with gstMode NONE, and the printed note. Null on every other invoice.
  gstForgonePaise    Int?
  gstNote            String?

  @@index([vendorId, status])
  @@index([kind, status])
}

model SupportTicket {
  id         String       @id @default(cuid())
  vendorId   String
  vendor     Vendor       @relation(fields: [vendorId], references: [id])
  category   String
  subject    String
  message    String
  status     TicketStatus @default(OPEN)
  adminReply String?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
}

model VendorCMS {
  id                String   @id @default(cuid())
  vendorId          String   @unique
  vendor            Vendor   @relation(fields: [vendorId], references: [id])
  businessName      String?
  tagline           String?
  about             String?
  logo              String?
  banner            String?
  favicon           String?
  themeId           String? // selected WebsiteTheme (2.3); null = industry default
  seoTitle          String?
  seoDesc           String?
  seoKeywords       String?
  phone             String?
  email             String?
  address           String?
  // Basic business hours shown on the site AND used to ground the WhatsApp bot's
  // answers (free text, e.g. "Mon–Sat 9am–8pm, Sun closed"). Additive/nullable.
  businessHours     String?
  whatsapp          String?
  facebook          String?
  instagram         String?
  linkedin          String?
  youtube           String?
  googleMaps        String?
  googleAnalyticsId String?
  // Lightweight categorized photo gallery (e.g. Ceremony/Portraits/Details/
  // Celebration for a photography vendor) - deliberately reuses VendorCMS rather
  // than a parallel product/model: [{id,src,alt,title,category,order}]. Additive/
  // nullable; a vendor's public site falls back to its own static showcase images
  // until this is populated via the dashboard.
  portfolio         Json?
  // Website Manager (14-Oct-2026). The columns above are the PUBLISHED site (what the public renderer, the readiness check and the WhatsApp bot read).
  // The columns below hold the pending draft, the design choices and the publish history pointer. All nullable/defaulted: additive only.
  /// edits not yet published: a partial of the editable fields; null when there is nothing pending
  draft             Json?
  /// published design choices: { themeKey, hero, about, services, gallery, testimonials, contact }
  layout            Json?
  ogImage           String?
  /// vendor-written testimonials: [{ quote, author, note? }]
  testimonials      Json?
  /// extra pages: [{ slug, title, body }]; the count is limited by plan
  pages             Json?
  /// the category pack this site was generated from (g4d_category_packs.key)
  packKey           String?
  publishedAt       DateTime?
  siteVersion       Int      @default(0)
  /// Industry designs (15-Oct-2026): headline, sub-line, button label, announcement, trust points, questions, steps, statistics, team, before/after and the `sample` markers
  extras            Json?
  /// the design (one of the four of the category) the site uses
  designKey         String?
  /// LIVE (default, every existing site), DRAFT or UNCLAIMED: the last two are hidden from the public until published or claimed
  siteStatus        String   @default("LIVE")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

/// Last published versions of a vendor's site (the published fields as they were), for restore. Pruned to the newest 10 per vendor.
model SiteVersion {
  id        String   @id @default(cuid())
  vendorId  String
  version   Int
  snapshot  Json
  note      String?
  createdBy String?
  createdAt DateTime @default(now())

  @@unique([vendorId, version])
  @@index([vendorId, createdAt])
  @@map("g4d_site_versions")
}

/// Every image the shared upload service stored: the web-sized file, the untouched original, and the size, so a plan's media limit can be checked.
model MediaAsset {
  id            String   @id @default(cuid())
  vendorId      String
  /// LOGO | BANNER | GALLERY | PRODUCT | ABOUT | FAVICON | OG | OTHER
  kind          String
  url           String
  originalUrl   String?
  mime          String
  bytes         Int
  originalBytes Int
  width         Int?
  height        Int?
  createdAt     DateTime @default(now())

  @@index([vendorId, createdAt])
  @@map("g4d_media_assets")
}

/// A category pack: how a website for one kind of business is generated (sections, goal flow, default text, theme, layout, SEO type, AI prompts). Data, not code.
model CategoryPack {
  id        String   @id @default(cuid())
  key       String   @unique
  name      String
  enabled   Boolean  @default(true)
  /// the whole pack: keywords, goal, sections, itemSchema, defaults, theme, layouts, seoType, aiPrompts
  config    Json
  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("g4d_category_packs")
}

/// Round 2 (16-Oct-2026): an imported theme package. Plain HTML and CSS with data slots, made safe at import (see src/themes/core). One row per theme version; the pages
/// and the scoped stylesheet are stored as text, the pictures and fonts in g4d_theme_assets. Prices are set by an admin only, never in code.
model ThemePackage {
  id               String   @id @default(cuid())
  /// the manifest id (a vendor's design is "t:<key>"); several versions share a key
  key              String
  version          Int
  name             String
  manifest         Json
  /// { home: "<html>", about: "<html>", ... } already sanitised
  pages            Json
  /// the stylesheet, scoped to .g4d-theme-<key>
  css              String
  /// [{ path, mime, bytes }] of the files in g4d_theme_assets
  assetIndex       Json
  googleFonts      Json?
  families         Json
  /// the categories this theme may be used for (an admin can narrow what the manifest declared)
  categories       Json
  /// FREE_DEFAULT (a free design of its categories) or MARKETPLACE (sold per year)
  role             String   @default("MARKETPLACE")
  /// for FREE_DEFAULT: which built-in design slot (classic, bold, minimal, warm) it replaces
  replacesDesign   String?
  /// yearly price in paise, ex-GST; set by an admin only
  priceYearlyPaise Int?
  /// DRAFT, LIVE or RETIRED
  status           String   @default("DRAFT")
  previewPath      String?
  lint             Json?
  createdBy        String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  assets           ThemeAsset[]

  @@unique([key, version])
  @@index([status])
  @@map("g4d_theme_packages")
}

model ThemeAsset {
  id        String       @id @default(cuid())
  packageId String
  pkg       ThemePackage @relation(fields: [packageId], references: [id], onDelete: Cascade)
  path      String
  mime      String
  bytes     Int
  data      Bytes
  createdAt DateTime     @default(now())

  @@unique([packageId, path])
  @@map("g4d_theme_assets")
}

/// A vendor's right to use a marketplace theme for a year. Vendor-scoped. ACTIVE until endsAt, then EXPIRED (the site falls back to the free default design).
model ThemeEntitlement {
  id            String   @id @default(cuid())
  vendorId      String
  themeKey      String
  startsAt      DateTime
  endsAt        DateTime
  /// ACTIVE, EXPIRED or CANCELLED
  status        String   @default("ACTIVE")
  /// the Razorpay payment id; unique, so the same payment can never grant twice
  paymentRef    String?  @unique
  invoiceRef    String?
  amountPaise   Int      @default(0)
  gstPaise      Int      @default(0)
  /// { "30": iso, "7": iso, "1": iso } reminders already sent
  remindersSent Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([vendorId, themeKey])
  @@index([status, endsAt])
  @@map("g4d_theme_entitlements")
}

model VendorProduct {
  id           String    @id @default(cuid())
  vendorId     String
  vendor       Vendor    @relation(fields: [vendorId], references: [id])
  name         String
  description  String?
  price        String?
  image        String?
  // `category` (free text) stays as the denormalized display name, kept in sync by
  // CmsService.findOrCreateCategory — every existing reader of this string column
  // (the public /cms/site/:subdomain response, every vendor site's own product
  // rendering) keeps working unchanged. `categoryId` is the real relational link,
  // added dispatch 24-Sep-2026 to fix a real gap: a same-named category typed twice
  // used to create two disconnected free-text values with nothing tying them
  // together. Nullable so pre-existing rows without a resolvable category don't break.
  category     String?
  categoryId   String?
  categoryRef  Category? @relation(fields: [categoryId], references: [id])
  // Rich per-category listing fields (area/config/type for real estate, course/diet
  // for restaurant, duration/department for healthcare, …). Shape driven by
  // listing-fields.ts on the frontend. Additive/nullable — no data migration needed.
  customFields Json?
  active       Boolean   @default(true)

  // ── UNIVERSAL CATALOGUE (dispatch 03-Oct-2026) — ADDITIVE ONLY ──────────────────────
  // VendorProduct is evolving into the single catalogue table for every industry
  // (CatalogItem + RetailProduct are folded in by scripts/catalogue-migration/, both old
  // tables stay untouched). Every column below is nullable or defaulted, so every existing
  // reader/writer keeps working unchanged. See docs/v2/UNIVERSAL_CATALOGUE_MODEL.md.
  /// Discriminator = Vendor.industry at write time (engine id: retail, clinic, realestate…).
  /// Industry-specific attributes (sizes/colors, specialization, sqft/bedrooms, duration/
  /// inclusions…) stay in `customFields`; this says which shape that JSON follows.
  industryType String?
  /// Typed numeric price. `price` (String) stays as the DISPLAY value ("On Request", "from ₹500").
  priceAmount  Float?
  /// Selling unit: kg, session, night, month…
  unit         String?
  /// Promoted from RetailProduct — applies to any physical or inventory-tracked item.
  sku          String?
  /// null = stock not tracked (CatalogItem.stock semantics); a number = tracked.
  stockQty     Int?
  /// Handover 2026-10-08: true = stockQty is authoritative (orders reserve it, adjustments move it). false = stock not tracked.
  trackStock   Boolean   @default(false)
  reorderLevel Int?
  /// BOS item master (additive): HSN/SAC code, GST rate % (null = vendor default), purchase price in rupees (drives cost of goods sold).
  hsn          String?
  gstRate      Float?
  purchasePriceAmount Float?
  /// active | inactive | draft | archived | out_of_stock. `active` (Boolean) remains what
  /// live readers filter on until the separate cutover dispatch; migrated rows carry
  /// active=false + their real state here, so copying never surfaces anything new.
  status       String    @default("active")
  /// Primary Operation Registry action for THIS item (appointment, booking, cart, enquiry…).
  /// null = inherit IndustryExperience.primaryOperation for the vendor's industry.
  operationKey String?
  operation    OperationType? @relation(fields: [operationKey], references: [key], onDelete: SetNull)
  /// Provenance of rows copied in by the data migration: 'catalog_item' | 'retail_product'.
  /// (id is preserved from the source row, so Record.catalogItemId / PosSale lines stay valid.)
  sourceModel  String?
  sourceId     String?

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([categoryId])
  @@index([vendorId, status])
  @@index([vendorId, industryType])
  @@index([vendorId, sku])
  @@unique([sourceModel, sourceId])
  stockMovements StockMovement[]
}

/// A vendor's own product category — dispatch 24-Sep-2026, fixes a real gap:
/// VendorProduct.category was (and remains, for backward compat) a bare free-text
/// column with no dedicated taxonomy, so a vendor dashboard entering a same-named
/// category twice silently created two disconnected values. Scoped per-vendor (not
/// global) since different vendors' "Sneakers" are unrelated categories; uniqueness is
/// case-insensitive via `nameNormalized` (Postgres @unique is case-sensitive) so
/// "Sneakers" and "sneakers" resolve to the SAME row — see CmsService.
/// findOrCreateCategory, the single place a category name ever gets created.
model Category {
  id             String          @id @default(cuid())
  vendorId       String
  vendor         Vendor          @relation(fields: [vendorId], references: [id])
  industry       String
  name           String
  nameNormalized String
  /// Handover 2026-10-08: dashboard ordering and visibility of the storefront filter list.
  sortOrder      Int             @default(0)
  hidden         Boolean         @default(false)
  products       VendorProduct[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@unique([vendorId, nameNormalized])
  @@index([vendorId])
  @@map("g4d_categories")
}

model PlatformCMS {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

model Lead {
  id             String        @id @default(cuid())
  name           String
  phone          String
  email          String?
  business       String
  industry       String
  interest       String
  message        String?
  status         String        @default("pending")
  // Lead origin: "demo" = Book-Demo funnel (Phase 1 OTP-verified), else campaign/etc.
  source         String?
  // Preferred demo slot chosen by the visitor in the Book-a-Demo wizard.
  preferredDate  DateTime?
  preferredSlot  String?
  // TeleCRM fields (admin marketing team works these enquiries).
  notes          String?
  assignedTo     String?
  followUpDate   DateTime?
  callLogs       LeadCallLog[]
  // Demo-visit tracking (additive, on the same OTP-gate lead — dispatch 28-Aug-2026).
  // demoCategory = the FIRST main category this phone viewed; the visitor is scoped
  // to it (sub-categories within it are free). demoVisitKeys = comma-separated distinct
  // "category" / "category/sub" keys already viewed; demoVisitCount = their count. After
  // 3 distinct visits the 4th is redirected to a warm-lead sales page, not another demo.
  demoCategory   String?
  demoVisitKeys  String?
  demoVisitCount Int           @default(0)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@map("g4d_leads")
}

// Call activity logged against a demo-booking Lead by the admin marketing team.
// Mirrors CallLog (which is bound to vendor CampaignLead) but for platform leads.
model LeadCallLog {
  id         String    @id @default(cuid())
  leadId     String
  lead       Lead      @relation(fields: [leadId], references: [id])
  calledBy   String?
  duration   Int?
  outcome    String?
  notes      String?
  aiSummary  String?
  followUpAt DateTime?
  createdAt  DateTime  @default(now())

  @@map("g4d_lead_call_logs")
}

model Wallet {
  id            String              @id @default(cuid())
  vendorId      String              @unique
  vendor        Vendor              @relation(fields: [vendorId], references: [id])
  balance       Int                 @default(0)
  totalCredited Int                 @default(0)
  totalDebited  Int                 @default(0)
  updatedAt     DateTime            @updatedAt
  transactions  WalletTransaction[]

  @@map("g4d_wallets")
}

model WalletTransaction {
  id           String    @id @default(cuid())
  vendorId     String
  vendor       Vendor    @relation(fields: [vendorId], references: [id])
  walletId     String
  wallet       Wallet    @relation(fields: [walletId], references: [id])
  type         String
  amount       Int
  description  String
  service      String
  balanceAfter Int
  expiresAt    DateTime?
  razorpayId   String?   @unique
  /// V3 Step 0 (S12): an optional caller-supplied key. A second debit/refund with the same key is a replay and returns the first result;
  /// the same key with a different amount, vendor or service is refused (409). NULL for rows that do not use one.
  idempotencyKey String? @unique
  createdAt    DateTime  @default(now())

  @@map("g4d_wallet_transactions")
}

model CampaignPage {
  id           String         @id @default(cuid())
  vendorId     String
  vendor       Vendor         @relation(fields: [vendorId], references: [id])
  slug         String         @unique
  title        String
  headline     String
  subheadline  String?
  benefits     Json
  aboutText    String?
  heroImage    String?
  photos       Json?
  style        String         @default("LIGHT")
  phone        String
  whatsapp     String
  email        String?
  address      String?
  mapsLink     String?
  testimonials Json?
  ctaText      String         @default("Enquire Now")
  active       Boolean        @default(true)
