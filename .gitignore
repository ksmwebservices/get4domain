# Local credential files — never commit
.env.prod-readonly
.env.staging
.env.*.local

# Production export (names/timestamps) — never commit
prod-migrations*.csv*

# V3 live environment file: created on the server, never committed (job L)
.env.live
backend-api/.env.live

# the staging schema dump used to baseline the live database (job M): never committed
backend-api/live-baseline/

# filled deploy env files of the v3live container (E1b): never committed; only the *.example templates are
deploy/v3live/env/*.env
