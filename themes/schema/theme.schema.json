{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://get4domain.com/schemas/theme.schema.json",
  "title": "Get4Domain theme manifest (theme.json), contract version 1",
  "description": "Fields marked \"package only\" are filled by `pack` and required in a packaged zip. Validated by themes/lib/schema.mjs (a small subset validator, no dependencies).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "version",
    "name",
    "tier",
    "tracks",
    "families",
    "categories",
    "layoutVariantRules",
    "motion",
    "settingsSchema",
    "fonts"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "minLength": 3,
      "maxLength": 40
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "name": {
      "type": "string",
      "minLength": 2,
      "maxLength": 80
    },
    "tier": {
      "type": "string",
      "enum": [
        "Standard",
        "Premium"
      ]
    },
    "tracks": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "handyman",
          "professional",
          "ecommerce"
        ]
      }
    },
    "families": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "home-services",
          "auto-services",
          "healthcare",
          "legal-finance",
          "education",
          "wellness-beauty",
          "creative-consulting",
          "hospitality-property",
          "fashion-lifestyle",
          "food-grocery",
          "electronics-home",
          "gifts-books"
        ]
      }
    },
    "categories": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "plumber",
          "electrician",
          "carpenter",
          "painter",
          "ac-appliance-repair",
          "pest-control",
          "home-cleaning",
          "locksmith",
          "packers-movers",
          "mason-contractor",
          "cctv-security-installer",
          "auto-mechanic",
          "car-wash-detailing",
          "doctor-clinic",
          "dentist",
          "physiotherapy",
          "diagnostics-lab",
          "lawyer",
          "ca-tax-consultant",
          "insurance-advisor",
          "coaching-centre",
          "tutor",
          "music-dance-school",
          "salon-spa",
          "gym-yoga",
          "photographer",
          "interior-designer-architect",
          "event-planner",
          "it-consultant",
          "restaurant-cafe",
          "hotel-homestay",
          "travel-agency",
          "real-estate-agent",
          "fashion-apparel",
          "jewellery",
          "grocery-kirana",
          "bakery-sweets",
          "electronics-mobile",
          "home-furniture",
          "gifts-handicrafts",
          "books-stationery"
        ]
      }
    },
    "layoutVariantRules": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 3,
        "maxLength": 40
      }
    },
    "motion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "default"
      ],
      "properties": {
        "default": {
          "type": "string",
          "enum": [
            "Off",
            "Low",
            "Medium",
            "Rich"
          ]
        },
        "variantDefaults": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "enum": [
              "Off",
              "Low",
              "Medium",
              "Rich"
            ]
          }
        }
      }
    },
    "settingsSchema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "accent": {
          "type": "boolean"
        },
        "fonts": {
          "type": "boolean"
        },
        "logo": {
          "type": "boolean"
        },
        "sectionOrder": {
          "type": "boolean"
        },
        "sectionVisibility": {
          "type": "boolean"
        },
        "motionIntensity": {
          "type": "boolean"
        }
      }
    },
    "fonts": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 12,
      "items": {
        "type": "string",
        "enum": [
          "Inter",
          "Poppins",
          "DM Sans",
          "Manrope",
          "Nunito",
          "Work Sans",
          "Montserrat",
          "Playfair Display",
          "Lora",
          "Merriweather",
          "Noto Sans Tamil",
          "Noto Serif Tamil"
        ]
      }
    },
    "assets": {
      "type": "array",
      "description": "package only: every file under assets/",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "bytes",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^assets/"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "contentHash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "package only"
    },
    "internal": {
      "type": "boolean",
      "description": "true only for the kit's own _starter theme; never offered to vendors"
    },
    "marketplace": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "packs"
      ],
      "description": "Marketplace metadata: who the theme is for and how it is found. The shape is checked here, the names by the backend.",
      "properties": {
        "packs": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 16,
          "items": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]{1,40}$"
          },
          "minItems": 1,
          "description": "industry pack keys the theme is designed for"
        },
        "addons": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 8,
          "items": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]{1,40}$"
          },
          "description": "add-on pack keys the theme also draws (SHOP, ONLINE_ORDERING_DELIVERY, PHARMACY_COUNTER, HOME_SAMPLE_COLLECTION)"
        },
        "capabilities": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 14,
          "items": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]{1,40}$"
          },
          "description": "capability keys the theme draws"
        },
        "tags": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 12,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
            "maxLength": 60
          },
          "description": "combination tags, for example service-plus-shop"
        },
        "catalogueCategories": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 200,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
            "maxLength": 80
          },
          "description": "ids from the 196-category catalogue (the kit category ids stay in `categories`)"
        },
        "previews": {
          "type": "array",
          "maxItems": 6,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "alt"
            ],
            "properties": {
              "path": {
                "type": "string",
                "pattern": "^assets/previews/[a-z0-9-]+\\.(png|jpg|jpeg|webp)$"
              },
              "alt": {
                "type": "string",
                "minLength": 3,
                "maxLength": 160
              },
              "page": {
                "type": "string",
                "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
                "maxLength": 30
              }
            }
          }
        },
        "licence": {
          "type": "string",
          "minLength": 3,
          "maxLength": 300,
          "description": "a plain note on who may use the theme; not legal wording"
        },
        "starter": {
          "type": "boolean",
          "description": "true for a starter theme built by the Get4Domain team (said honestly in the listing)"
        },
        "sourceVendorId": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 40,
          "description": "the vendor a custom theme was first built for; null for a theme built for the marketplace. The upload route sets the real value; a different non-null value is refused."
        }
      }
    },
    "author": {
      "type": "string",
      "maxLength": 80
    },
    "description": {
      "type": "string",
      "maxLength": 400
    }
  }
}
