# BUILD-TIME values of the public Next site (Next inlines NEXT_PUBLIC_* when it builds). Public by nature: addresses and public keys only. NAMES ONLY here.
# Copy to /opt/v3live/env/site.build.env on the server. The runbook passes each name to `docker build --build-arg`.
# the API's public address (older pages)
NEXT_PUBLIC_API_URL=
# the API's public address (V3 pages, browser side)
NEXT_PUBLIC_API_BASE_URL=
# the base domain of the vendors' subdomain sites (bare host name)
NEXT_PUBLIC_SITE_BASE_DOMAIN=
# the public site's own address
NEXT_PUBLIC_SITE_URL=
# the vendor app's address (https://app.<domain>)
NEXT_PUBLIC_VENDOR_APP_URL=
# the Razorpay PUBLIC key id (leave empty until payments are enabled)
NEXT_PUBLIC_RAZORPAY_KEY_ID=
# the web push PUBLIC key (optional)
NEXT_PUBLIC_VAPID_KEY=
# Google Analytics id (optional)
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# public contact details shown on the older marketing pages
NEXT_PUBLIC_PHONE=
NEXT_PUBLIC_EMAIL=
NEXT_PUBLIC_WHATSAPP=
