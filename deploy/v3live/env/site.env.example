# RUN-TIME environment of the public Next site (g4d-v3-site). NAMES ONLY: copy to /opt/v3live/env/site.env on the server (mode 600), fill it there, never commit it.
NODE_ENV=production
PORT=3006
HOSTNAME=0.0.0.0

# the V3 public switch: OFF until the owner says so. The code's default for mocks is ON, so it is set to false on purpose.
V3_PUBLIC_ENABLED=false
V3_PUBLIC_USE_MOCKS=false

# where the API is, as the site container sees it (the API's container name on the Docker network, http, port 3008)
API_BASE_URL=
INTERNAL_API_URL=
# the same value as REVALIDATE_SECRET in api.env (the API asks this site to refresh a page)
REVALIDATE_SECRET=
# signs the demo pass cookie; the code has a built-in fallback, so set a real random value (at least 32 characters)
DEMO_ACCESS_SECRET=

# host names (names only, no scheme): one domain, single-level subdomains
MAIN_HOST=
DIRECTORY_HOST=
APP_HOST=
ADMIN_HOST=
API_HOST=
MEDIA_HOST=
# the canonical origin for sitemap and robots lines (https, no www)
V3_PUBLIC_SITE_ORIGIN=
# seconds a page model may be cached when the API says nothing (10 to 86400, optional)
# V3_PUBLIC_REVALIDATE_SECONDS=
# base domain of vendor sites (also set at build time; read here by the middleware)
NEXT_PUBLIC_SITE_BASE_DOMAIN=
NEXT_PUBLIC_VENDOR_APP_URL=

# firm contact details printed on the legal, About and Contact pages (empty means the page prints nothing for it)
V3_PUBLIC_SUPPORT_EMAIL=
V3_PUBLIC_SUPPORT_PHONE=
V3_PUBLIC_GRIEVANCE_OFFICER_NAME=
V3_PUBLIC_GRIEVANCE_OFFICER_EMAIL=
V3_PUBLIC_GRIEVANCE_OFFICER_PHONE=
V3_PUBLIC_FIRM_CIN=

# the base domain of LeadSpace campaign pages (optional; needs its own DNS and nginx)
# LEADSPACE_BASE_DOMAIN=
