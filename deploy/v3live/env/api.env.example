# The V3 LIVE API environment inside the v3live container. NAMES ONLY: copy to /opt/v3live/env/api.env on the server (mode 600), fill it there, never commit it.
# Every REQUIRED name is active and empty. The sending and money switches are written as false and stay false until the owner enables them, one at a time.
# Every other optional name, with a comment each, is in backend-api/.env.live.example: copy a line from there only when needed.
# The live API refuses to start (src/common/startup-check.ts) when a required name is empty or a placeholder, a secret is under 32 characters, or a database is staging, test, local or a private address.
# So DATABASE_URL and DIRECT_URL must name the Postgres container by its Docker name (never its IP), for example postgresql://g4d_live:<password>@<container name>:5432/get4domain_v3?sslmode=disable

# the live domain only, no scheme and no path
V3_DOMAIN=
NODE_ENV=production
V3_LIVE=true
PORT=3008
# shown by GET /health/ready (set by the deploy step)
APP_VERSION=
GIT_COMMIT=

# database: the same connection string twice (no pooler)
DATABASE_URL=
DIRECT_URL=

# secrets: each at least 32 random characters, all different (made on the server with openssl rand)
JWT_SECRET=
PLATFORM_SETTINGS_KEY=
REVALIDATE_SECRET=

# where things live: https addresses on V3_DOMAIN
SITE_BASE_DOMAIN=
FRONTEND_URL=
PUBLIC_APP_URL=
PUBLIC_API_URL=
# the directory's own host (https://directory.<domain>)
DIRECTORY_PUBLIC_BASE_URL=
# the public site as the API container sees it, for page refreshes (http://<site container name>:3006)
FRONTEND_INTERNAL_URL=
# the server's public IPv4 address (custom domains point at it)
SERVER_IP=

# the proxies that may say who the visitor is: the LXD bridge subnet (host nginx) and the Docker network subnet (the public site)
TRUSTED_PROXIES=
# only the platform and the listed origins may call the API from a browser
CORS_MODE=strict
# comma separated https origins of the app, admin and partner hosts and the main site
CORS_EXTRA_ORIGINS=

# storage: Cloudflare R2 keys (bucket names, endpoints and the public address are admin settings)
STORAGE_PUBLIC_ACCESS_KEY_ID=
STORAGE_PUBLIC_SECRET_ACCESS_KEY=
STORAGE_PRIVATE_ACCESS_KEY_ID=
STORAGE_PRIVATE_SECRET_ACCESS_KEY=

# OFF until the owner enables them (the code treats anything but exactly true as off)
EMAIL_LIVE_SEND=false
EMAIL_FORWARD_LIVE=false
SMS_LIVE_ENABLED=false
SMS_LIVE_SEND=false
MESSAGING_LIVE_ENABLED=false
WHATSAPP_PROVIDER=sandbox
PLAN_PAYMENTS_LIVE_ENABLED=false
VENDOR_GATEWAY_LIVE_ENABLED=false
VENDOR_GATEWAY_WEBHOOK_ENABLED=false
REGISTRAR_LIVE_SEARCH=false
REGISTRAR_LIVE_PURCHASE=false
