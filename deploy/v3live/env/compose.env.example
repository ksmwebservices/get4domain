# What docker compose substitutes into docker-compose.apps.yml. NAMES ONLY: copy to /opt/v3live/env/compose.env on the server (mode 600), fill it there, never commit it.
# the release tag shared by every image, for example <yyyymmdd>-<short commit>
IMAGE_TAG=
# the LXD container's own address (the one the host nginx connects to); every port is published on it and nowhere else
V3_BIND_IP=
# the Docker network of the Postgres project (default v3net)
# V3_NETWORK=
# the folder that holds api.env and site.env on the server (default /opt/v3live/env)
# V3_ENV_DIR=
# the API's public address as a browser sees it: https://api.<domain> (written into the SPAs' runtime config and CSP when each container starts)
API_PUBLIC_URL=
# the media host's address if pictures come from a host other than the API (optional; empty means none)
STORAGE_BASE_URL=
